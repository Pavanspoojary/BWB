---
interface Props {
  class?: string;
  githubUrl?: string;
}

const {
  class: className = '',
  githubUrl = 'https://github.com/Pavanspoojary/builtwhilebroke/blob/master/CONTRIBUTING.md',
} = Astro.props;
---

<div
  id="sticky-pr-callout"
  class={`fixed bottom-4 inset-x-4 sm:inset-x-auto sm:right-6 sm:bottom-6 z-50 sm:max-w-md border-2 border-phosphor-green bg-panel-black shadow-brutal-green p-4 font-mono text-zinc-100 transition-all duration-200 ${className}`}
  role="complementary"
  aria-label="Community Contribution Callout"
>
  <div class="flex items-start justify-between gap-3 mb-2">
    <div class="flex items-center gap-2 text-xs text-phosphor-green font-bold">
      <span class="w-2 h-2 bg-phosphor-green animate-pulse inline-block"></span>
      <span>[COMMUNITY PROTOCOL]</span>
    </div>
    <button
      type="button"
      id="dismiss-pr-callout"
      class="text-xs text-zinc-400 hover:text-white px-1.5 py-0.5 border border-zinc-700 hover:border-zinc-400 bg-black cursor-pointer select-none"
      aria-label="Dismiss callout"
    >
      [x]
    </button>
  </div>

  <p class="text-xs text-zinc-300 leading-snug mb-3">
    <strong class="text-white">&gt; DISCOVERED A SICK ZERO-DOLLAR HACK?</strong>
    Don't let SaaS landlords extract your runway. Share your abused primitives with the world.
  </p>

  <div class="flex items-center justify-between gap-2">
    <a
      href={githubUrl}
      target="_blank"
      rel="noreferrer"
      class="inline-flex items-center gap-2 px-3 py-1.5 text-xs font-black tracking-wider text-black bg-phosphor-green hover:bg-emerald-400 transition-colors uppercase select-none active:translate-y-0.5 shadow-brutal-dark"
    >
      <span>Submit a Hack via PR</span>
      <span>&rarr;</span>
    </a>
    <span class="text-[10px] text-zinc-500 font-bold uppercase tracking-wider hidden sm:inline-block">
      MIT / UNLICENSE
    </span>
  </div>
</div>

<script>
  function setupPrDismiss() {
    const callout = document.getElementById('sticky-pr-callout');
    const dismissBtn = document.getElementById('dismiss-pr-callout');
    if (!callout || !dismissBtn) return;

    dismissBtn.addEventListener('click', () => {
      callout.style.opacity = '0';
      callout.style.transform = 'translateY(16px)';
      setTimeout(() => {
        callout.remove();
      }, 200);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPrDismiss);
  } else {
    setupPrDismiss();
  }
</script>
