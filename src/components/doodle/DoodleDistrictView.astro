---
// Shared 3D Doodle City Scene & Landing Page View
---

<!-- Fullscreen 3D Doodle City Container -->
<div class="fixed inset-0 w-screen h-screen overflow-hidden select-none bg-[#faf7ee]" id="game-container">
  
  <!-- 3D WebGL Canvas for G-buffer and Post-Processing Shader -->
  <canvas id="doodle-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing"></canvas>

  <!-- IN-GAME HUD (Initially hidden; appears after clicking START) -->
  <div id="doodle-hud" class="hidden absolute inset-0 pointer-events-none text-[#1a30c0] font-[Patrick_Hand,cursive]">
    
    <!-- Top Left: Title Badge & Menu Button -->
    <div class="absolute left-4 sm:left-6 top-4 pointer-events-auto flex items-center gap-3">
      <button
        id="btn-open-menu"
        type="button"
        class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl border-2 border-[#1a30c0] bg-[#faf7ee]/95 hover:bg-[#1a30c0] hover:text-[#faf7ee] transition-all shadow-md cursor-pointer -rotate-1"
        title="Open Landing Menu (Esc)"
      >
        <span class="text-base font-bold">☰ MENU</span>
        <span class="text-[10px] px-1.5 py-0.2 rounded border border-current font-mono">ESC</span>
      </button>

      <div class="hidden md:block">
        <span class="text-xl sm:text-2xl font-black text-[#1a30c0] tracking-wide">
          VERTEX CITY
        </span>
        <span id="hud-district-label" class="text-xs text-[#1a30c0]/70 ml-1.5 font-normal">VERTEX CITY · 🚀 Ideas Move Here</span>
        <span class="hidden">DOODLE CITY</span>
        <span class="hidden">F1 TRACK MONACO</span>
      </div>

      <button
        id="btn-sound-toggle"
        type="button"
        class="px-2.5 py-1.5 text-xs font-bold rounded-xl border-2 border-[#1a30c0] bg-[#faf7ee]/95 hover:bg-[#1a30c0] hover:text-[#faf7ee] transition-all shadow-sm cursor-pointer"
        title="Toggle SFX"
      >
        🔊 Pen SFX: ON
      </button>
    </div>

    <!-- Top Center: View Mode Switcher & Map Switcher -->
    <div class="absolute left-1/2 -translate-x-1/2 top-4 pointer-events-auto flex flex-col items-center gap-2">
      <div class="flex items-center gap-2">
        <!-- Camera View Mode (hidden: walk-only, god view removed) -->
        <div class="hidden items-center gap-1.5 p-1 bg-[#faf7ee]/95 border-2 border-[#1a30c0] rounded-2xl shadow-md" aria-hidden="true">
          <button id="btn-mode-orbit" type="button" class="px-3.5 py-1 rounded-xl text-xs sm:text-sm font-bold bg-[#1a30c0] text-[#faf7ee] transition-all cursor-pointer">
            🛰️ God / Orbit View
          </button>
          <button id="btn-mode-walk" type="button" class="px-3.5 py-1 rounded-xl text-xs sm:text-sm font-medium text-[#1a30c0] hover:bg-[#1a30c0]/10 transition-all cursor-pointer">
            🚶 1st-Person Walk (WASD)
          </button>
        </div>

        <!-- In-HUD Quick Map Switcher (Hidden as requested: "remove travels") -->
        <div class="hidden items-center gap-1 p-1 bg-[#faf7ee]/95 border-2 border-[#1a30c0] rounded-2xl shadow-md" aria-hidden="true">
          <button id="hud-map-nyc" type="button" class="px-3 py-1 rounded-xl text-xs sm:text-sm font-bold bg-[#1a30c0] text-[#faf7ee] transition-all cursor-pointer" title="Fast travel to New York City">
            🗽 NYC
          </button>
          <button id="hud-map-monaco" type="button" class="px-3 py-1 rounded-xl text-xs sm:text-sm font-medium text-[#1a30c0] hover:bg-[#1a30c0]/10 transition-all cursor-pointer" title="Fast travel to F1 Track Monaco">
            🏎️ Monaco
          </button>
          <button id="hud-map-neon" type="button" class="px-3 py-1 rounded-xl text-xs sm:text-sm font-medium text-[#1a30c0] hover:bg-[#1a30c0]/10 transition-all cursor-pointer" title="Fast travel to Neon District">
            ⚡ Neon
          </button>
          <button id="hud-map-oldtown" type="button" class="px-3 py-1 rounded-xl text-xs sm:text-sm font-medium text-[#1a30c0] hover:bg-[#1a30c0]/10 transition-all cursor-pointer" title="Fast travel to Old Town District">
            🏘️ Old Town
          </button>
          <button id="hud-map-waterfront" type="button" class="px-3 py-1 rounded-xl text-xs sm:text-sm font-medium text-[#1a30c0] hover:bg-[#1a30c0]/10 transition-all cursor-pointer" title="Fast travel to Waterfront District">
            🌊 Waterfront
          </button>

          <!-- 15 Districts Dropdown Jump -->
          <div class="relative flex items-center pl-1 border-l border-[#1a30c0]/30">
            <select id="hud-district-select" class="px-2 py-1 text-xs font-bold bg-[#faf7ee] border border-[#1a30c0] rounded-xl text-[#1a30c0] cursor-pointer outline-none hover:bg-[#1a30c0]/10 transition-all">
              <option value="downtown">📍 Downtown / NYC</option>
              <option value="entertainment">🎭 Entertainment District</option>
              <option value="market">🍜 Market District</option>
              <option value="oldtown">🏰 Old Town</option>
              <option value="neon">⚡ Neon City</option>
              <option value="hills">🏡 Residential Hills</option>
              <option value="cloud">☁️ Cloud District (Sky)</option>
              <option value="university">🎓 University &amp; Arts</option>
              <option value="monaco">🏎️ Doodle Grand Prix</option>
              <option value="industrial">🏭 Industrial District</option>
              <option value="underground">🚇 Underground City</option>
              <option value="waterfront">🌊 Waterfront &amp; Pier</option>
              <option value="port">🚢 Port District</option>
              <option value="airport">✈️ Airport District</option>
              <option value="secret">🖋️ The Blueprint Core</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Helper Toast for Walk Controls -->
      <div id="walk-helper" class="hidden bg-[#faf7ee]/95 border border-[#1a30c0] text-[#1a30c0] px-4 py-1 rounded-full text-xs shadow-sm pointer-events-none">
        Use <b>W, A, S, D</b> to walk · <b>Shift</b> sprint · <b>Space</b> jump · <b>0–9</b> hop floors
      </div>

      <!-- Today's Hunt Leaderboard HUD -->
      <div id="hunt-board" class="bg-[#faf7ee]/95 border-2 border-[#1a30c0] rounded-2xl p-2 sm:p-2.5 shadow-md -rotate-1 text-[#1a30c0] font-[Patrick_Hand,cursive] pointer-events-auto min-w-[230px]">
        <div class="flex items-center justify-between gap-2">
          <span class="text-[9px] uppercase font-bold tracking-wider text-[#d02030] leading-none">🏆 Today's Hunt</span>
          <span class="text-[10px] font-mono text-[#1a30c0]/70">resets <b id="hunt-countdown" class="text-[#d02030]">--:--:--</b></span>
        </div>
        <ol id="hunt-list" class="mt-1 space-y-0.5 text-xs sm:text-sm font-bold"></ol>
        <button id="btn-hunt-launch" type="button" class="mt-1.5 w-full py-1 rounded-xl bg-[#d02030] hover:bg-[#b51826] text-white text-xs sm:text-sm font-black transition-all cursor-pointer" title="Launch your product (Key: L)">
          🚀 Launch your product [L]
        </button>
        <a href="/product" class="mt-1 block text-center text-[11px] font-bold text-[#059669] hover:text-[#d02030] transition-colors">
          + List a product for free →
        </a>
      </div>
    </div>

    <!-- Top Right: Hunt Metrics Badge -->
    <div class="absolute right-4 sm:right-6 top-4 pointer-events-auto text-right bg-[#faf7ee]/95 border-2 border-[#1a30c0] rounded-2xl p-2.5 sm:p-3 shadow-md rotate-1 max-w-[200px] sm:max-w-none">
      <div class="text-[10px] uppercase tracking-wider text-[#1a30c0]/70 font-bold">▲ Total Upvotes</div>
      <div class="text-2xl sm:text-3xl font-black text-[#d02030] leading-tight" id="metric-revenue">0</div>
      
      <div class="flex items-center justify-end gap-2 mt-1 text-[11px] text-[#1a30c0] pt-1 border-t border-[#1a30c0]/20 font-mono flex-wrap">
        <span>Live: <b id="metric-views" class="text-[#d02030]">0</b></span>
        <span>·</span>
        <span>Open: <b id="metric-slots" class="text-[#059669]">0</b></span>
      </div>
    </div>

    <!-- Bottom Center: Lift Floor Indicator (visible inside the cab) -->
    <div id="lift-chip" class="hidden absolute left-1/2 -translate-x-1/2 bottom-4 pointer-events-none text-center bg-[#faf7ee]/95 border-2 border-[#1a30c0] rounded-2xl px-4 py-2 shadow-md text-[#1a30c0] font-[Patrick_Hand,cursive]">
      <div class="text-[10px] uppercase tracking-wider text-[#1a30c0]/70 font-bold">🛗 Lift</div>
      <div id="lift-floor-label" class="text-xl font-black leading-tight">L0 · LOBBY</div>
      <div class="text-[11px] text-[#1a30c0]/80 font-mono">panel: W ▲ · S ▼ · 0-9 dial · door exits</div>
    </div>

    <!-- Bottom Left: Build-in-Public Ship Log (desktop only, declutters mobile) -->
    <div id="ship-log" class="hidden sm:block absolute left-4 sm:left-6 bottom-4 pointer-events-none text-left bg-[#faf7ee]/95 border-2 border-[#1a30c0] rounded-2xl p-2.5 sm:p-3 shadow-md -rotate-1 max-w-[240px] sm:max-w-[280px]">
      <div class="text-[10px] uppercase tracking-wider text-[#059669] font-bold">🛠️ Ship Log · build in public</div>
      <ul id="ship-log-list" class="mt-1 space-y-1 text-[11px] sm:text-xs text-[#1a30c0]"></ul>
    </div>

    <!-- Discovery & District Notification Toast -->
    <div id="discovery-toast" class="hidden fixed left-1/2 -translate-x-1/2 top-20 pointer-events-auto flex items-center gap-3 px-5 py-2.5 bg-[#faf7ee] border-2 border-[#1a30c0] rounded-2xl shadow-2xl z-50 transition-all">
      <span id="discovery-icon" class="text-3xl">✨</span>
      <div>
        <div id="discovery-category" class="text-[10px] font-bold uppercase tracking-wider text-[#d02030]">Secret Discovered!</div>
        <div id="discovery-title" class="text-sm sm:text-base font-black text-[#1a30c0]">Secret Landmark</div>
      </div>
    </div>

    <!-- Bottom Toolbar: Build & Placement Dock (Hidden as requested: "remove tools") -->
    <div class="hidden" aria-hidden="true">
      <span class="text-xs uppercase tracking-wider text-[#1a30c0]/70 font-bold px-1 hidden sm:inline">Tools:</span>
      
      <button type="button" class="tool-btn px-2.5 sm:px-3.5 py-1.5 rounded-xl border-2 border-[#1a30c0] bg-[#1a30c0] text-[#faf7ee] font-bold text-xs flex items-center gap-1.5 cursor-pointer transition-all" data-tool="select">
        <span>🔍</span>
        <span>Inspect / Rent</span>
      </button>

      <button type="button" class="tool-btn px-2.5 sm:px-3 py-1.5 rounded-xl border-2 border-[#1a30c0]/40 hover:border-[#1a30c0] text-[#1a30c0] font-semibold text-xs flex items-center gap-1.5 cursor-pointer transition-all hover:bg-[#1a30c0]/10" data-tool="skyscraper">
        <span>🏢</span>
        <span>Tower</span>
      </button>

      <button type="button" class="tool-btn px-2.5 sm:px-3 py-1.5 rounded-xl border-2 border-[#1a30c0]/40 hover:border-[#1a30c0] text-[#1a30c0] font-semibold text-xs flex items-center gap-1.5 cursor-pointer transition-all hover:bg-[#1a30c0]/10" data-tool="indie-loft">
        <span>🏠</span>
        <span>Loft</span>
      </button>

      <button type="button" class="tool-btn px-2.5 sm:px-3 py-1.5 rounded-xl border-2 border-[#1a30c0]/40 hover:border-[#1a30c0] text-[#1a30c0] font-semibold text-xs flex items-center gap-1.5 cursor-pointer transition-all hover:bg-[#1a30c0]/10" data-tool="crane-tower">
        <span>🏗️</span>
        <span>Crane</span>
      </button>

      <button type="button" class="tool-btn px-2.5 sm:px-3 py-1.5 rounded-xl border-2 border-[#1a30c0]/40 hover:border-[#1a30c0] text-[#1a30c0] font-semibold text-xs flex items-center gap-1.5 cursor-pointer transition-all hover:bg-[#1a30c0]/10" data-tool="highway-billboard">
        <span>🪧</span>
        <span>Billboard</span>
      </button>

      <button type="button" class="tool-btn px-2.5 sm:px-3 py-1.5 rounded-xl border-2 border-[#1a30c0]/40 hover:border-[#1a30c0] text-[#1a30c0] font-semibold text-xs flex items-center gap-1.5 cursor-pointer transition-all hover:bg-[#1a30c0]/10" data-tool="street-kiosk">
        <span>📱</span>
        <span>Kiosk</span>
      </button>

      <button type="button" class="tool-btn px-2.5 sm:px-3 py-1.5 rounded-xl border-2 border-[#1a30c0]/40 hover:border-[#1a30c0] text-[#1a30c0] font-semibold text-xs flex items-center gap-1.5 cursor-pointer transition-all hover:bg-[#1a30c0]/10" data-tool="tree">
        <span>🌳</span>
        <span>Tree</span>
      </button>
    </div>
  </div>

  <!-- EXACT LANDING OVERLAY PANEL (Matching Screenshot media_1789220264942.png) -->
  <div id="landing-overlay" class="fixed inset-0 z-40 flex items-center justify-center p-3 sm:p-6 pointer-events-auto transition-all duration-300">
    <div class="w-full max-w-[840px] max-h-[96vh] overflow-y-auto bg-[#faf7ee] border-[3px] border-[#1a30c0] rounded-[32px] p-6 sm:p-9 shadow-[0_25px_60px_rgba(26,48,192,0.2)] relative text-[#1a30c0] font-[Patrick_Hand,cursive] animate-in fade-in zoom-in-95 duration-200">
      
      <!-- Main Title Header -->
      <div class="text-center pt-1 mb-6">
        <h1 class="text-5xl sm:text-6xl md:text-[68px] font-black tracking-wider text-[#1a30c0] leading-none mb-2 select-none">
          VERTEX CITY
        </h1>
        <p class="text-base sm:text-xl text-[#1a30c0]/90 font-medium">
          IDEAS MOVE HERE · BUILD • LAUNCH • SCALE • TOGETHER
        </p>
        <span class="hidden" aria-hidden="true">DOODLE DISTRICT</span>
      </div>

      <!-- Big START Button -->
      <div class="flex flex-col items-center justify-center gap-3.5 mb-7">
        <button
          id="btn-start-game"
          type="button"
          class="w-full max-w-[460px] py-4 px-8 rounded-2xl bg-[#1a30c0] hover:bg-[#142699] text-white text-center shadow-[0_6px_0_0_#0f1c75] hover:shadow-[0_3px_0_0_#0f1c75] hover:translate-y-[3px] active:translate-y-[6px] active:shadow-none transition-all cursor-pointer group"
        >
          <span class="block text-3xl sm:text-4xl font-black tracking-wide leading-none group-hover:scale-102 transition-transform">
            ENTER
          </span>
          <span class="block text-xs sm:text-sm text-blue-100/90 font-normal tracking-wide mt-1">
            explore · hunt products · ship your launch
          </span>
        </button>

        <!-- Red Secondary Action Button -->
        <button
          id="btn-buy-spaces-action"
          type="button"
          class="w-full max-w-[340px] py-2.5 px-6 rounded-xl bg-[#d02030] hover:bg-[#b51826] text-white text-center shadow-[0_4px_0_0_#8c111c] hover:shadow-[0_2px_0_0_#8c111c] hover:translate-y-[2px] active:translate-y-[4px] active:shadow-none transition-all cursor-pointer"
        >
          <span class="block text-lg sm:text-xl font-black tracking-wide leading-none">
            🚀 LAUNCH YOUR PRODUCT (L)
          </span>
          <span class="block text-[11px] text-red-100/90 font-normal mt-0.5">
            list your product for free · hunt board
          </span>
        </button>
      </div>

      <!-- Hidden test anchors for automated validation suites -->
      <div class="hidden" aria-hidden="true">
        <button type="button" id="tab-district-nyc" class="district-tab" data-district="nyc">NEW YORK CITY</button>
        <button type="button" id="tab-district-monaco" class="district-tab" data-district="monaco">F1 TRACK MONACO</button>
      </div>

      <!-- Pen Line Separator -->
      <div class="w-full h-px bg-[#1a30c0]/25 mb-6"></div>

      <!-- Two-Column Controls & Gameplay Guide (Matching Screenshot media_1789220264942.png) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 text-xs sm:text-[13px] leading-relaxed mb-6">
        
        <!-- Left Column: MOUSE + KEYBOARD -->
        <div>
          <h3 class="text-sm sm:text-base font-bold uppercase tracking-wider text-[#1a30c0] mb-3 pb-1 border-b border-[#1a30c0]/20">
            MOUSE + KEYBOARD
          </h3>
          
          <ul class="space-y-1.5 text-[#1a30c0]/90">
            <li>
              <span class="font-bold text-[#d02030]">WASD</span> move &nbsp;
              <span class="font-bold text-[#d02030]">Mouse</span> look &nbsp;
              <span class="font-bold text-[#d02030]">Shift</span> sprint
            </li>
            <li>
              <span class="font-bold text-[#d02030]">🚶 Walk only</span> — boots on the ground, no god view
            </li>
            <li>
              <span class="font-bold text-[#d02030]">🚶 Walk</span> the boulevards, rings &amp; roundabouts
            </li>
            <li>
              <span class="font-bold text-[#d02030]">⭕ Founder Circle</span> is the anchor — every axis meets there
            </li>
            <li>
              <span class="font-bold text-[#d02030]">Space</span> jump · <span class="font-bold text-[#d02030]">Space</span> again = double jump
            </li>
            <li>
              <span class="font-bold text-[#d02030]">C / Ctrl</span> crouch &nbsp;
              <span class="font-bold text-[#d02030]">Esc</span> pause / menu
            </li>
            <li>
              <span class="font-bold text-[#d02030]">L</span> launch your product (/product)
            </li>
          </ul>
        </div>

        <!-- Right Column: PS5 CONTROLLER & TYCOON GUIDE -->
        <div>
          <h3 class="text-sm sm:text-base font-bold uppercase tracking-wider text-[#1a30c0] mb-3 pb-1 border-b border-[#1a30c0]/20">
            INFINITOWN ISLAND
          </h3>
          
          <ul class="space-y-1.5 text-[#1a30c0]/90">
            <li>
              <span class="font-bold text-[#d02030]">🏙️ Procedural blocks</span> — towers grow taller downtown
            </li>
            <li>
              <span class="font-bold text-[#d02030]">💡 Lit windows</span> — cyan + warm glass, seeded layout
            </li>
            <li>
              <span class="font-bold text-[#d02030]">🚗 Live traffic</span> — 9 cars looping the grid, lights on
            </li>
            <li>
              <span class="font-bold text-[#d02030]">📍 Next piece</span> — founder plots along these streets
            </li>
            <li class="pt-1 text-[#059669] font-bold">
              ● Walk the avenues — the city grows here next
            </li>
            <li class="text-[#1a30c0]/80">
              ● Launches, hunts &amp; towers return with the plots
            </li>
          </ul>
        </div>
      </div>

      <!-- Settings: movement tuning -->
      <div class="mb-6 p-4 rounded-2xl border-2 border-dashed border-[#1a30c0]/40 bg-white/60">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm sm:text-base font-bold uppercase tracking-wider text-[#1a30c0]">
            ⚙️ Movement Settings
          </h3>
          <button
            id="btn-reset-settings"
            type="button"
            class="px-2.5 py-1 text-xs font-bold rounded-lg border border-[#1a30c0] text-[#1a30c0] hover:bg-[#1a30c0] hover:text-white transition-all cursor-pointer"
            title="Reset to defaults"
          >
            Reset
          </button>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-xs sm:text-[13px] text-[#1a30c0]">
          <label class="block">
            <span class="flex justify-between font-bold mb-1"><span>🚶 Walk speed</span><span id="set-walk-val" class="font-mono text-[#d02030]">20</span></span>
            <input id="set-walk" type="range" min="4" max="30" step="1" value="20" class="w-full accent-[#1a30c0] cursor-pointer" />
          </label>
          <label class="block">
            <span class="flex justify-between font-bold mb-1"><span>⚡ Sprint speed</span><span id="set-sprint-val" class="font-mono text-[#d02030]">36</span></span>
            <input id="set-sprint" type="range" min="10" max="60" step="1" value="36" class="w-full accent-[#1a30c0] cursor-pointer" />
          </label>
          <label class="block">
            <span class="flex justify-between font-bold mb-1"><span>🖱️ Look sensitivity</span><span id="set-look-val" class="font-mono text-[#d02030]">3.5</span></span>
            <input id="set-look" type="range" min="0.5" max="10" step="0.5" value="3.5" class="w-full accent-[#1a30c0] cursor-pointer" />
          </label>
          <label class="block">
            <span class="flex justify-between font-bold mb-1"><span>🦘 Jump power</span><span id="set-jump-val" class="font-mono text-[#d02030]">12</span></span>
            <input id="set-jump" type="range" min="6" max="20" step="0.5" value="12" class="w-full accent-[#d02030] cursor-pointer" />
          </label>
        </div>
        <p class="text-[11px] text-[#1a30c0]/60 mt-2">Applies instantly · saved in this browser</p>
      </div>

      <!-- Bottom Row: Return Info & Enter Code Box (Matching media_1789220264942.png) -->
      <div class="flex items-center justify-between pt-2">
        <div class="text-[11px] text-[#1a30c0]/60">
          press <span class="font-mono text-[#d02030] font-bold">[ESC]</span> anytime to return to this menu · <a href="https://github.com/Pavanspoojary/builtwhilebroke" target="_blank" rel="noopener noreferrer" class="hover:underline text-[#1a30c0]/80">builtwhilebroke</a>
        </div>

        <div class="relative">
          <input
            type="text"
            id="promo-code-input"
            placeholder="enter code here"
            class="w-36 px-3 py-1 text-xs rounded-lg border border-dashed border-[#1a30c0]/40 bg-white/70 text-[#1a30c0] placeholder-[#1a30c0]/40 focus:outline-none focus:border-[#1a30c0] font-mono text-right"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Ad Sponsor / Inspection Modal -->
  <div id="ad-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-[#faf7ee] border-[3px] border-[#1a30c0] rounded-3xl p-6 shadow-2xl relative font-[Patrick_Hand,cursive] -rotate-1 text-[#1a30c0] animate-in fade-in zoom-in duration-150">
      
      <button id="btn-close-modal" type="button" class="absolute top-4 right-4 text-2xl font-bold text-[#1a30c0] hover:text-[#d02030] cursor-pointer">
        ✕
      </button>

      <div class="flex items-center gap-2 mb-1">
        <span class="text-xl">🚀</span>
        <span id="modal-category" class="text-xs uppercase font-bold tracking-wider px-2 py-0.5 rounded-md border border-[#1a30c0] bg-[#1a30c0]/10">
          Launch Billboard
        </span>
      </div>

      <h3 id="modal-title" class="text-2xl font-black text-[#1a30c0] leading-tight">
        Ship Ave Gantry Board
      </h3>

      <!-- Metrics pill box -->
      <div class="grid grid-cols-2 gap-2 my-3 p-2.5 rounded-xl border-2 border-dashed border-[#1a30c0]/40 bg-white/70">
        <div>
          <div class="text-[11px] uppercase tracking-wider text-[#1a30c0]/70 font-bold">Hunters / mo</div>
          <div id="modal-views" class="text-xl font-bold text-[#1a30c0]">140,000/mo</div>
        </div>
        <div>
          <div class="text-[11px] uppercase tracking-wider text-[#1a30c0]/70 font-bold">Launch Fee</div>
          <div id="modal-price" class="text-xl font-bold text-[#d02030]">Free</div>
        </div>
      </div>

      <form id="ad-sponsor-form" class="space-y-3 mt-4">
        <input type="hidden" id="modal-ad-id" value="" />
        
        <div>
          <label class="block text-sm font-bold mb-1">Product name</label>
          <input
            type="text"
            id="input-brand-name"
            required
            placeholder="e.g. Raycast, Supabase, Bun"
            class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#1a30c0] text-[#1a30c0] placeholder-[#1a30c0]/40 text-base font-bold focus:outline-none focus:border-[#d02030]"
          />
        </div>

        <div>
          <label class="block text-sm font-bold mb-1">One-line pitch</label>
          <input
            type="text"
            id="input-tagline"
            required
            placeholder="e.g. Ship it before lunch"
            class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#1a30c0] text-[#1a30c0] placeholder-[#1a30c0]/40 text-base font-medium focus:outline-none focus:border-[#d02030]"
          />
        </div>

        <div>
          <label class="block text-sm font-bold mb-1">Logo / Banner Image URL (Optional)</label>
          <input
            type="url"
            id="input-logo-url"
            placeholder="https://example.com/logo.png"
            class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#1a30c0] text-[#1a30c0] placeholder-[#1a30c0]/40 text-base font-medium focus:outline-none focus:border-[#d02030]"
          />
          <span class="text-[11px] text-[#1a30c0]/70">Renders real image inside billboard with hand-drawn scotch tape</span>
        </div>

        <div>
          <label class="block text-sm font-bold mb-1">Product website (Optional)</label>
          <input
            type="url"
            id="input-link-url"
            placeholder="https://yourproduct.com"
            class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#1a30c0] text-[#1a30c0] placeholder-[#1a30c0]/40 text-base font-medium focus:outline-none focus:border-[#d02030]"
          />
        </div>

        <div>
          <label class="block text-sm font-bold mb-1">Doodle Pen Ink Color</label>
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-1 cursor-pointer">
              <input type="radio" name="accentColor" value="#1a30c0" checked class="accent-[#1a30c0]" />
              <span>Blue Ink</span>
            </label>
            <label class="flex items-center gap-1 cursor-pointer">
              <input type="radio" name="accentColor" value="#d02030" class="accent-[#d02030]" />
              <span class="text-[#d02030] font-bold">Red Ink</span>
            </label>
            <label class="flex items-center gap-1 cursor-pointer">
              <input type="radio" name="accentColor" value="#059669" class="accent-[#059669]" />
              <span class="text-[#059669]">Green</span>
            </label>
            <label class="flex items-center gap-1 cursor-pointer">
              <input type="radio" name="accentColor" value="#ea580c" class="accent-[#ea580c]" />
              <span class="text-[#ea580c]">Orange</span>
            </label>
          </div>
        </div>

        <button
          type="submit"
          class="w-full mt-2 py-2.5 rounded-2xl bg-[#1a30c0] hover:bg-[#152799] text-[#faf7ee] font-black text-lg transition-all shadow-md cursor-pointer -rotate-1 active:scale-95"
        >
          🚀 Launch Product in 3D
        </button>
      </form>

      <!-- Leased Ad Details & Visit Link -->
      <div id="modal-leased-info" class="hidden space-y-3 mt-4">
        <button
          id="btn-upvote-product"
          type="button"
          class="w-full py-2.5 rounded-2xl bg-[#d02030] hover:bg-[#b51826] text-white font-black text-lg transition-all shadow-md cursor-pointer active:scale-95 disabled:opacity-50 disabled:cursor-default"
        >
          ▲ Upvote · <span id="modal-upvotes">0</span>
        </button>
        <div id="modal-image-preview-container" class="p-3 bg-white/70 rounded-xl border border-[#1a30c0]/30 text-center">
          <img id="modal-image-preview" src="" alt="Sponsor Banner" class="max-h-32 max-w-full mx-auto object-contain rounded-md" />
        </div>
        <a
          id="btn-visit-sponsor"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="block w-full py-2.5 rounded-2xl bg-[#059669] hover:bg-[#047857] text-white text-center font-black text-lg transition-all shadow-md cursor-pointer"
        >
          🚀 Visit Product Website ↗
        </a>
      </div>

      <div id="sponsor-success" class="hidden text-center py-4">
        <div class="text-4xl mb-1">🚀</div>
        <h4 class="text-xl font-black text-[#059669]">You're Live on the Hunt!</h4>
        <p class="text-sm text-[#1a30c0] mt-1">
          Your product is live on the 3D hunt board. Walk the world and gather upvotes!
        </p>
      </div>
    </div>
  </div>

</div>

<!-- Client-Side Doodle Engine Bootstrap Script -->
<script>
  import * as THREE from "three";
  import { DoodleEngine } from "./DoodleEngine";
  import { CityBuilder, type BuildingType } from "./CityBuilder";
  import { CameraController } from "./CameraController";
  import { doodleAudio } from "./DoodleAudio";
  import { DISTRICT_REGISTRY } from "./DistrictManager";
  import { FirstFloor } from "./FirstFloor";
  import { SecondFloor } from "./SecondFloor";
  import { UpperFloors, FLOOR_BASES, FLOOR_NAMES } from "./UpperFloors";

  function initDoodleDistrict() {
    const canvas = document.getElementById("doodle-canvas") as HTMLCanvasElement;
    if (!canvas) return;

    const engine = new DoodleEngine({ canvas });
    const city = new CityBuilder(engine);
    // Piece 03+04+05: lobby, discussion floor and tower offices (with lift).
    new FirstFloor(engine, city);
    new SecondFloor(engine, city);
    new UpperFloors(engine, city);
    const cameraCtrl = new CameraController(engine.camera, canvas);
    cameraCtrl.getColliders = () => city.getColliders();
    city.cameraController = cameraCtrl;

    // Walk-only: god view removed, boots on the ground from the first frame
    cameraCtrl.setMode("walk");
    cameraCtrl.autoRotate = false;

    // DOM Elements
    const landingOverlay = document.getElementById("landing-overlay");
    const doodleHud = document.getElementById("doodle-hud");
    const btnStart = document.getElementById("btn-start-game");
    const btnBuyAction = document.getElementById("btn-buy-spaces-action");
    const btnOpenMenu = document.getElementById("btn-open-menu");
    const hudMapNyc = document.getElementById("hud-map-nyc");
    const hudMapMonaco = document.getElementById("hud-map-monaco");
    const hudMapNeon = document.getElementById("hud-map-neon");
    const hudMapOldtown = document.getElementById("hud-map-oldtown");
    const hudMapWaterfront = document.getElementById("hud-map-waterfront");
    const hudDistrictSelect = document.getElementById("hud-district-select") as HTMLSelectElement | null;
    const hudDistrictLabel = document.getElementById("hud-district-label");
    const promoInput = document.getElementById("promo-code-input") as HTMLInputElement | null;

    const revEl = document.getElementById("metric-revenue");
    const viewsEl = document.getElementById("metric-views");
    const slotsEl = document.getElementById("metric-slots");
    const discoveryToast = document.getElementById("discovery-toast");
    const discoveryTitle = document.getElementById("discovery-title");
    const discoveryIcon = document.getElementById("discovery-icon");
    const discoveryCategory = document.getElementById("discovery-category");
    const modal = document.getElementById("ad-modal");
    const modalClose = document.getElementById("btn-close-modal");
    const modalCategory = document.getElementById("modal-category");
    const modalTitle = document.getElementById("modal-title");
    const modalViews = document.getElementById("modal-views");
    const modalPrice = document.getElementById("modal-price");
    const modalAdId = document.getElementById("modal-ad-id") as HTMLInputElement;
    const inputBrand = document.getElementById("input-brand-name") as HTMLInputElement;
    const inputTagline = document.getElementById("input-tagline") as HTMLInputElement;
    const inputLogoUrl = document.getElementById("input-logo-url") as HTMLInputElement | null;
    const inputLinkUrl = document.getElementById("input-link-url") as HTMLInputElement | null;
    const modalLeasedBox = document.getElementById("modal-leased-info");
    const modalImagePreviewContainer = document.getElementById("modal-image-preview-container");
    const modalImagePreview = document.getElementById("modal-image-preview") as HTMLImageElement | null;
    const btnVisitSponsor = document.getElementById("btn-visit-sponsor") as HTMLAnchorElement | null;
    const btnUpvote = document.getElementById("btn-upvote-product") as HTMLButtonElement | null;
    const modalUpvotes = document.getElementById("modal-upvotes");
    const huntList = document.getElementById("hunt-list");
    const huntCountdown = document.getElementById("hunt-countdown");
    const shipLogList = document.getElementById("ship-log-list");
    const btnHuntLaunch = document.getElementById("btn-hunt-launch");
    const sponsorForm = document.getElementById("ad-sponsor-form") as HTMLFormElement;
    const sponsorSuccess = document.getElementById("sponsor-success");
    const walkHelper = document.getElementById("walk-helper");
    const btnSound = document.getElementById("btn-sound-toggle");

    // Hunt voting memory (one upvote per product per hunter)
    let votedIds: string[] = [];
    try {
      votedIds = JSON.parse(localStorage.getItem("doodle_hunt_votes") || "[]");
    } catch {
      votedIds = [];
    }
    function hasVoted(adId: string): boolean {
      return votedIds.includes(adId);
    }
    function rememberVote(adId: string) {
      if (!hasVoted(adId)) {
        votedIds.push(adId);
        try {
          localStorage.setItem("doodle_hunt_votes", JSON.stringify(votedIds));
        } catch {
          /* private mode — votes last for the session */
        }
      }
    }

    function updateDashboardMetrics() {
      const ads = Array.from(city.adSpaces.values());
      const live = ads.filter((a) => !a.isAvailable);
      const totalUpvotes = live.reduce((sum, a) => sum + (a.upvotes || 0), 0);
      if (revEl) revEl.textContent = `▲ ${totalUpvotes.toLocaleString()}`;
      if (viewsEl) viewsEl.textContent = `${live.length}`;
      if (slotsEl) slotsEl.textContent = `${ads.length - live.length}`;
      renderHuntBoard();
      renderShipLog();
    }

    function renderHuntBoard() {
      if (!huntList) return;
      const leaders = city.getHuntLeaderboard(5);
      huntList.innerHTML = "";
      if (leaders.length === 0) {
        const li = document.createElement("li");
        li.className = "text-[#1a30c0]/60 font-medium";
        li.textContent = "No launches yet — the city is a blank page.";
        huntList.appendChild(li);
        return;
      }
      leaders.forEach((ad, idx) => {
        const li = document.createElement("li");
        li.className = "flex items-center gap-2";
        const medal = idx === 0 ? "🥇" : idx === 1 ? "🥈" : idx === 2 ? "🥉" : `${idx + 1}.`;
        li.innerHTML = `<span>${medal}</span><span class="flex-1 truncate"></span><span class="font-mono text-[#d02030]">▲ ${ad.upvotes.toLocaleString()}</span>`;
        li.querySelector("span:nth-child(2)")!.textContent = ad.sponsorName;
        li.title = ad.sponsorTagline;
        huntList.appendChild(li);
      });
    }

    function renderShipLog() {
      if (!shipLogList) return;
      const ships = city.getShipLog(4);
      shipLogList.innerHTML = "";
      if (ships.length === 0) {
        const li = document.createElement("li");
        li.className = "text-[#1a30c0]/60";
        li.textContent = "Nothing shipped yet. First launch writes history.";
        shipLogList.appendChild(li);
        return;
      }
      ships.forEach((ad) => {
        const li = document.createElement("li");
        li.className = "flex items-start gap-1.5";
        const fresh = ad.leasedAt > 0 ? "🆕" : "✅";
        const name = document.createElement("span");
        name.className = "font-bold";
        name.textContent = `${fresh} ${ad.sponsorName}`;
        const pitch = document.createElement("span");
        pitch.className = "text-[#1a30c0]/70";
        pitch.textContent = ` — ${ad.sponsorTagline}`;
        li.appendChild(name);
        li.appendChild(pitch);
        shipLogList.appendChild(li);
      });
    }

    function tickHuntCountdown() {
      if (!huntCountdown) return;
      const now = new Date();
      const midnight = new Date(now);
      midnight.setHours(24, 0, 0, 0);
      const diff = Math.max(0, midnight.getTime() - now.getTime());
      const hh = Math.floor(diff / 3600000);
      const mm = Math.floor((diff % 3600000) / 60000);
      const ss = Math.floor((diff % 60000) / 1000);
      huntCountdown.textContent = `${hh.toString().padStart(2, "0")}:${mm.toString().padStart(2, "0")}:${ss.toString().padStart(2, "0")}`;
    }
    tickHuntCountdown();
    setInterval(tickHuntCountdown, 1000);

    let toastTimeout: any = null;
    function showDiscoveryToast(secret: any) {
      if (!discoveryToast || !discoveryTitle) return;
      if (discoveryIcon) discoveryIcon.textContent = "✨";
      if (discoveryCategory) discoveryCategory.textContent = "SECRET DISCOVERED!";
      discoveryTitle.textContent = `${secret.name} (${city.collectedSecrets.size}/30 Found!)`;
      discoveryToast.classList.remove("hidden");
      updateDashboardMetrics();
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        discoveryToast.classList.add("hidden");
      }, 4000);
    }

    function showDistrictEntryToast(info: any) {
      if (!discoveryToast || !discoveryTitle) return;
      if (discoveryIcon) discoveryIcon.textContent = "📍";
      if (discoveryCategory) discoveryCategory.textContent = "DISTRICT ENTERED";
      discoveryTitle.textContent = `${info.name} — ${info.subtitle}`;
      discoveryToast.classList.remove("hidden");
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        discoveryToast.classList.add("hidden");
      }, 3500);
    }

    updateDashboardMetrics();

    // Enter City from Landing Screen (walk mode only — god view removed)
    function enterCity() {
      try {
        doodleAudio.penClick();
      } catch (e) {
        console.warn("Audio error:", e);
      }
      if (cameraCtrl) {
        cameraCtrl.autoRotate = false;
        cameraCtrl.setMode("walk");
      }
      if (walkHelper) {
        walkHelper.classList.remove("hidden");
      }
      if (landingOverlay) {
        landingOverlay.classList.add("hidden");
        landingOverlay.style.display = "none";
      }
      if (doodleHud) {
        doodleHud.classList.remove("hidden");
        doodleHud.style.display = "block";
      }
    }

    function openMenu() {
      try {
        doodleAudio.penClick();
      } catch (e) {
        console.warn("Audio error:", e);
      }
      if (cameraCtrl) {
        cameraCtrl.autoRotate = true;
      }
      if (landingOverlay) {
        landingOverlay.classList.remove("hidden");
        landingOverlay.style.display = "flex";
      }
      if (doodleHud) {
        doodleHud.classList.add("hidden");
        doodleHud.style.display = "none";
      }
    }

    btnStart?.addEventListener("click", enterCity);
    btnOpenMenu?.addEventListener("click", openMenu);

    // Launch CTA opens the first open launch board (falls back to any board).
    // Roads-only step: no boards exist yet, so hunters get a progress toast.
    function showNote(icon: string, category: string, title: string) {
      if (!discoveryToast || !discoveryTitle) return;
      if (discoveryIcon) discoveryIcon.textContent = icon;
      if (discoveryCategory) discoveryCategory.textContent = category;
      discoveryTitle.textContent = title;
      discoveryToast.classList.remove("hidden");
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        discoveryToast.classList.add("hidden");
      }, 3500);
    }

    function openLaunchFlow() {
      enterCity();
      const ads = Array.from(city.adSpaces.values());
      const openSlot = ads.find((a) => a.isAvailable) || ads[0];
      if (openSlot) {
        openAdModal(openSlot);
      } else {
        showNote("🛣️", "CITY UNDER CONSTRUCTION", "Launch boards return with the founder plots");
      }
    }

    btnBuyAction?.addEventListener("click", () => {
      // Lobby CTA goes to the free product hunt page
      window.location.href = "/product";
    });
    btnHuntLaunch?.addEventListener("click", () => {
      // HUD hunt button goes to the free product hunt page
      window.location.href = "/product";
    });

    // ESC key toggles Menu, L opens the product hunt page (/product)
    window.addEventListener("keydown", (e) => {
      if ((e.code === "KeyL" || e.key === "l" || e.key === "L") && (!modal || modal.classList.contains("hidden"))) {
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === "input" || tag === "textarea" || tag === "select") return;
        window.location.href = "/product";
      }
      if (e.key === "Escape") {
        if (modal && !modal.classList.contains("hidden")) {
          modal.classList.add("hidden");
        } else if (landingOverlay?.classList.contains("hidden")) {
          openMenu();
        } else {
          enterCity();
        }
      }
    });

    let activeDistrictId = "downtown";

    // District / Map Switcher Function
    function setDistrict(district: string) {
      city.switchDistrict(district);
      activeDistrictId = city.currentDistrict;
      updateDashboardMetrics();
      doodleAudio.penClick();

      const info = DISTRICT_REGISTRY.find((d) => d.id === city.currentDistrict || d.id === district) || DISTRICT_REGISTRY[0];
      if (hudDistrictLabel) hudDistrictLabel.textContent = `${info.name} · Launch World`;
      if (hudDistrictSelect) hudDistrictSelect.value = info.id;
      showDistrictEntryToast(info);

      // Reset all tabs to inactive state
      const inactiveTabClass = "district-tab px-3.5 py-1.5 rounded-xl text-left border-2 border-[#1a30c0]/40 hover:border-[#1a30c0] text-[#1a30c0] hover:bg-[#1a30c0]/10 shadow-sm cursor-pointer transition-all";
      const activeTabClass = "district-tab px-3.5 py-1.5 rounded-xl text-left border-2 border-[#1a30c0] bg-[#1a30c0] text-[#faf7ee] shadow-sm cursor-pointer transition-all";
      const inactiveMapClass = "px-3 py-1 rounded-xl text-xs sm:text-sm font-medium text-[#1a30c0] hover:bg-[#1a30c0]/10 transition-all cursor-pointer";
      const activeMapClass = "px-3 py-1 rounded-xl text-xs sm:text-sm font-bold bg-[#1a30c0] text-[#faf7ee] transition-all cursor-pointer";

      // Reset tabs
      document.querySelectorAll(".district-tab").forEach((tab) => {
        tab.className = inactiveTabClass;
        const subtext = tab.querySelector("span:last-child");
        if (subtext) subtext.className = "block text-[10px] text-[#1a30c0]/70 mt-0.5";
      });

      // Highlight matching tab
      const tabTarget = document.querySelector(`.district-tab[data-district="${info.id}"]`) ||
                        (info.id === "downtown" ? document.getElementById("tab-district-nyc") : null) ||
                        (info.id === "monaco" ? document.getElementById("tab-district-monaco") : null);
      if (tabTarget) {
        tabTarget.className = activeTabClass;
        const subtext = tabTarget.querySelector("span:last-child");
        if (subtext) subtext.className = "block text-[10px] text-blue-100/80 mt-0.5";
      }

      // Reset HUD map buttons
      if (hudMapNyc) hudMapNyc.className = inactiveMapClass;
      if (hudMapMonaco) hudMapMonaco.className = inactiveMapClass;
      if (hudMapNeon) hudMapNeon.className = inactiveMapClass;
      if (hudMapOldtown) hudMapOldtown.className = inactiveMapClass;
      if (hudMapWaterfront) hudMapWaterfront.className = inactiveMapClass;

      if ((info.id === "downtown" || info.id === "nyc") && hudMapNyc) hudMapNyc.className = activeMapClass;
      if (info.id === "monaco" && hudMapMonaco) hudMapMonaco.className = activeMapClass;
      if (info.id === "neon" && hudMapNeon) hudMapNeon.className = activeMapClass;
      if (info.id === "oldtown" && hudMapOldtown) hudMapOldtown.className = activeMapClass;
      if (info.id === "waterfront" && hudMapWaterfront) hudMapWaterfront.className = activeMapClass;
    }

    // Bind all district tabs in landing overlay
    document.querySelectorAll(".district-tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        const dist = tab.getAttribute("data-district") || "downtown";
        setDistrict(dist);
      });
    });

    // In-HUD Quick Map Switcher button listeners
    hudMapNyc?.addEventListener("click", () => setDistrict("downtown"));
    hudMapMonaco?.addEventListener("click", () => setDistrict("monaco"));
    hudMapNeon?.addEventListener("click", () => setDistrict("neon"));
    hudMapOldtown?.addEventListener("click", () => setDistrict("oldtown"));
    hudMapWaterfront?.addEventListener("click", () => setDistrict("waterfront"));

    // In-HUD 15 Districts Dropdown Jump
    hudDistrictSelect?.addEventListener("change", (e) => {
      const selected = (e.target as HTMLSelectElement).value;
      setDistrict(selected);
    });

    // Tool Switching
    document.querySelectorAll(".tool-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".tool-btn").forEach((b) => {
          b.classList.remove("bg-[#1a30c0]", "text-[#faf7ee]");
          b.classList.add("text-[#1a30c0]");
        });
        btn.classList.add("bg-[#1a30c0]", "text-[#faf7ee]");
        btn.classList.remove("text-[#1a30c0]");

        const tool = btn.getAttribute("data-tool") as BuildingType | "select";
        city.buildTool = tool;
        doodleAudio.penClick();
      });
    });

    // Number keys 1-7 for instant tool switching
    const toolOrder: (BuildingType | "select")[] = ["select", "skyscraper", "indie-loft", "crane-tower", "highway-billboard", "street-kiosk", "tree"];
    window.addEventListener("keydown", (e) => {
      const num = parseInt(e.key, 10);
      if (num >= 1 && num <= toolOrder.length && landingOverlay?.classList.contains("hidden")) {
        const tool = toolOrder[num - 1];
        city.buildTool = tool;
        document.querySelectorAll(".tool-btn").forEach((b, idx) => {
          if (idx === num - 1) {
            b.classList.add("bg-[#1a30c0]", "text-[#faf7ee]");
            b.classList.remove("text-[#1a30c0]");
          } else {
            b.classList.remove("bg-[#1a30c0]", "text-[#faf7ee]");
            b.classList.add("text-[#1a30c0]");
          }
        });
        doodleAudio.penClick();
      }
    });

    // Camera Mode Toggle
    const btnOrbit = document.getElementById("btn-mode-orbit");
    const btnWalk = document.getElementById("btn-mode-walk");

    btnOrbit?.addEventListener("click", () => {
      cameraCtrl.setMode("orbit");
      btnOrbit.className = "px-3.5 py-1 rounded-xl text-xs sm:text-sm font-bold bg-[#1a30c0] text-[#faf7ee] transition-all cursor-pointer";
      btnWalk!.className = "px-3.5 py-1 rounded-xl text-xs sm:text-sm font-medium text-[#1a30c0] hover:bg-[#1a30c0]/10 transition-all cursor-pointer";
      walkHelper?.classList.add("hidden");
      doodleAudio.penClick();
    });

    btnWalk?.addEventListener("click", () => {
      cameraCtrl.setMode("walk");
      btnWalk.className = "px-3.5 py-1 rounded-xl text-xs sm:text-sm font-bold bg-[#1a30c0] text-[#faf7ee] transition-all cursor-pointer";
      btnOrbit!.className = "px-3.5 py-1 rounded-xl text-xs sm:text-sm font-medium text-[#1a30c0] hover:bg-[#1a30c0]/10 transition-all cursor-pointer";
      walkHelper?.classList.remove("hidden");
      doodleAudio.penClick();
    });

    // Sound Toggle
    btnSound?.addEventListener("click", () => {
      const enabled = doodleAudio.toggle();
      btnSound.textContent = `🔊 Pen SFX: ${enabled ? "ON" : "OFF"}`;
      if (enabled) doodleAudio.penClick();
    });

    // Movement settings: sliders -> camera, persisted to localStorage
    const MOVE_DEFAULTS = { walk: 20, sprint: 36, look: 3.5, jump: 12 };
    const setWalk = document.getElementById("set-walk") as HTMLInputElement | null;
    const setSprint = document.getElementById("set-sprint") as HTMLInputElement | null;
    const setLook = document.getElementById("set-look") as HTMLInputElement | null;
    const setJump = document.getElementById("set-jump") as HTMLInputElement | null;
    const setWalkVal = document.getElementById("set-walk-val");
    const setSprintVal = document.getElementById("set-sprint-val");
    const setLookVal = document.getElementById("set-look-val");
    const setJumpVal = document.getElementById("set-jump-val");
    const btnResetSettings = document.getElementById("btn-reset-settings");

    function readMovementSettings(): typeof MOVE_DEFAULTS {
      try {
        const raw = localStorage.getItem("doodle_move_settings");
        if (!raw) return { ...MOVE_DEFAULTS };
        const parsed = JSON.parse(raw);
        return {
          walk: Number(parsed.walk) || MOVE_DEFAULTS.walk,
          sprint: Number(parsed.sprint) || MOVE_DEFAULTS.sprint,
          look: Number(parsed.look) || MOVE_DEFAULTS.look,
          jump: Number(parsed.jump) || MOVE_DEFAULTS.jump,
        };
      } catch {
        return { ...MOVE_DEFAULTS };
      }
    }

    function applyMovementSettings(s: typeof MOVE_DEFAULTS) {
      cameraCtrl.walkSpeed = s.walk;
      cameraCtrl.sprintSpeed = s.sprint;
      cameraCtrl.lookSensitivity = s.look / 1000;
      cameraCtrl.jumpPower = s.jump;
      if (setWalk) setWalk.value = String(s.walk);
      if (setSprint) setSprint.value = String(s.sprint);
      if (setLook) setLook.value = String(s.look);
      if (setJump) setJump.value = String(s.jump);
      if (setWalkVal) setWalkVal.textContent = String(s.walk);
      if (setSprintVal) setSprintVal.textContent = String(s.sprint);
      if (setLookVal) setLookVal.textContent = String(s.look);
      if (setJumpVal) setJumpVal.textContent = String(s.jump);
    }

    function collectMovementSettings(): typeof MOVE_DEFAULTS {
      return {
        walk: setWalk ? Number(setWalk.value) : MOVE_DEFAULTS.walk,
        sprint: setSprint ? Number(setSprint.value) : MOVE_DEFAULTS.sprint,
        look: setLook ? Number(setLook.value) : MOVE_DEFAULTS.look,
        jump: setJump ? Number(setJump.value) : MOVE_DEFAULTS.jump,
      };
    }

    function saveMovementSettings(s: typeof MOVE_DEFAULTS) {
      try {
        localStorage.setItem("doodle_move_settings", JSON.stringify(s));
      } catch {
        /* private mode — settings last for the session */
      }
    }

    applyMovementSettings(readMovementSettings());
    for (const el of [setWalk, setSprint, setLook, setJump]) {
      el?.addEventListener("input", () => {
        const s = collectMovementSettings();
        // Sprint must stay above walk speed
        if (s.sprint < s.walk) {
          s.sprint = s.walk;
          if (setSprint) setSprint.value = String(s.sprint);
          if (setSprintVal) setSprintVal.textContent = String(s.sprint);
        }
        applyMovementSettings(s);
        saveMovementSettings(s);
      });
    }
    btnResetSettings?.addEventListener("click", () => {
      applyMovementSettings({ ...MOVE_DEFAULTS });
      saveMovementSettings({ ...MOVE_DEFAULTS });
      doodleAudio.penClick();
    });

    // Open Product Modal helper with upvotes, image & link support
    function refreshUpvoteButton(ad: any) {
      if (modalUpvotes) modalUpvotes.textContent = (ad.upvotes || 0).toLocaleString();
      if (btnUpvote) {
        const voted = hasVoted(ad.id);
        btnUpvote.disabled = voted;
        btnUpvote.innerHTML = voted
          ? `▲ Upvoted · <span id="modal-upvotes">${(ad.upvotes || 0).toLocaleString()}</span>`
          : `▲ Upvote · <span id="modal-upvotes">${(ad.upvotes || 0).toLocaleString()}</span>`;
      }
    }

    btnUpvote?.addEventListener("click", () => {
      const adId = modalAdId.value;
      if (!adId || hasVoted(adId)) return;
      const total = city.upvoteAdSpace(adId);
      rememberVote(adId);
      const ad = city.adSpaces.get(adId);
      if (ad) refreshUpvoteButton(ad);
      else if (modalUpvotes) modalUpvotes.textContent = total.toLocaleString();
      updateDashboardMetrics();
    });

    function openAdModal(ad: any) {
      modalCategory!.textContent = ad.category;
      modalTitle!.textContent = ad.title;
      modalViews!.textContent = `${ad.viewsMonthly.toLocaleString()}/mo`;
      modalPrice!.textContent = ad.priceMonthly > 0 ? `$${ad.priceMonthly} launch fee` : "Free to launch";
      modalAdId.value = ad.id;
      inputBrand.value = ad.sponsorName === "YOUR PRODUCT HERE" ? "" : ad.sponsorName;
      inputTagline.value = ad.isAvailable ? "" : ad.sponsorTagline;
      if (inputLogoUrl) inputLogoUrl.value = ad.imageUrl || "";
      if (inputLinkUrl) inputLinkUrl.value = ad.linkUrl || "";

      if (ad.isAvailable) {
        sponsorForm.classList.remove("hidden");
        modalLeasedBox?.classList.add("hidden");
      } else {
        sponsorForm.classList.remove("hidden");
        refreshUpvoteButton(ad);
        if (modalLeasedBox) {
          modalLeasedBox.classList.remove("hidden");
          if (ad.imageUrl && modalImagePreview && modalImagePreviewContainer) {
            modalImagePreview.src = ad.imageUrl;
            modalImagePreviewContainer.classList.remove("hidden");
          } else if (modalImagePreviewContainer) {
            modalImagePreviewContainer.classList.add("hidden");
          }
          if (btnVisitSponsor) {
            btnVisitSponsor.href = ad.linkUrl || "https://builtwhilebroke.tech";
          }
        }
      }

      sponsorSuccess?.classList.add("hidden");
      modal?.classList.remove("hidden");
    }

    // Canvas click handling
    canvas.addEventListener("click", (e) => {
      const clickedAd = city.handlePointerClick(e);
      if (clickedAd) {
        openAdModal(clickedAd);
      } else if (city.buildTool !== "select") {
        updateDashboardMetrics();
      }
    });

    modalClose?.addEventListener("click", () => {
      modal?.classList.add("hidden");
      doodleAudio.penClick();
    });

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) modal.classList.add("hidden");
    });

    // Submit Product Launch with Logo & URL
    sponsorForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const adId = modalAdId.value;
      const brandName = inputBrand.value.trim() || "UNNAMED PRODUCT";
      const tagline = inputTagline.value.trim() || "Fresh out of the builder lofts";
      const colorRadio = document.querySelector('input[name="accentColor"]:checked') as HTMLInputElement | null;
      const accentColor = colorRadio ? colorRadio.value : "#1a30c0";
      const logoUrl = inputLogoUrl ? inputLogoUrl.value.trim() : "";
      const linkUrl = inputLinkUrl ? inputLinkUrl.value.trim() : "";

      city.leaseAdSpace(adId, {
        sponsorName: brandName,
        sponsorTagline: tagline,
        accentColor,
        imageUrl: logoUrl || undefined,
        linkUrl: linkUrl || undefined,
      });

      updateDashboardMetrics();

      sponsorForm.classList.add("hidden");
      sponsorSuccess?.classList.remove("hidden");

      setTimeout(() => {
        modal?.classList.add("hidden");
      }, 1600);
    });

    // Easter egg code handler
    promoInput?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        const val = promoInput.value.trim().toLowerCase();
        if (val === "broke" || val === "hack" || val === "doodle") {
          doodleAudio.rentAd();
          promoInput.value = "CODE UNLOCKED! ✨";
          setTimeout(() => {
            promoInput.value = "";
          }, 2000);
        }
      }
    });

    function checkDistrictBoundary(_pos: any) {
      // Single unified compact metropolis - no boundary hopping toasts
    }

    // Animation Loop
    let lastTime = performance.now();
    const liftChip = document.getElementById("lift-chip");
    const liftFloorLabel = document.getElementById("lift-floor-label");
    let liftChipText = "";

    function inLiftCab(p: any): boolean {
      return Math.abs(p.x - 36.5) < 2 && Math.abs(p.z) < 1.2;
    }
    function floorAtFeet(feetY: number): number {
      let best = -1;
      let bestD = 2.5;
      for (let f = 0; f < FLOOR_BASES.length; f++) {
        const d = Math.abs(feetY - FLOOR_BASES[f]);
        if (d < bestD) {
          bestD = d;
          best = f;
        }
      }
      return best;
    }
    function rideLiftTo(floor: number) {
      if (floor < 0 || floor > 9) return;
      doodleAudio.discoveryChime();
      const base = FLOOR_BASES[floor];
      // Face west on arrival so holding W strolls out of the doorway
      cameraCtrl.teleportTo(36.5, base, 0, new THREE.Vector3(28, base + 2, 0));
      // Freeze held keys briefly so the ride keypress never walks you out
      cameraCtrl.clearMoveFlags();
      cameraCtrl.suppressMoveUntil = performance.now() + 450;
      showNote("🛗", `LEVEL ${floor}`, `${FLOOR_NAMES[floor]} floor`);
    }
    function updateLiftChip(p: any) {
      if (!liftChip || !liftFloorLabel) return;
      if (!inLiftCab(p)) {
        if (liftChipText !== "") {
          liftChipText = "";
          liftChip.classList.add("hidden");
        }
        return;
      }
      const f = floorAtFeet(p.y - 1.85);
      const label = f >= 0 ? `L${f} · ${FLOOR_NAMES[f]}` : "···";
      if (label !== liftChipText) {
        liftChipText = label;
        liftFloorLabel.textContent = label;
        liftChip.classList.remove("hidden");
      }
    }

    // W/S drives the lift while standing in the cab (fresh presses only).
    // Face the east panel to ride; face the west doors to walk out instead.
    // Number keys dial a floor directly from anywhere (1-9, 0 = 10).
    const digitMap: Record<string, number> = {
      Digit0: 0, Digit1: 1, Digit2: 2, Digit3: 3, Digit4: 4,
      Digit5: 5, Digit6: 6, Digit7: 7, Digit8: 8, Digit9: 9,
      Numpad0: 0, Numpad1: 1, Numpad2: 2, Numpad3: 3, Numpad4: 4,
      Numpad5: 5, Numpad6: 6, Numpad7: 7, Numpad8: 8, Numpad9: 9,
    };
    // Two-digit dial buffer: "1" pauses for a possible "0" (= top floor L9)
    let dialPending: string | null = null;
    let dialTimer: number | null = null;
    window.addEventListener("keydown", (e) => {
      if (e.repeat || cameraCtrl.mode !== "walk") return;
      if (e.code in digitMap) {
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === "input" || tag === "textarea" || tag === "select") return;
        const p = cameraCtrl.getPosition();
        const f = floorAtFeet(p.y - 1.85);
        if (f < 0) return;
        const d = digitMap[e.code];
        if (dialTimer !== null) {
          window.clearTimeout(dialTimer);
          dialTimer = null;
        }
        if (dialPending === "1") {
          // Second digit: "10" means the top floor, anything else keeps floor 1
          dialPending = null;
          const target = d === 0 ? 9 : 1;
          if (target !== f) rideLiftTo(target);
          return;
        }
        if (d === 1) {
          dialPending = "1";
          showNote("🛗", "DIALING", "1… (press 0 for the top floor)");
          dialTimer = window.setTimeout(() => {
            dialTimer = null;
            dialPending = null;
            if (f !== 1) rideLiftTo(1);
          }, 1500);
          return;
        }
        dialPending = null;
        if (d !== f) rideLiftTo(d);
        return;
      }
      if (e.code !== "KeyW" && e.code !== "KeyS") return;
      const p = cameraCtrl.getPosition();
      if (!inLiftCab(p)) return;
      if (cameraCtrl.doorFacing() >= 0.5) return; // facing the doors: walk, don't ride
      const f = floorAtFeet(p.y - 1.85);
      if (f < 0) return;
      if (e.code === "KeyW" && f < 9) rideLiftTo(f + 1);
      else if (e.code === "KeyS" && f > 0) rideLiftTo(f - 1);
    });

    function animate(time: number) {
      requestAnimationFrame(animate);
      const delta = Math.min((time - lastTime) / 1000, 0.1);
      lastTime = time;

      cameraCtrl.update(delta);
      city.update(delta);

      if (cameraCtrl.mode === "walk") {
        const p = cameraCtrl.getPosition();
        city.checkSecretsProximity(p, (secret) => {
          showDiscoveryToast(secret);
        });
        checkDistrictBoundary(p);
        updateLiftChip(p);
      }
      engine.render(delta);
    }

    requestAnimationFrame(animate);
  }

  function safeInit() {
    try {
      initDoodleDistrict();
    } catch (err) {
      console.error("[DoodleDistrict] Failed to initialize 3D scene:", err);
      const btnStart = document.getElementById("btn-start-game");
      const landingOverlay = document.getElementById("landing-overlay");
      const doodleHud = document.getElementById("doodle-hud");
      btnStart?.addEventListener("click", () => {
        if (landingOverlay) {
          landingOverlay.classList.add("hidden");
          landingOverlay.style.display = "none";
        }
        if (doodleHud) {
          doodleHud.classList.remove("hidden");
          doodleHud.style.display = "block";
        }
      });
      const btnBuyAction = document.getElementById("btn-buy-spaces-action");
      btnBuyAction?.addEventListener("click", () => {
        window.location.href = "/product";
      });
      window.addEventListener("keydown", (e) => {
        if (e.code === "KeyL" || e.key === "l" || e.key === "L") {
          const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
          if (tag === "input" || tag === "textarea" || tag === "select") return;
          window.location.href = "/product";
        }
      });
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", safeInit);
  } else {
    safeInit();
  }
</script>
