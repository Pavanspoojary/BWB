---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "DOODLE DISTRICT · The Scribbled City Builder & Ad Marketplace",
  description = "A scribbled 3D notebook-sketch city where you build skyscrapers, place billboards, and buy/sell developer ad spaces.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23faf7ee' stroke='%231a30c0' stroke-width='2'/><path d='M6 8h20M6 14h20M6 20h20M6 26h20' stroke='%231a30c0' stroke-opacity='0.25' stroke-width='1.5'/><circle cx='10' cy='6' r='2' fill='%23d02030'/><path d='M10 16l4-6 5 4 7-8' stroke='%231a30c0' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Doodle District" />
    <meta name="theme-color" content="#faf7ee" />

    <!-- Google Fonts for Authentic Notebook & Hand-Drawn Doodle Aesthetic -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Caveat:wght@600;700&family=Kalam:wght@700&family=Patrick+Hand&family=Plus+Jakarta+Sans:wght@500;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        --paper-bg: #faf7ee;
        --ink-blue: #1a30c0;
        --ink-red: #d02030;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: var(--paper-bg);
        color: var(--ink-blue);
        overflow: hidden;
        user-select: none;
        -webkit-user-select: none;
        font-family: 'Patrick Hand', cursive, sans-serif;
      }

      /* Ruled notebook line background simulation */
      .notebook-ruled-bg {
        background-color: #faf7ee;
        background-image: 
          linear-gradient(90deg, transparent 79px, #d02030 79px, #d02030 81px, transparent 81px),
          linear-gradient(#1a30c01a 1px, transparent 1px);
        background-size: 100% 100%, 100% 28px;
      }

      /* Subtle paper grain texture overlay */
      .paper-card {
        background-color: #faf7ee;
        border: 2.5px solid #1a30c0;
        border-radius: 24px;
        box-shadow: 0 10px 30px -5px rgba(26, 48, 192, 0.15), 0 0 0 1px rgba(26, 48, 192, 0.08);
      }

      .doodle-font {
        font-family: 'Patrick Hand', cursive, sans-serif;
      }

      .handwritten-font {
        font-family: 'Caveat', cursive, sans-serif;
      }

      /* Custom scrollbar for toolbar */
      ::-webkit-scrollbar {
        height: 6px;
        width: 6px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      ::-webkit-scrollbar-thumb {
        background: rgba(26, 48, 192, 0.2);
        border-radius: 9999px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: rgba(26, 48, 192, 0.4);
      }
    </style>
  <body class="fixed inset-0 w-screen h-screen overflow-hidden m-0 p-0 bg-[#faf7ee]">
    <slot />
  </body>
</html>
