---
interface Props {
  title?: string;
  description?: string;
  activePath?: string;
}

const {
  title = "Doodle District · Dev Spaces & 3D Ad Tycoon",
  description = "Browse and sponsor verified developer ad spaces inside tools, docs, and 3D Doodle City.",
  activePath = "/",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23faf7ee' stroke='%231a30c0' stroke-width='2'/><circle cx='10' cy='6' r='2' fill='%23d02030'/><path d='M10 16l4-6 5 4 7-8' stroke='%231a30c0' stroke-width='2' stroke-linecap='round'/></svg>" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Doodle District" />
    <meta name="keywords" content="doodle city, 3d city builder, developer ad spaces, micro-sponsorships, documentation ads, verified startup revenue, verified MRR, builtwhilebroke" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Doodle District" />

    <!-- Font imports -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&family=Patrick+Hand&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#0b0c0f] text-zinc-100 font-sans selection:bg-blue-600/30 selection:text-blue-200 min-h-screen relative flex flex-col antialiased">
    
    <!-- Main Content Wrapper -->
    <div class="flex-1 w-full flex flex-col items-center">
      
      <!-- Top Navigation Header -->
      {activePath !== '/' && (
        <header class="sticky top-0 z-40 w-full border-b border-[#1f222b] bg-[#0b0c0f]/90 backdrop-blur transition-colors">
          <div class="max-w-5xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
            
            <!-- Logo & Brand -->
            <a href="/" class="flex items-center gap-2 group">
              <span class="text-xl">🏙️</span>
              <span class="text-base font-bold tracking-tight text-white flex items-center gap-1.5 font-mono">
                DOODLE DISTRICT
                <span class="text-[9px] font-bold px-1.5 py-0.2 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20">3D AD TYCOON</span>
              </span>
            </a>

            <!-- Center Nav Links -->
            <nav class="hidden md:flex items-center gap-1 text-xs font-medium">
              <a
                href="/"
                class="px-3 py-1.5 rounded-lg text-zinc-400 hover:text-white transition-colors"
              >
                Home
              </a>
              <a
                href="/browser"
                class={`px-3 py-1.5 rounded-lg transition-colors ${activePath === '/browser' ? 'bg-zinc-800 text-white font-semibold' : 'text-zinc-400 hover:text-white'}`}
              >
                Marketplace
              </a>
              <a
                href="/goal"
                class={`px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1 ${activePath === '/goal' ? 'bg-zinc-800 text-white font-semibold' : 'text-zinc-400 hover:text-white'}`}
              >
                <span>Goal Planner</span>
                <span class="text-[8px] px-1 py-0.2 rounded bg-blue-500/20 text-blue-400 font-bold">PRO</span>
              </a>
              <a
                href="/boost"
                class={`px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1 ${activePath === '/boost' ? 'bg-zinc-800 text-white font-semibold' : 'text-zinc-400 hover:text-white'}`}
              >
                <span>Boost</span>
                <span class="text-[8px] px-1 py-0.2 rounded bg-amber-500/20 text-amber-400 font-bold">5x</span>
              </a>
              <a
                href="/product"
                class={`px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1 ${activePath === '/product' ? 'bg-zinc-800 text-white font-semibold' : 'text-zinc-400 hover:text-white'}`}
              >
                <span>3D Hunt</span>
                <span class="text-[8px] px-1 py-0.2 rounded bg-emerald-500/20 text-emerald-400 font-bold">3D GAME</span>
              </a>
              <a
                href="/stats"
                class={`px-3 py-1.5 rounded-lg transition-colors ${activePath === '/stats' ? 'bg-zinc-800 text-white font-semibold' : 'text-zinc-400 hover:text-white'}`}
              >
                Stats
              </a>
            </nav>

            <!-- Right Action Buttons -->
            <div class="flex items-center gap-2">
              <button
                type="button"
                class="open-add-startup-btn px-3 py-1.5 rounded-lg bg-white text-black text-xs font-semibold hover:bg-zinc-200 transition-all shadow-sm flex items-center gap-1 cursor-pointer"
              >
                <span class="text-sm font-normal leading-none">+</span>
                <span>List your space</span>
              </button>
            </div>
          </div>
        </header>
      )}

      <!-- Main Page Content -->
      <main class={`w-full ${activePath === '/' ? 'max-w-4xl px-4 sm:px-6 py-6' : 'max-w-5xl px-4 sm:px-6 py-6 pb-20 md:pb-12'}`}>
        <slot />
      </main>

      <!-- Clean Minimal Doodle District Footer -->
      <footer class="w-full border-t border-[#181a20] bg-[#090a0d] py-8 text-xs text-zinc-500 mt-auto">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-2">
            <span class="text-base">🏙️</span>
            <span class="text-zinc-300 font-bold font-mono">DOODLE DISTRICT</span>
            <span>&copy; {new Date().getFullYear()} · The 3D Scribbled City Builder &amp; Ad Marketplace</span>
          </div>

          <div class="flex flex-wrap items-center gap-3 text-zinc-500">
            <a href="/" class="text-emerald-400 hover:text-emerald-300 font-semibold transition-colors">3D Doodle City</a>
            <span>·</span>
            <a href="/browser" class="hover:text-zinc-300 transition-colors">Marketplace</a>
            <span>·</span>
            <a href="/goal" class="hover:text-zinc-300 transition-colors">Goal Planner</a>
            <span>·</span>
            <a href="/boost" class="hover:text-zinc-300 transition-colors">Boost</a>
            <span>·</span>
            <a href="/stats" class="hover:text-zinc-300 transition-colors">Stats</a>
            <span>·</span>
            <a href="https://github.com/Pavanspoojary/builtwhilebroke" class="text-zinc-600 hover:text-zinc-400 transition-colors">builtwhilebroke</a>
          </div>
        </div>
      </footer>
    </div>

    <!-- Interactive "Add Startup" Modal -->
    <div id="add-startup-modal" class="fixed inset-0 z-50 bg-black/75 backdrop-blur-xs hidden items-center justify-center p-4">
      <div class="bg-[#15161b] border border-[#272932] rounded-2xl w-full max-w-md p-6 shadow-2xl relative animate-in fade-in zoom-in duration-200">
        <button id="close-add-startup-modal" class="absolute top-4 right-4 text-zinc-400 hover:text-white p-1">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <div class="flex items-center gap-2 mb-2">
          <svg class="w-4 h-4 text-[#3b82f6] fill-current" viewBox="0 0 24 24">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          <h3 class="font-bold text-base text-white">List your developer space on TrustMRR</h3>
        </div>
        <p class="text-xs text-zinc-400 mb-5">
          Submit your developer tool, extension, or documentation space to attract tech sponsors and earn verified ad revenue.
        </p>

        <form id="add-startup-form" class="space-y-4 text-xs">
          <div>
            <label class="block font-medium text-zinc-300 mb-1">Developer Tool / Product Name</label>
            <input
              type="text"
              name="name"
              required
              placeholder="e.g. Supabase, Raycast, Bun"
              class="w-full px-3 py-2 rounded-xl bg-[#1d1f26] border border-[#2c2e3a] text-white placeholder-zinc-500 focus:outline-none focus:border-[#3b82f6]"
            />
          </div>

          <div>
            <label class="block font-medium text-zinc-300 mb-1">Website / Repo URL</label>
            <input
              type="url"
              name="url"
              required
              placeholder="https://yourproduct.dev"
              class="w-full px-3 py-2 rounded-xl bg-[#1d1f26] border border-[#2c2e3a] text-white placeholder-zinc-500 focus:outline-none focus:border-[#3b82f6]"
            />
          </div>

          <div>
            <label class="block font-medium text-zinc-300 mb-1">Placement Slot Type</label>
            <select
              name="spaceType"
              class="w-full px-3 py-2 rounded-xl bg-[#1d1f26] border border-[#2c2e3a] text-white focus:outline-none focus:border-[#3b82f6]"
            >
              <option value="Documentation">Documentation</option>
              <option value="Free-plan notices">Free-plan notices</option>
              <option value="Extension pages">Extension pages</option>
              <option value="Settings pages">Settings pages</option>
              <option value="Onboarding screens">Onboarding screens</option>
              <option value="Email footers">Email footers</option>
              <option value="Changelog pages">Changelog pages</option>
              <option value="“Powered by” areas">“Powered by” areas</option>
              <option value="Empty-state screens">Empty-state screens</option>
            </select>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block font-medium text-zinc-300 mb-1">Monthly Views / Traffic</label>
              <input
                type="number"
                name="views"
                min="100"
                required
                placeholder="50000"
                class="w-full px-3 py-2 rounded-xl bg-[#1d1f26] border border-[#2c2e3a] text-white placeholder-zinc-500 focus:outline-none focus:border-[#3b82f6]"
              />
            </div>

            <div>
              <label class="block font-medium text-zinc-300 mb-1">Sponsor Rate ($/mo)</label>
              <input
                type="number"
                name="rate"
                min="0"
                required
                placeholder="1200"
                class="w-full px-3 py-2 rounded-xl bg-[#1d1f26] border border-[#2c2e3a] text-white placeholder-zinc-500 focus:outline-none focus:border-[#3b82f6]"
              />
            </div>
          </div>

          <div>
            <label class="block font-medium text-zinc-300 mb-1">Traffic Analytics Provider</label>
            <select
              name="provider"
              class="w-full px-3 py-2 rounded-xl bg-[#1d1f26] border border-[#2c2e3a] text-white focus:outline-none focus:border-[#3b82f6]"
            >
              <option value="plausible">Plausible Analytics</option>
              <option value="google_analytics">Google Analytics (GA4)</option>
              <option value="posthog">PostHog</option>
              <option value="simpleanalytics">Simple Analytics</option>
              <option value="github">GitHub Traffic / Cloudflare Web</option>
            </select>
          </div>

          <div class="pt-1">
            <label class="flex items-center gap-2 cursor-pointer text-zinc-300">
              <input type="checkbox" id="modal-for-sale-check" class="rounded bg-zinc-800 border-zinc-700 text-blue-500 focus:ring-0" checked />
              <span>Space is available for immediate sponsorship</span>
            </label>
          </div>

          <button
            type="submit"
            class="w-full py-2.5 rounded-xl bg-white hover:bg-zinc-200 text-black font-bold text-xs transition-colors shadow-sm mt-2 cursor-pointer"
          >
            Submit Space for Verification
          </button>
        </form>

        <div id="add-startup-success" class="hidden text-center py-6">
          <div class="w-10 h-10 rounded-full bg-blue-500/20 text-[#3b82f6] flex items-center justify-center mx-auto mb-3">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <h4 class="font-bold text-sm text-white mb-1">Space Submitted!</h4>
          <p class="text-xs text-zinc-400">
            Your developer space has been queued for verification. Our review team will authenticate traffic metrics within 1 hour.
          </p>
        </div>
      </div>
    </div>

    <!-- Modal and Common Scripts -->
    <script>
      function setupModal() {
        const modal = document.getElementById('add-startup-modal');
        const openBtns = document.querySelectorAll('.open-add-startup-btn');
        const closeBtn = document.getElementById('close-add-startup-modal');
        const form = document.getElementById('add-startup-form') as HTMLFormElement | null;
        const successMsg = document.getElementById('add-startup-success');
        const forSaleCheck = document.getElementById('modal-for-sale-check') as HTMLInputElement | null;
        const askingContainer = document.getElementById('modal-asking-price-container');

        openBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            modal?.classList.remove('hidden');
            modal?.classList.add('flex');
          });
        });

        const closeModal = () => {
          modal?.classList.add('hidden');
          modal?.classList.remove('flex');
          if (form) form.reset();
          form?.classList.remove('hidden');
          successMsg?.classList.add('hidden');
        };

        closeBtn?.addEventListener('click', closeModal);
        modal?.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });

        forSaleCheck?.addEventListener('change', () => {
          if (forSaleCheck.checked) {
            askingContainer?.classList.remove('hidden');
          } else {
            askingContainer?.classList.add('hidden');
          }
        });

        form?.addEventListener('submit', (e) => {
          e.preventDefault();
          form.classList.add('hidden');
          successMsg?.classList.remove('hidden');
          setTimeout(closeModal, 2500);
        });
      }

      setupModal();
    </script>
  </body>
</html>
