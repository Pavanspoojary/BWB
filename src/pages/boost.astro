---
import TrustMrrLayout from '../layouts/TrustMrrLayout.astro';
import { BOOST_COLORS } from '../data/startups';
---

<TrustMrrLayout title="Boost Your Startup & Sponsorships | TrustMRR" description="Get in front of 200,000+ monthly tech founders, buyers, and investors. Rank higher with 5x or 20x visibility boosts, custom card colors, and side-panel sponsorships." activePath="/boost">
  
  <!-- Hero Section -->
  <div class="text-center py-6 md:py-10 max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-500 text-xs font-bold mb-3 border border-amber-500/20">
      <span>⚡ TrustMRR Growth &amp; Visibility Engine</span>
      <span>·</span>
      <span>200K+ Monthly Buyers</span>
    </div>
    <h1 class="text-3xl md:text-5xl font-extrabold text-zinc-900 dark:text-white tracking-tight mb-3">
      Boost Your Startup on TrustMRR
    </h1>
    <p class="text-sm md:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl mx-auto">
      Put your startup at the top of the leaderboard, stand out in the marketplace with verified custom card colors, and get featured directly in front of active acquirers.
    </p>
  </div>

  <!-- Main Grid: Tiers & Add-ons (Left 7 cols) & Customizer / Cart (Right 5 cols) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16">
    
    <!-- Left: Boost Tiers & Addons -->
    <div class="lg:col-span-7 space-y-8">
      
      <!-- Tier Selection Cards -->
      <div>
        <h2 class="text-base font-bold text-zinc-900 dark:text-white mb-4 flex items-center justify-between">
          <span>1. Select Visibility Package</span>
          <span class="text-xs text-zinc-500 font-normal">Choose your tier</span>
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Free Tier -->
          <div
            data-tier="free"
            data-price="0"
            class="tier-card p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-zinc-400 dark:hover:border-zinc-700 transition-all cursor-pointer relative"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="font-bold text-sm text-zinc-900 dark:text-white">Free Listing</span>
              <span class="text-xs font-mono font-bold text-zinc-500">$0</span>
            </div>
            <div class="text-[11px] text-zinc-500 mb-3">Standard visibility in directory</div>
            <ul class="space-y-1.5 text-xs text-zinc-600 dark:text-zinc-400 mb-4">
              <li class="flex items-center gap-1.5">✓ Standard ranking algorithm</li>
              <li class="flex items-center gap-1.5">✓ Stripe / Lemon Squeezy badge</li>
              <li class="flex items-center gap-1.5">✓ Public profile URL</li>
            </ul>
            <div class="tier-select-indicator text-[11px] font-bold text-zinc-400">Click to select</div>
          </div>

          <!-- Starter Tier -->
          <div
            data-tier="starter"
            data-price="29"
            class="tier-card p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-zinc-400 dark:hover:border-zinc-700 transition-all cursor-pointer relative"
          >
            <div class="flex items-center justify-between mb-2">
              <span class="font-bold text-sm text-zinc-900 dark:text-white">Starter</span>
              <span class="text-xs font-mono font-bold text-zinc-900 dark:text-white">$29</span>
            </div>
            <div class="text-[11px] text-zinc-500 mb-3">Indexed on marketplace</div>
            <ul class="space-y-1.5 text-xs text-zinc-600 dark:text-zinc-400 mb-4">
              <li class="flex items-center gap-1.5">✓ Indexed across 15+ categories</li>
              <li class="flex items-center gap-1.5">✓ Instant verification badge</li>
              <li class="flex items-center gap-1.5">✓ Founder direct message link</li>
            </ul>
            <div class="tier-select-indicator text-[11px] font-bold text-zinc-400">Click to select</div>
          </div>

          <!-- Growth Tier (Recommended) -->
          <div
            data-tier="growth"
            data-price="199"
            class="tier-card active p-5 rounded-2xl border-2 border-emerald-500 bg-emerald-500/5 dark:bg-emerald-950/20 shadow-md transition-all cursor-pointer relative"
          >
            <div class="absolute -top-3 right-4 px-2.5 py-0.5 rounded-full bg-emerald-500 text-zinc-950 font-extrabold text-[10px] tracking-wide uppercase">
              Most Popular
            </div>
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-1.5">
                <span class="font-black text-sm text-zinc-900 dark:text-white">Growth Boost</span>
                <span class="text-[10px] font-bold px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-500">5x</span>
              </div>
              <span class="text-sm font-mono font-extrabold text-emerald-500">$199</span>
            </div>
            <div class="text-[11px] text-zinc-500 mb-3">5x ranking boost + custom color</div>
            <ul class="space-y-1.5 text-xs text-zinc-700 dark:text-zinc-300 mb-4">
              <li class="flex items-center gap-1.5 font-semibold text-emerald-500">✓ 5x visibility boost in ranking</li>
              <li class="flex items-center gap-1.5 font-semibold">✓ Custom card color highlight</li>
              <li class="flex items-center gap-1.5">✓ TrustMRR Newsletter feature (35K subs)</li>
              <li class="flex items-center gap-1.5">✓ Dofollow authority backlink (DA 69)</li>
            </ul>
            <div class="tier-select-indicator text-[11px] font-bold text-emerald-500">✓ Selected Plan</div>
          </div>

          <!-- Scale Tier (Maximum Reach) -->
          <div
            data-tier="scale"
            data-price="499"
            class="tier-card p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-zinc-400 dark:hover:border-zinc-700 transition-all cursor-pointer relative"
          >
            <div class="absolute -top-3 right-4 px-2.5 py-0.5 rounded-full bg-indigo-500 text-white font-extrabold text-[10px] tracking-wide uppercase">
              Top Placement
            </div>
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-1.5">
                <span class="font-black text-sm text-zinc-900 dark:text-white">Scale Boost</span>
                <span class="text-[10px] font-bold px-1.5 py-0.2 rounded bg-indigo-500/20 text-indigo-400">20x</span>
              </div>
              <span class="text-sm font-mono font-extrabold text-indigo-400">$499</span>
            </div>
            <div class="text-[11px] text-zinc-500 mb-3">Pinned placement for 30 days</div>
            <ul class="space-y-1.5 text-xs text-zinc-600 dark:text-zinc-400 mb-4">
              <li class="flex items-center gap-1.5 font-semibold text-indigo-400">✓ 20x visibility (top of directory)</li>
              <li class="flex items-center gap-1.5 font-semibold">✓ Pinned for 30 days on marketplace</li>
              <li class="flex items-center gap-1.5">✓ Daily newsletter sponsor mention</li>
              <li class="flex items-center gap-1.5">✓ Glowing animated card border</li>
            </ul>
            <div class="tier-select-indicator text-[11px] font-bold text-zinc-400">Click to select</div>
          </div>
        </div>
      </div>

      <!-- Add-On Upgrades Section -->
      <div>
        <h2 class="text-base font-bold text-zinc-900 dark:text-white mb-4 flex items-center justify-between">
          <span>2. Supercharge with Add-Ons</span>
          <span class="text-xs text-zinc-500 font-normal">Optional performance upgrades</span>
        </h2>

        <div class="space-y-3">
          <!-- AI Visibility Boost -->
          <label class="addon-item flex items-start gap-3 p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-zinc-400 dark:hover:border-zinc-700 transition-all cursor-pointer">
            <input
              type="checkbox"
              id="addon-ai"
              data-price="79"
              class="mt-1 w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 bg-zinc-100 dark:bg-zinc-800 border-zinc-300 dark:border-zinc-700"
            />
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between mb-1">
                <span class="font-bold text-xs sm:text-sm text-zinc-900 dark:text-white">AI Visibility Boost (ChatGPT &amp; Perplexity)</span>
                <span class="font-mono font-bold text-xs text-zinc-900 dark:text-white">+$79</span>
              </div>
              <p class="text-xs text-zinc-500 leading-relaxed">
                Give ChatGPT, Claude, and AI assistants an indexed TrustMRR profile so they recognize and recommend your startup as a trusted canonical solution.
              </p>
            </div>
          </label>

          <!-- Dofollow Authority Backlink -->
          <label class="addon-item flex items-start gap-3 p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-zinc-400 dark:hover:border-zinc-700 transition-all cursor-pointer">
            <input
              type="checkbox"
              id="addon-seo"
              data-price="19"
              class="mt-1 w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 bg-zinc-100 dark:bg-zinc-800 border-zinc-300 dark:border-zinc-700"
            />
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between mb-1">
                <span class="font-bold text-xs sm:text-sm text-zinc-900 dark:text-white">Dofollow Authority Backlink (Domain Authority 69)</span>
                <span class="font-mono font-bold text-xs text-zinc-900 dark:text-white">+$19</span>
              </div>
              <p class="text-xs text-zinc-500 leading-relaxed">
                Build permanent Google SEO authority and canonical source trust from TrustMRR's high-traffic domain profile.
              </p>
            </div>
          </label>

          <!-- Side-Panel Sponsor Spot -->
          <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 space-y-3">
            <div class="flex items-start gap-3">
              <input
                type="checkbox"
                id="addon-sponsor"
                data-price="399"
                class="mt-1 w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 bg-zinc-100 dark:bg-zinc-800 border-zinc-300 dark:border-zinc-700 cursor-pointer"
              />
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-bold text-xs sm:text-sm text-zinc-900 dark:text-white">Side-Panel Sponsor Spot across TrustMRR</span>
                  <span id="sponsor-price-display" class="font-mono font-bold text-xs text-zinc-900 dark:text-white">+$399</span>
                </div>
                <p class="text-xs text-zinc-500 leading-relaxed mb-3">
                  Place your startup banner in the persistent left/right side margins on every page of TrustMRR in front of 200K+ monthly visitors.
                </p>

                <!-- Duration Selector -->
                <div class="flex items-center gap-2" id="sponsor-duration-container">
                  <span class="text-[11px] text-zinc-500 font-semibold">Duration:</span>
                  <select id="sponsor-duration-select" class="px-2.5 py-1 text-xs rounded-lg border border-zinc-300 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200 font-medium focus:outline-none focus:ring-2 focus:ring-emerald-500">
                    <option value="7" data-price="399" selected>7 days ($399)</option>
                    <option value="14" data-price="779">14 days ($779 · 3% off)</option>
                    <option value="21" data-price="1129">21 days ($1,129 · 6% off)</option>
                    <option value="28" data-price="1449">28 days ($1,449 · 9% off)</option>
                  </select>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: Live Card Color Customizer & Order Cart (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      
      <!-- Interactive Customizer & Preview Box -->
      <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-4">
        <h3 class="text-sm font-bold text-zinc-900 dark:text-white flex items-center justify-between">
          <span>Live Card Preview</span>
          <span id="preview-badge-status" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-500">
            5x BOOSTED
          </span>
        </h3>

        <!-- Interactive Color Palette -->
        <div>
          <label class="block text-xs font-semibold text-zinc-600 dark:text-zinc-400 mb-2">
            Select Custom Card Accent Color
          </label>
          <div class="grid grid-cols-6 gap-2" id="color-palette-buttons">
            {BOOST_COLORS.map((c, i) => (
              <button
                type="button"
                data-color-key={c.key}
                data-color-border={c.border}
                class={`color-btn h-9 rounded-xl border-2 transition-all flex items-center justify-center ${c.key === 'purple' ? 'border-zinc-950 dark:border-white scale-105 ring-2 ring-emerald-500/50' : 'border-transparent'}`}
                style={`background-color: ${c.border};`}
                title={c.name}
              >
                <span class={`text-[10px] font-bold ${c.key === 'purple' ? 'text-white' : 'hidden'}`}>✓</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Real-Time Startup Preview Card -->
        <div
          id="live-preview-card"
          class="p-4 rounded-2xl border-2 transition-all duration-300 bg-white dark:bg-zinc-900/90 shadow-md space-y-3"
          style="border-color: #d946ef; box-shadow: 0 4px 20px -2px #d946ef25;"
        >
          <div class="flex items-start justify-between gap-2">
            <div class="flex items-center gap-2.5">
              <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 text-zinc-950 font-bold flex items-center justify-center text-sm shadow-sm">
                S
              </div>
              <div>
                <h4 class="font-bold text-sm text-zinc-900 dark:text-white">SuperSaaS AI</h4>
                <div class="text-[10px] text-zinc-500 flex items-center gap-1.5">
                  <span>Artificial Intelligence</span>
                  <span>·</span>
                  <span class="text-emerald-500 font-semibold">Stripe Verified</span>
                </div>
              </div>
            </div>
            <span id="preview-tier-pill" class="text-[9px] font-extrabold px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
              5X VIEWS
            </span>
          </div>

          <p class="text-xs text-zinc-600 dark:text-zinc-400 line-clamp-2 leading-relaxed">
            Autonomous customer support chatbot generating revenue and capturing leads 24/7.
          </p>

          <div class="grid grid-cols-3 gap-2 py-2 px-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/40 text-center text-xs">
            <div>
              <div class="text-[9px] uppercase font-bold text-zinc-500">30d Revenue</div>
              <div class="font-mono font-bold text-zinc-900 dark:text-white text-xs mt-0.5">$8,650</div>
            </div>
            <div>
              <div class="text-[9px] uppercase font-bold text-zinc-500">MRR</div>
              <div class="font-mono font-bold text-zinc-900 dark:text-white text-xs mt-0.5">$7,900</div>
            </div>
            <div>
              <div class="text-[9px] uppercase font-bold text-zinc-500">Growth</div>
              <div class="font-mono font-bold text-emerald-500 text-xs mt-0.5">+24.5%</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Checkout Order Summary Box -->
      <div class="p-6 rounded-2xl bg-zinc-900 text-white border border-zinc-800 shadow-xl space-y-4">
        <h3 class="text-sm font-bold border-b border-zinc-800 pb-3 flex items-center justify-between">
          <span>Order Summary</span>
          <span class="text-xs text-zinc-400 font-normal">Instant Activation</span>
        </h3>

        <div class="space-y-2 text-xs" id="order-line-items">
          <div class="flex items-center justify-between text-zinc-300">
            <span id="order-tier-name">Growth Boost (5x Visibility)</span>
            <span id="order-tier-price" class="font-mono font-semibold">$199</span>
          </div>
          <div id="order-addon-ai-row" class="hidden items-center justify-between text-zinc-400">
            <span>AI Visibility Boost (ChatGPT/Perplexity)</span>
            <span class="font-mono">+$79</span>
          </div>
          <div id="order-addon-seo-row" class="hidden items-center justify-between text-zinc-400">
            <span>Dofollow Authority Backlink (DA 69)</span>
            <span class="font-mono">+$19</span>
          </div>
          <div id="order-addon-sponsor-row" class="hidden items-center justify-between text-zinc-400">
            <span id="order-sponsor-duration-label">Side-Panel Sponsor Spot (7 days)</span>
            <span id="order-sponsor-price-val" class="font-mono">+$399</span>
          </div>
        </div>

        <div class="border-t border-zinc-800 pt-3 flex items-center justify-between text-base font-bold">
          <span>Total Investment</span>
          <span id="order-total-price" class="font-mono text-emerald-400 text-xl font-extrabold">$199</span>
        </div>

        <button
          id="btn-activate-boost"
          type="button"
          class="w-full py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-black text-sm tracking-wide transition-all shadow-lg flex items-center justify-center gap-2"
        >
          <span>⚡ Activate Boost Package</span>
        </button>

        <div class="flex items-center justify-center gap-4 text-[10px] text-zinc-400 pt-1">
          <span>🔒 Encrypted Checkout</span>
          <span>·</span>
          <span>⚡ Instant Ranking Update</span>
          <span>·</span>
          <span>Receipt via Email</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Success Confirmation Celebration Modal -->
  <div id="boost-success-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden items-center justify-center p-4">
    <div class="bg-zinc-900 border border-zinc-800 text-white rounded-2xl w-full max-w-md p-6 shadow-2xl text-center space-y-4 animate-in zoom-in-95 duration-200">
      <div class="w-14 h-14 rounded-full bg-emerald-500/20 text-emerald-400 mx-auto flex items-center justify-center text-2xl font-bold">
        ⚡
      </div>
      <h3 class="text-xl font-extrabold">Boost Activated!</h3>
      <p class="text-xs text-zinc-400 leading-relaxed">
        Your startup is now prioritized in TrustMRR search algorithms with upgraded visibility and custom color styling.
      </p>
      <div class="p-3 rounded-xl bg-zinc-800/80 font-mono text-xs flex justify-between">
        <span class="text-zinc-400">Transaction ID:</span>
        <span class="text-emerald-400 font-bold">TMRR-BST-98421</span>
      </div>
      <div class="pt-2">
        <a href="/browser" class="block w-full py-2.5 rounded-xl bg-emerald-500 text-zinc-950 font-bold text-xs hover:bg-emerald-400 transition-colors">
          View in Marketplace &rarr;
        </a>
      </div>
    </div>
  </div>

  <!-- Interactive Boost Calculator Script -->
  <script>
    let selectedTier = 'growth';
    let tierPrice = 199;
    let selectedColor = '#d946ef';

    function recalculateOrder() {
      const addonAi = (document.getElementById('addon-ai') as HTMLInputElement)?.checked;
      const addonSeo = (document.getElementById('addon-seo') as HTMLInputElement)?.checked;
      const addonSponsor = (document.getElementById('addon-sponsor') as HTMLInputElement)?.checked;
      const durationSelect = document.getElementById('sponsor-duration-select') as HTMLSelectElement | null;
      
      const sponsorPrice = addonSponsor ? (parseFloat(durationSelect?.selectedOptions[0]?.getAttribute('data-price') || '399')) : 0;
      const durationDays = durationSelect?.value || '7';

      let total = tierPrice;
      if (addonAi) total += 79;
      if (addonSeo) total += 19;
      if (addonSponsor) total += sponsorPrice;

      // Update Order Summary Rows
      const aiRow = document.getElementById('order-addon-ai-row');
      const seoRow = document.getElementById('order-addon-seo-row');
      const sponsorRow = document.getElementById('order-addon-sponsor-row');
      const sponsorLabel = document.getElementById('order-sponsor-duration-label');
      const sponsorVal = document.getElementById('order-sponsor-price-val');
      const totalDisplay = document.getElementById('order-total-price');

      if (aiRow) aiRow.className = addonAi ? 'flex items-center justify-between text-zinc-400' : 'hidden';
      if (seoRow) seoRow.className = addonSeo ? 'flex items-center justify-between text-zinc-400' : 'hidden';
      if (sponsorRow) sponsorRow.className = addonSponsor ? 'flex items-center justify-between text-zinc-400' : 'hidden';
      if (sponsorLabel) sponsorLabel.textContent = `Side-Panel Sponsor Spot (${durationDays} days)`;
      if (sponsorVal) sponsorVal.textContent = `+$${sponsorPrice}`;
      if (totalDisplay) totalDisplay.textContent = `$${total}`;

      // Update Preview Card Badges
      const previewTierPill = document.getElementById('preview-tier-pill');
      const previewBadgeStatus = document.getElementById('preview-badge-status');

      if (selectedTier === 'free') {
        if (previewTierPill) previewTierPill.textContent = 'STANDARD';
        if (previewBadgeStatus) previewBadgeStatus.textContent = 'STANDARD';
      } else if (selectedTier === 'starter') {
        if (previewTierPill) previewTierPill.textContent = 'INDEXED';
        if (previewBadgeStatus) previewBadgeStatus.textContent = 'STARTER (2X)';
      } else if (selectedTier === 'growth') {
        if (previewTierPill) previewTierPill.textContent = '5X VIEWS';
        if (previewBadgeStatus) previewBadgeStatus.textContent = '5X BOOSTED';
      } else if (selectedTier === 'scale') {
        if (previewTierPill) previewTierPill.textContent = '20X TOP PIN';
        if (previewBadgeStatus) previewBadgeStatus.textContent = '20X TOP PLACEMENT';
      }
    }

    // Tier Cards Selection
    document.querySelectorAll('.tier-card').forEach((card) => {
      card.addEventListener('click', () => {
        document.querySelectorAll('.tier-card').forEach((c) => {
          c.classList.remove('border-2', 'border-emerald-500', 'bg-emerald-500/5', 'dark:bg-emerald-950/20');
          c.classList.add('border-zinc-200', 'dark:border-zinc-800');
          const ind = c.querySelector('.tier-select-indicator');
          if (ind) {
            ind.className = 'tier-select-indicator text-[11px] font-bold text-zinc-400';
            ind.textContent = 'Click to select';
          }
        });

        card.classList.remove('border-zinc-200', 'dark:border-zinc-800');
        card.classList.add('border-2', 'border-emerald-500', 'bg-emerald-500/5', 'dark:bg-emerald-950/20');
        const activeInd = card.querySelector('.tier-select-indicator');
        if (activeInd) {
          activeInd.className = 'tier-select-indicator text-[11px] font-bold text-emerald-500';
          activeInd.textContent = '✓ Selected Plan';
        }

        selectedTier = card.getAttribute('data-tier') || 'growth';
        tierPrice = parseFloat(card.getAttribute('data-price') || '0');

        const tierNameElem = document.getElementById('order-tier-name');
        const tierPriceElem = document.getElementById('order-tier-price');
        if (tierNameElem) {
          tierNameElem.textContent = selectedTier === 'free' ? 'Free Listing' : selectedTier === 'starter' ? 'Starter Listing' : selectedTier === 'growth' ? 'Growth Boost (5x Visibility)' : 'Scale Boost (20x Top Placement)';
        }
        if (tierPriceElem) {
          tierPriceElem.textContent = `$${tierPrice}`;
        }

        recalculateOrder();
      });
    });

    // Color Palette Selection
    document.querySelectorAll('.color-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.color-btn').forEach((b) => {
          b.className = 'color-btn h-9 rounded-xl border-2 transition-all flex items-center justify-center border-transparent';
          const span = b.querySelector('span');
          if (span) span.className = 'hidden';
        });

        btn.classList.add('border-zinc-950', 'dark:border-white', 'scale-105', 'ring-2', 'ring-emerald-500/50');
        const activeSpan = btn.querySelector('span');
        if (activeSpan) activeSpan.className = 'text-[10px] font-bold text-white';

        selectedColor = btn.getAttribute('data-color-border') || '#d946ef';
        const liveCard = document.getElementById('live-preview-card');
        if (liveCard) {
          liveCard.style.borderColor = selectedColor;
          liveCard.style.boxShadow = `0 4px 20px -2px ${selectedColor}25`;
        }
      });
    });

    // Addons Listeners
    document.getElementById('addon-ai')?.addEventListener('change', recalculateOrder);
    document.getElementById('addon-seo')?.addEventListener('change', recalculateOrder);
    document.getElementById('addon-sponsor')?.addEventListener('change', recalculateOrder);
    document.getElementById('sponsor-duration-select')?.addEventListener('change', (e) => {
      const opt = (e.target as HTMLSelectElement).selectedOptions[0];
      const p = opt.getAttribute('data-price') || '399';
      const disp = document.getElementById('sponsor-price-display');
      if (disp) disp.textContent = `+$${p}`;
      recalculateOrder();
    });

    // Activate Button & Modal
    const activateBtn = document.getElementById('btn-activate-boost');
    const successModal = document.getElementById('boost-success-modal');

    activateBtn?.addEventListener('click', () => {
      successModal?.classList.remove('hidden');
      successModal?.classList.add('flex');
    });

    successModal?.addEventListener('click', (e) => {
      if (e.target === successModal) {
        successModal.classList.add('hidden');
        successModal.classList.remove('flex');
      }
    });

    // Initialize
    recalculateOrder();
  </script>
</TrustMrrLayout>
