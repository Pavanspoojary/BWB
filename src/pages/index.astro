---
import '@astrojs/tailwind/base.css';

const title = "builtwhilebroke.tech // Sticky Note Board";
const description = "Pin your product to the wall. $2 per sticky note. Drag it anywhere.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23faf7ee' stroke='%231a30c0' stroke-width='2'/><path d='M6 8h20M6 14h20M6 20h20M6 26h20' stroke='%231a30c0' stroke-opacity='0.25' stroke-width='1.5'/><circle cx='10' cy='6' r='2' fill='%23d02030'/></svg>" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7ee" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Caveat:wght@600;700&family=Kalam:wght@700&family=Patrick+Hand&family=Plus+Jakarta+Sans:wght@500;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --paper-bg: #faf7ee;
        --ink-blue: #1a30c0;
        --ink-red: #d02030;
      }

      html, body {
        width: 100vw;
        height: 100vh;
        margin: 0;
        padding: 0;
        overflow: hidden;
        position: fixed;
        inset: 0;
        overscroll-behavior: none;
        touch-action: none;
      }

      body {
        font-family: 'Patrick Hand', cursive, sans-serif;
        background-color: #faf7ee;
        background-image:
          linear-gradient(90deg, transparent 79px, rgba(208,32,48,.55) 79px, rgba(208,32,48,.55) 81px, transparent 81px),
          linear-gradient(rgba(26,48,192,.10) 1px, transparent 1px);
        background-size: 100% 100%, 100% 28px;
        background-attachment: fixed;
        color: #1a30c0;
      }

      /* Sticky note styles */
      .sticky-note {
        position: absolute;
        width: 220px;
        min-height: 180px;
        padding: 16px 14px 14px;
        border-radius: 2px;
        box-shadow: 3px 3px 10px rgba(0,0,0,.18), 0 0 1px rgba(0,0,0,.1);
        cursor: default;
        z-index: 50;
        transition: box-shadow 0.15s, outline 0.15s;
        user-select: none;
        transform: rotate(var(--tilt, -2deg));
      }
      .sticky-note.is-owned {
        cursor: grab;
        outline: 2px dashed rgba(26, 48, 192, 0.4);
        outline-offset: 2px;
      }
      .sticky-note.is-owned:active {
        cursor: grabbing;
        box-shadow: 6px 6px 18px rgba(0,0,0,.25);
        z-index: 99;
      }
      .sticky-owner-badge {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 0.04em;
        color: #1a30c0;
        background: rgba(26, 48, 192, 0.1);
        border: 1px dashed #1a30c0;
        padding: 1px 5px;
        border-radius: 4px;
        margin-bottom: 4px;
      }
      .sticky-note .sticky-title {
        font-family: 'Caveat', cursive;
        font-size: 20px;
        font-weight: 700;
        line-height: 1.15;
        margin-bottom: 6px;
        color: #1a30c0;
        word-break: break-word;
      }
      .sticky-note .sticky-tagline {
        font-size: 13px;
        color: #1a30c0cc;
        line-height: 1.3;
        margin-bottom: 8px;
        word-break: break-word;
      }
      .sticky-note .sticky-maker {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: #1a30c088;
      }
      .sticky-note .sticky-url {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        color: #059669;
        text-decoration: underline;
        word-break: break-all;
      }
      .sticky-note .sticky-vote {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid #1a30c0;
        background: rgba(255,255,255,.7);
        color: #1a30c0;
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.1s;
      }
      .sticky-note .sticky-vote:hover { background: #d02030; color: #fff; border-color: #d02030; }
      .sticky-note .sticky-vote.voted { background: #d02030; color: #fff; border-color: #d02030; }
      .sticky-note .sticky-close {
        position: absolute;
        bottom: 6px;
        right: 8px;
        font-size: 14px;
        color: #1a30c066;
        cursor: pointer;
        border: none;
        background: none;
        padding: 2px;
      }
      .sticky-note .sticky-close:hover { color: #d02030; }

      .sticky-yellow { background: #fef3c7; border: 1.5px solid #d97706; }
      .sticky-pink { background: #fce7f3; border: 1.5px solid #db2777; }
      .sticky-blue { background: #dbeafe; border: 1.5px solid #2563eb; }
      .sticky-green { background: #d1fae5; border: 1.5px solid #059669; }
      .sticky-purple { background: #ede9fe; border: 1.5px solid #7c3aed; }
      .sticky-orange { background: #ffedd5; border: 1.5px solid #ea580c; }

      /* Buy button */
      .buy-btn {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 60;
        padding: 14px 24px;
        border-radius: 16px;
        background: #fef3c7;
        border: 3px solid #d97706;
        color: #92400e;
        font-family: 'Patrick Hand', cursive, sans-serif;
        font-size: 18px;
        font-weight: 900;
        cursor: pointer;
        box-shadow: 4px 4px 0 0 #92400e;
        transition: all 0.15s;
      }
      .buy-btn:hover {
        background: #fde68a;
        transform: translate(2px, 2px);
        box-shadow: 2px 2px 0 0 #92400e;
      }
    </style>
  </head>
  <body>

    <!-- Top Floating Toolbar -->
    <header class="fixed top-3 left-4 right-4 z-50 pointer-events-none flex items-center justify-between gap-3">
      <div class="pointer-events-auto flex items-center gap-2 bg-[#faf7ee]/95 backdrop-blur-md px-3.5 py-2 rounded-2xl border-2 border-[#1a30c0] shadow-[3px_3px_0_0_#1a30c0]">
        <span class="text-xl">📌</span>
        <span class="font-black text-sm tracking-wide">STICKY WALL</span>
        <span class="text-xs px-2 py-0.5 rounded-full bg-[#1a30c0] text-[#faf7ee] font-mono2 font-bold" id="note-count-badge">0 notes</span>
        <span class="text-xs text-[#059669] font-bold font-mono2 hidden sm:inline" id="wall-value-badge">$0 wall value</span>
      </div>

      <!-- Top Right Actions Removed -->
    </header>

    <!-- Bottom Left Interaction Tip -->
    <div class="fixed bottom-4 left-4 z-40 pointer-events-none bg-[#faf7ee]/95 backdrop-blur px-3 py-1.5 rounded-xl border border-[#1a30c0]/30 text-xs text-[#1a30c0]/75 font-mono2 shadow-sm hidden sm:block">
      💡 You can drag &amp; move your own sticky notes · Click any note to bring to top
    </div>

    <!-- Canvas Wrapper - Fixed Full Screen -->
    <div id="board-canvas" class="fixed inset-0 w-full h-full overflow-hidden">
      <!-- Sticky notes layer -->
      <div id="sticky-layer" class="absolute inset-0 w-full h-full overflow-hidden"></div>
    </div>

    <!-- Buy sticky note button -->
    <button id="btn-buy-sticky" class="buy-btn" type="button">📌 Get a Sticky Note — $2</button>

    <!-- Sticky Note Purchase Modal -->
    <div id="sticky-modal" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="w-full max-w-md bg-[#fef3c7] border-2 border-[#d97706] rounded-[20px] p-6 shadow-2xl relative font-[Patrick_Hand,cursive] rotate-1">
        <button id="btn-close-sticky" type="button" class="absolute top-3 right-3 text-xl font-bold text-[#92400e] hover:text-[#d02030] cursor-pointer">✕</button>
        <div class="text-center mb-4">
          <div class="text-4xl mb-1">📌</div>
          <h3 class="text-2xl font-black text-[#92400e]">Get a Sticky Note</h3>
          <p class="text-sm text-[#92400e]/70">$2 one-time · place it anywhere on the board</p>
        </div>

        <!-- Rule Engine Moderation Error Box -->
        <div id="sticky-error-box" class="hidden mb-3 p-3 rounded-xl bg-[#fee2e2] border-2 border-[#ef4444] text-[#b91c1c] text-xs font-bold font-mono2 space-y-1">
          <div class="flex items-center gap-1.5 text-sm font-black text-[#991b1b]">
            <span>⚠️</span>
            <span>Submission Not Allowed</span>
          </div>
          <ul id="sticky-error-list" class="list-disc list-inside space-y-0.5 text-[11px] leading-relaxed"></ul>
        </div>

        <div class="space-y-3">
          <div>
            <label class="block text-sm font-bold mb-1 text-[#92400e]" for="sticky-name">Product name *</label>
            <input id="sticky-name" required maxlength="40" placeholder="e.g. ShipLog" class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#d97706] text-[#92400e] placeholder-[#92400e]/40 text-base font-bold focus:outline-none focus:border-[#d02030]" />
          </div>
          <div>
            <label class="block text-sm font-bold mb-1 text-[#92400e]" for="sticky-tagline">One-line pitch *</label>
            <input id="sticky-tagline" required maxlength="80" placeholder="e.g. Changelog-as-a-service" class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#d97706] text-[#92400e] placeholder-[#92400e]/40 text-base focus:outline-none focus:border-[#d02030]" />
          </div>
          <div>
            <label class="block text-sm font-bold mb-1 text-[#92400e]" for="sticky-url">Website (optional)</label>
            <input id="sticky-url" type="url" maxlength="120" placeholder="https://yourproduct.com" class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#d97706] text-[#92400e] placeholder-[#92400e]/40 text-base focus:outline-none focus:border-[#d02030]" />
          </div>
          <div>
            <label class="block text-sm font-bold mb-1 text-[#92400e]" for="sticky-maker">Maker handle</label>
            <input id="sticky-maker" maxlength="30" placeholder="@you" class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#d97706] text-[#92400e] placeholder-[#92400e]/40 text-base focus:outline-none focus:border-[#d02030]" />
          </div>
          <button id="btn-confirm-sticky" class="w-full mt-2 py-3 rounded-2xl bg-[#d97706] hover:bg-[#b45309] text-white font-black text-lg transition-all shadow-[0_4px_0_0_#92400e] hover:shadow-[0_2px_0_0_#92400e] hover:translate-y-[2px] cursor-pointer -rotate-1">
            📌 PAY $2 &amp; STICK IT
          </button>
        </div>
        <p class="text-[11px] text-[#92400e]/50 mt-2 text-center font-mono2">Stripe checkout · secure payment</p>
      </div>
    </div>

  <script>
    import { moderateStickyNote } from "../lib/moderationEngine";

    const STICKY_NOTES_KEY = "bwb_sticky_notes";
    const USER_ID_KEY = "bwb_user_id";
    const MY_NOTES_KEY = "bwb_my_notes";
    const STICKY_COLORS = ["sticky-yellow", "sticky-pink", "sticky-blue", "sticky-green", "sticky-purple", "sticky-orange"];

    interface StickyNote {
      id: string;
      name: string;
      tagline: string;
      url: string;
      maker: string;
      color: string;
      x: number;
      y: number;
      tilt: number;
      votes: number;
      userId?: string;
    }

    function getUserId(): string {
      try {
        let uid = localStorage.getItem(USER_ID_KEY);
        if (!uid) {
          uid = "user-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 8);
          localStorage.setItem(USER_ID_KEY, uid);
        }
        return uid;
      } catch {
        return "session-user";
      }
    }

    function getMyNoteIds(): string[] {
      return loadJSON(MY_NOTES_KEY, []) as string[];
    }

    function addMyNoteId(id: string): void {
      const ids = getMyNoteIds();
      if (!ids.includes(id)) {
        ids.push(id);
        saveJSON(MY_NOTES_KEY, ids);
      }
    }

    function removeMyNoteId(id: string): void {
      const ids = getMyNoteIds().filter((x) => x !== id);
      saveJSON(MY_NOTES_KEY, ids);
    }

    function isMyNote(note: StickyNote): boolean {
      const myUid = getUserId();
      const myIds = getMyNoteIds();
      return (Boolean(note.userId) && note.userId === myUid) || myIds.includes(note.id);
    }

    let highestZ = 100;

    function loadJSON(key: string, fallback: any): any {
      try {
        const raw = localStorage.getItem(key);
        return raw ? JSON.parse(raw) : fallback;
      } catch {
        return fallback;
      }
    }
    function saveJSON(key: string, val: any): void {
      try { localStorage.setItem(key, JSON.stringify(val)); } catch { /* private mode */ }
    }
    function esc(s: string | number | undefined): string {
      return String(s ?? "").replace(/[&<>"']/g, (c: string) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string));
    }

    function loadStickyNotes(): StickyNote[] {
      const stored = loadJSON(STICKY_NOTES_KEY, null) as StickyNote[] | null;
      if (!stored) {
        return [];
      }
      // Purge any legacy seed notes so the user's board is completely clean
      const userOnly = stored.filter((n) => !n.id.startsWith("seed-"));
      if (userOnly.length !== stored.length) {
        saveStickyNotes(userOnly);
      }
      return userOnly;
    }

    function saveStickyNotes(notes: StickyNote[]): void {
      saveJSON(STICKY_NOTES_KEY, notes);
    }

    function renderStickyNotes() {
      const layer = document.getElementById("sticky-layer");
      if (!layer) return;
      layer.innerHTML = "";
      const notes = loadStickyNotes();

      const badge = document.getElementById("note-count-badge");
      if (badge) badge.textContent = `${notes.length} note${notes.length === 1 ? '' : 's'}`;

      const valBadge = document.getElementById("wall-value-badge");
      if (valBadge) valBadge.textContent = `$${notes.length * 2} wall value`;

      if (notes.length === 0) {
        const emptyEl = document.createElement("div");
        emptyEl.className = "absolute inset-0 flex flex-col items-center justify-center pointer-events-none text-center p-6";
        emptyEl.innerHTML = `
          <div class="max-w-md p-8 rounded-3xl bg-[#faf7ee]/90 border-2 border-dashed border-[#1a30c0]/30 shadow-lg -rotate-1 pointer-events-auto">
            <div class="text-5xl mb-3">📌</div>
            <h2 class="text-2xl font-black text-[#1a30c0] mb-2 font-[Patrick_Hand,cursive]">The Wall is Fresh &amp; Clean</h2>
            <p class="text-base text-[#1a30c0]/75 mb-4 font-[Patrick_Hand,cursive]">All 50 seed notes have been removed. Place your own sticky notes anywhere on the board for $2.</p>
            <button id="btn-empty-add" type="button" class="px-5 py-2.5 rounded-2xl bg-[#d97706] hover:bg-[#b45309] text-white font-black text-base shadow-[0_3px_0_0_#92400e] cursor-pointer transition-all -rotate-1">
              📌 Get a Sticky Note — $2
            </button>
          </div>
        `;
        layer.appendChild(emptyEl);
        document.getElementById("btn-empty-add")?.addEventListener("click", () => {
          document.getElementById("sticky-modal")?.classList.remove("hidden");
        });
        return;
      }

      notes.forEach((note) => {
        const isOwned = isMyNote(note);
        const el = document.createElement("div");
        el.className = `sticky-note ${isOwned ? "is-owned" : "is-readonly"} ${note.color}`;
        el.style.left = `${note.x}px`;
        el.style.top = `${note.y}px`;
        el.style.setProperty("--tilt", `${note.tilt}deg`);
        el.dataset.id = note.id;

        const votedKey = "bwb_sticky_votes_" + note.id;
        const hasVoted = loadJSON(votedKey, false) as boolean;

        const rawUrl = note.url?.trim() ?? "";
        const href = rawUrl ? (/^https?:\/\//i.test(rawUrl) ? rawUrl : `https://${rawUrl}`) : "";

        const ownerBadge = isOwned
          ? `<div class="sticky-owner-badge" title="You placed this note — you can drag & move it"><span>👤</span> YOUR NOTE</div>`
          : "";

        const closeBtn = isOwned
          ? `<button class="sticky-close" data-sticky-close="${note.id}" title="Remove your note">✕</button>`
          : "";

        el.innerHTML =
          ownerBadge +
          `<button class="sticky-vote ${hasVoted ? "voted" : ""}" data-sticky-vote="${note.id}" title="${hasVoted ? "Remove upvote" : "Upvote"}">▲</button>` +
          `<div class="sticky-title">${esc(note.name)}</div>` +
          `<div class="sticky-tagline">${esc(note.tagline)}</div>` +
          (href ? `<a class="sticky-url" href="${esc(href)}" target="_blank" rel="noopener noreferrer">${esc(rawUrl.replace(/^https?:\/\/(www\.)?/, ''))}</a>` : "") +
          `<div class="sticky-maker">${esc(note.maker || "@anon")}</div>` +
          closeBtn;

        layer.appendChild(el);

        if (isOwned) {
          makeDraggable(el, note);
        } else {
          // Non-owned notes cannot be dragged or moved, but clicking brings to front
          el.addEventListener("mousedown", () => {
            highestZ++;
            el.style.zIndex = String(highestZ);
          });
          el.addEventListener("touchstart", () => {
            highestZ++;
            el.style.zIndex = String(highestZ);
          }, { passive: true });
        }
      });

      layer.querySelectorAll("[data-sticky-vote]").forEach((btn) => {
        btn.addEventListener("click", (ev) => {
          ev.stopPropagation();
          const id = btn.getAttribute("data-sticky-vote")!;
          const votedKey = "bwb_sticky_votes_" + id;
          const hasVoted = loadJSON(votedKey, false) as boolean;
          saveJSON(votedKey, !hasVoted);
          const notes = loadStickyNotes();
          const n = notes.find((x) => x.id === id);
          if (n) {
            n.votes = Math.max(0, (n.votes || 0) + (hasVoted ? -1 : 1));
            saveStickyNotes(notes);
          }
          renderStickyNotes();
        });
      });

      layer.querySelectorAll("[data-sticky-close]").forEach((btn) => {
        btn.addEventListener("click", (ev) => {
          ev.stopPropagation();
          const id = btn.getAttribute("data-sticky-close")!;
          removeMyNoteId(id);
          const notes = loadStickyNotes().filter((x) => x.id !== id);
          saveStickyNotes(notes);
          renderStickyNotes();
        });
      });
    }

    function makeDraggable(el: HTMLElement, note: StickyNote) {
      let startX = 0, startY = 0, origX = 0, origY = 0;

      const onMove = (ev: MouseEvent | TouchEvent) => {
        const clientX = "touches" in ev ? ev.touches[0].clientX : ev.clientX;
        const clientY = "touches" in ev ? ev.touches[0].clientY : ev.clientY;
        const maxX = Math.max(10, window.innerWidth - 230);
        const maxY = Math.max(50, window.innerHeight - 190);
        const newX = Math.max(10, Math.min(maxX, origX + (clientX - startX)));
        const newY = Math.max(50, Math.min(maxY, origY + (clientY - startY)));
        el.style.left = `${newX}px`;
        el.style.top = `${newY}px`;
      };

      const onUp = (ev: MouseEvent | TouchEvent) => {
        document.removeEventListener("mousemove", onMove);
        document.removeEventListener("mouseup", onUp);
        document.removeEventListener("touchmove", onMove);
        document.removeEventListener("touchend", onUp);
        const clientX = "changedTouches" in ev ? ev.changedTouches[0].clientX : (ev as MouseEvent).clientX;
        const clientY = "changedTouches" in ev ? ev.changedTouches[0].clientY : (ev as MouseEvent).clientY;
        const maxX = Math.max(10, window.innerWidth - 230);
        const maxY = Math.max(50, window.innerHeight - 190);
        note.x = Math.max(10, Math.min(maxX, origX + (clientX - startX)));
        note.y = Math.max(50, Math.min(maxY, origY + (clientY - startY)));
        const notes = loadStickyNotes();
        const n = notes.find((x) => x.id === note.id);
        if (n) { n.x = note.x; n.y = note.y; saveStickyNotes(notes); }
      };

      const onDown = (ev: MouseEvent | TouchEvent) => {
        ev.stopPropagation();
        highestZ++;
        el.style.zIndex = String(highestZ);

        const clientX = "touches" in ev ? ev.touches[0].clientX : ev.clientX;
        const clientY = "touches" in ev ? ev.touches[0].clientY : ev.clientY;
        startX = clientX;
        startY = clientY;
        origX = parseInt(el.style.left) || 0;
        origY = parseInt(el.style.top) || 0;
        document.addEventListener("mousemove", onMove);
        document.addEventListener("mouseup", onUp);
        document.addEventListener("touchmove", onMove, { passive: false });
        document.addEventListener("touchend", onUp);
      };

      el.addEventListener("mousedown", onDown);
      el.addEventListener("touchstart", onDown, { passive: false });
    }

    // Prevent moving or scrolling the background page in any direction
    window.addEventListener("wheel", (e) => {
      if ((e.target as HTMLElement)?.closest("#sticky-modal")) return;
      e.preventDefault();
    }, { passive: false });

    window.addEventListener("touchmove", (e) => {
      if ((e.target as HTMLElement)?.closest("#sticky-modal")) return;
      e.preventDefault();
    }, { passive: false });

    function bootStickyModal() {
      const modal = document.getElementById("sticky-modal");
      const btnOpen = document.getElementById("btn-buy-sticky");
      const btnClose = document.getElementById("btn-close-sticky");
      const btnConfirm = document.getElementById("btn-confirm-sticky");
      const errBox = document.getElementById("sticky-error-box");
      const errList = document.getElementById("sticky-error-list");

      const nameInput = document.getElementById("sticky-name") as HTMLInputElement;
      const taglineInput = document.getElementById("sticky-tagline") as HTMLInputElement;
      const urlInput = document.getElementById("sticky-url") as HTMLInputElement;
      const makerInput = document.getElementById("sticky-maker") as HTMLInputElement;

      function clearErrors() {
        if (errBox) errBox.classList.add("hidden");
        if (errList) errList.innerHTML = "";
        [nameInput, taglineInput, urlInput, makerInput].forEach((input) => {
          if (input) {
            input.classList.remove("border-[#ef4444]", "bg-red-50/70");
            input.classList.add("border-[#d97706]", "bg-white");
          }
        });
      }

      function showErrors(violations: { field: string; message: string }[]) {
        if (!errBox || !errList) return;
        errList.innerHTML = violations.map((v) => `<li>${esc(v.message)}</li>`).join("");
        errBox.classList.remove("hidden");

        const fieldMap: Record<string, HTMLInputElement | null> = {
          name: nameInput,
          tagline: taglineInput,
          url: urlInput,
          maker: makerInput,
        };

        violations.forEach((v) => {
          const input = fieldMap[v.field];
          if (input) {
            input.classList.remove("border-[#d97706]", "bg-white");
            input.classList.add("border-[#ef4444]", "bg-red-50/70");
          }
        });
      }

      [nameInput, taglineInput, urlInput, makerInput].forEach((input) => {
        input?.addEventListener("input", () => {
          input.classList.remove("border-[#ef4444]", "bg-red-50/70");
          input.classList.add("border-[#d97706]", "bg-white");
          if (errBox && !errBox.classList.contains("hidden")) {
            const allClean = [nameInput, taglineInput, urlInput, makerInput].every(
              (el) => !el?.classList.contains("border-[#ef4444]")
            );
            if (allClean) errBox.classList.add("hidden");
          }
        });
      });

      btnOpen?.addEventListener("click", () => {
        clearErrors();
        modal?.classList.remove("hidden");
      });
      btnClose?.addEventListener("click", () => {
        clearErrors();
        modal?.classList.add("hidden");
      });
      modal?.addEventListener("click", (e) => {
        if (e.target === modal) {
          clearErrors();
          modal.classList.add("hidden");
        }
      });

      btnConfirm?.addEventListener("click", () => {
        clearErrors();
        const name = nameInput?.value.trim() || "";
        const tagline = taglineInput?.value.trim() || "";
        const url = urlInput?.value.trim() || "";
        const maker = makerInput?.value.trim() || "";

        // Run Rule-Based Moderation Engine
        const mod = moderateStickyNote({ name, tagline, url, maker });
        if (!mod.valid) {
          showErrors(mod.violations);
          return;
        }

        const notes = loadStickyNotes();
        const color = STICKY_COLORS[notes.length % STICKY_COLORS.length];
        const tilt = -4 + Math.random() * 8;
        const maxX = Math.max(100, window.innerWidth - 240);
        const maxY = Math.max(80, window.innerHeight - 200);
        const x = Math.round(90 + Math.random() * (maxX - 90));
        const y = Math.round(70 + Math.random() * (maxY - 70));

        const finalUrl = url ? (/^https?:\/\//i.test(url) ? url : `https://${url}`) : "";
        const finalMaker = maker ? (maker.startsWith("@") ? maker : `@${maker}`) : "@anon";

        const myUid = getUserId();
        const newNoteId = "sticky-" + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
        addMyNoteId(newNoteId);

        notes.unshift({
          id: newNoteId,
          name,
          tagline,
          url: finalUrl,
          maker: finalMaker,
          color,
          x,
          y,
          tilt,
          votes: 0,
          userId: myUid,
        });
        saveStickyNotes(notes);
        renderStickyNotes();
        modal?.classList.add("hidden");
        clearErrors();
        if (nameInput) nameInput.value = "";
        if (taglineInput) taglineInput.value = "";
        if (urlInput) urlInput.value = "";
        if (makerInput) makerInput.value = "";
      });

      window.addEventListener("keydown", (e) => {
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === "input" || tag === "textarea") return;
        if (e.key === "n" || e.key === "N") {
          clearErrors();
          modal?.classList.remove("hidden");
        } else if (e.key === "Escape") {
          clearErrors();
          modal?.classList.add("hidden");
        }
      });
    }

    bootStickyModal();
    renderStickyNotes();
  </script>
  </body>
</html>
