---
import TrustMrrLayout from '../layouts/TrustMrrLayout.astro';
import { STARTUPS, CATEGORIES, formatCurrency, formatExactCurrency, formatGrowth } from '../data/startups';
import { getCollection } from 'astro:content';
import BurnCalculator from '../components/BurnCalculator.astro';
import HackCatalog from '../components/HackCatalog.astro';
import { SEED_HACKS } from '../components/seedData';

let collectionEntries: any[] = [];
try {
  collectionEntries = await getCollection('hacks');
} catch (e) {
  collectionEntries = [];
}

const hacks = collectionEntries && collectionEntries.length > 0
  ? collectionEntries
  : SEED_HACKS;

// Top Startups for Leaderboard
const topRevenueStartups = [...STARTUPS].sort((a, b) => b.verifiedRevenue30d - a.verifiedRevenue30d);
const topMrrStartups = [...STARTUPS].sort((a, b) => b.mrr - a.mrr);
const topGrowthStartups = [...STARTUPS].sort((a, b) => b.revenueGrowth30d - a.revenueGrowth30d);
const forSaleStartups = STARTUPS.filter((s) => s.forSale);
---

<TrustMrrLayout title="TrustMRR - Buy and Sell SaaS Startups | Verified Startup Revenue Database" activePath="/">
  
  <!-- Hero Section -->
  <section class="text-center pt-8 pb-10 md:pt-14 md:pb-12 max-w-3xl mx-auto">
    <!-- TrustMRR Brand Badge -->
    <div class="inline-flex items-center gap-2 mb-4 md:mb-6">
      <div class="w-6 h-6 rounded-lg bg-emerald-500 flex items-center justify-center text-zinc-950 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </div>
      <span class="text-sm md:text-base font-bold text-zinc-600 dark:text-zinc-400">TrustMRR</span>
    </div>

    <!-- H1 Headline -->
    <h1 class="font-black text-3xl sm:text-5xl md:text-6xl text-zinc-900 dark:text-white tracking-tight leading-tight mb-4">
      The database of verified startup revenues
    </h1>

    <!-- Subtitle -->
    <p class="text-sm md:text-base text-zinc-600 dark:text-zinc-400 mb-8 max-w-2xl mx-auto leading-relaxed">
      200K monthly visitors browse SaaS, mobile apps, and digital businesses for acquisition on TrustMRR.
      <a href="/browser" class="underline underline-offset-4 text-emerald-600 dark:text-emerald-400 font-semibold hover:text-emerald-500 transition-colors">
        Explore the marketplace &rarr;
      </a>
    </p>

    <!-- Search Input & CTA Button Group -->
    <div class="flex flex-col sm:flex-row items-stretch justify-center gap-3 max-w-lg mx-auto mb-6">
      <form action="/browser" method="get" class="relative flex-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-zinc-400 absolute left-3.5 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          name="q"
          placeholder='"SaaS over $10K/mo"'
          class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-zinc-300 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-zinc-900 dark:text-white"
        />
      </form>

      <button
        type="button"
        id="hero-add-startup-btn"
        class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm transition-all shadow-md flex items-center justify-center gap-1.5 shrink-0"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span>Add startup</span>
      </button>
    </div>

    <!-- Quick Navigation Links -->
    <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1.5 text-xs text-zinc-500 dark:text-zinc-400">
      <a href="/browser" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Marketplace</a>
      <span>·</span>
      <a href="/goal" class="hover:text-zinc-900 dark:hover:text-white transition-colors">MRR Goal Tracker</a>
      <span>·</span>
      <a href="/boost" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Boost Visibility</a>
      <span>·</span>
      <a href="/stats" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Market Stats</a>
      <span>·</span>
      <a href="#builtwhilebroke-section" class="hover:text-zinc-900 dark:hover:text-white transition-colors font-mono font-semibold text-emerald-500">
        builtwhilebroke.tech
      </a>
    </div>
  </section>

  <!-- Recently Listed Carousel Section -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-4 px-1">
      <div class="flex items-center gap-2">
        <h2 class="text-sm font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider">Recently listed</h2>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-500">New Startups</span>
      </div>
      <a href="/browser?status=forSale" class="text-xs font-semibold text-zinc-500 hover:text-zinc-900 dark:hover:text-white flex items-center gap-1 transition-colors">
        <span>View all</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor">
          <path fill-rule="evenodd" d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>

    <!-- Horizontal Scrolling Strip -->
    <div class="flex gap-3.5 overflow-x-auto pb-4 scrollbar-none snap-x">
      {forSaleStartups.slice(0, 6).map((startup) => (
        <a
          href={`/startup/${startup.slug}`}
          class="snap-start flex flex-col justify-between border border-zinc-200 dark:border-zinc-800 rounded-2xl p-4 hover:border-emerald-500/40 bg-white dark:bg-zinc-900/80 transition-all cursor-pointer group shrink-0 w-[240px] shadow-sm relative overflow-hidden"
        >
          <div class="absolute top-0 right-0 bg-amber-500/10 text-amber-600 dark:text-amber-400 text-[9px] font-extrabold px-2 py-0.5 rounded-bl-lg border-b border-l border-amber-500/20">
            FOR SALE
          </div>

          <div class="flex items-center gap-2.5 mb-3 mt-1">
            <img
              src={startup.logo}
              alt={startup.name}
              class="w-9 h-9 rounded-xl object-cover border border-zinc-200 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800 shrink-0"
              onerror="this.src='data:image/svg+xml,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 36 36\'><rect width=\'36\' height=\'36\' fill=\'%2327272a\'/><text x=\'18\' y=\'23\' font-size=\'16\' font-weight=\'bold\' fill=\'%2310b981\' text-anchor=\'middle\'>S</text></svg>'"
            />
            <div class="min-w-0">
              <h3 class="font-bold text-sm text-zinc-900 dark:text-white truncate group-hover:text-emerald-500 transition-colors">
                {startup.name}
              </h3>
              <p class="text-[10px] text-zinc-500 truncate">{startup.category}</p>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-1.5 py-2 px-2.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/40 border border-zinc-100 dark:border-zinc-800/60 text-center font-mono">
            <div>
              <div class="text-[8px] uppercase tracking-wider text-zinc-400 font-bold">Revenue</div>
              <div class="text-[11px] font-bold text-zinc-900 dark:text-white mt-0.5 truncate">{formatCurrency(startup.verifiedRevenue30d)}</div>
            </div>
            <div>
              <div class="text-[8px] uppercase tracking-wider text-zinc-400 font-bold">Multiple</div>
              <div class="text-[11px] font-bold text-zinc-900 dark:text-white mt-0.5">{startup.profitMultiple ? `${startup.profitMultiple}x` : 'N/A'}</div>
            </div>
            <div>
              <div class="text-[8px] uppercase tracking-wider text-zinc-400 font-bold">Price</div>
              <div class="text-[11px] font-bold text-emerald-500 mt-0.5 truncate">{startup.askingPrice ? formatCurrency(startup.askingPrice) : 'Offer'}</div>
            </div>
          </div>
        </a>
      ))}

      <!-- Browse All Startups Link Tile -->
      <a
        href="/browser"
        class="snap-start flex flex-col justify-center items-center border-2 border-dashed border-zinc-300 dark:border-zinc-800 rounded-2xl p-6 hover:border-emerald-500/50 hover:bg-zinc-50 dark:hover:bg-zinc-900/50 transition-all cursor-pointer shrink-0 w-[240px] text-center group"
      >
        <div class="w-10 h-10 rounded-full bg-emerald-500/10 text-emerald-500 flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </div>
        <span class="text-xs font-bold text-zinc-900 dark:text-white group-hover:text-emerald-500">
          Browse all startups<br />on the marketplace
        </span>
      </a>
    </div>
  </section>

  <!-- Best Deals this Week Carousel Section -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-4 px-1">
      <div class="flex items-center gap-2">
        <h2 class="text-sm font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider">Best deals this week</h2>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-500">High Growth</span>
      </div>
      <a href="/browser?status=forSale" class="text-xs font-semibold text-zinc-500 hover:text-zinc-900 dark:hover:text-white flex items-center gap-1 transition-colors">
        <span>View all</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor">
          <path fill-rule="evenodd" d="M6.22 4.22a.75.75 0 0 1 1.06 0l3.25 3.25a.75.75 0 0 1 0 1.06l-3.25 3.25a.75.75 0 0 1-1.06-1.06L8.94 8 6.22 5.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      {topGrowthStartups.filter(s => s.forSale).slice(0, 3).map((startup) => (
        <a
          href={`/startup/${startup.slug}`}
          class="p-4 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-emerald-500/40 transition-all group shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">{startup.category}</span>
              <span class="text-[10px] font-mono font-bold text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded-full">
                {formatGrowth(startup.revenueGrowth30d)} growth
              </span>
            </div>
            <div class="flex items-center gap-2.5 mb-2">
              <img src={startup.logo} alt={startup.name} class="w-8 h-8 rounded-lg object-cover bg-zinc-800 shrink-0" onerror="this.src='data:image/svg+xml,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 32 32\'><rect width=\'32\' height=\'32\' fill=\'%2327272a\'/></svg>'" />
              <div class="font-bold text-sm text-zinc-900 dark:text-white truncate group-hover:text-emerald-500">{startup.name}</div>
            </div>
            <p class="text-xs text-zinc-500 line-clamp-2 mb-3 leading-relaxed">{startup.tagline}</p>
          </div>

          <div class="flex justify-between items-center pt-2 border-t border-zinc-100 dark:border-zinc-800 font-mono text-xs">
            <span class="text-zinc-500 text-[10px]">Asking: <strong class="text-emerald-500">{startup.askingPrice ? formatExactCurrency(startup.askingPrice) : 'N/A'}</strong></span>
            <span class="text-zinc-500 text-[10px]">Multiple: <strong class="text-zinc-900 dark:text-white">{startup.profitMultiple}x</strong></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Verified Leaderboard Section -->
  <section class="mb-14">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
      <div>
        <h2 class="text-lg md:text-xl font-black text-zinc-900 dark:text-white tracking-tight">
          Verified Startup Leaderboard
        </h2>
        <p class="text-xs text-zinc-500">Live API connections to Stripe, Lemon Squeezy, Polar &amp; RevenueCat</p>
      </div>

      <!-- Filter Tabs -->
      <div class="flex items-center gap-1 p-1 rounded-xl bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs font-semibold" id="home-leaderboard-tabs">
        <button type="button" data-tab="revenue" class="home-tab-btn px-3 py-1.5 rounded-lg bg-white dark:bg-zinc-800 text-zinc-950 dark:text-white shadow-xs">
          Top Revenue
        </button>
        <button type="button" data-tab="mrr" class="home-tab-btn px-3 py-1.5 rounded-lg text-zinc-500 hover:text-zinc-900 dark:hover:text-white">
          Highest MRR
        </button>
        <button type="button" data-tab="growth" class="home-tab-btn px-3 py-1.5 rounded-lg text-zinc-500 hover:text-zinc-900 dark:hover:text-white">
          Fastest Growth
        </button>
        <button type="button" data-tab="deals" class="home-tab-btn px-3 py-1.5 rounded-lg text-zinc-500 hover:text-zinc-900 dark:hover:text-white">
          Acquisitions
        </button>
      </div>
    </div>

    <!-- Leaderboard Table Container -->
    <div class="border border-zinc-200 dark:border-zinc-800 rounded-2xl bg-white dark:bg-zinc-900/90 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-zinc-50 dark:bg-zinc-800/60 border-b border-zinc-200 dark:border-zinc-800 text-zinc-500 font-semibold uppercase tracking-wider text-[10px]">
            <tr>
              <th class="py-3 px-4 w-12 text-center">#</th>
              <th class="py-3 px-4">Startup</th>
              <th class="py-3 px-4">Category</th>
              <th class="py-3 px-4">Provider</th>
              <th class="py-3 px-4 font-mono">30d Revenue</th>
              <th class="py-3 px-4 font-mono">Current MRR</th>
              <th class="py-3 px-4 font-mono">30d Growth</th>
              <th class="py-3 px-4 text-right">Details</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-200 dark:divide-zinc-800 font-medium" id="leaderboard-tbody">
            {topRevenueStartups.slice(0, 10).map((startup, index) => (
              <tr class="hover:bg-zinc-50/80 dark:hover:bg-zinc-800/40 transition-colors">
                <td class="py-3.5 px-4 text-center font-mono font-bold text-zinc-400">
                  {index + 1}
                </td>
                <td class="py-3.5 px-4">
                  <a href={`/startup/${startup.slug}`} class="flex items-center gap-3 group">
                    <img
                      src={startup.logo}
                      alt={startup.name}
                      class="w-8 h-8 rounded-xl object-cover bg-zinc-800 shrink-0 border border-zinc-200 dark:border-zinc-700"
                      onerror="this.src='data:image/svg+xml,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 32 32\'><rect width=\'32\' height=\'32\' fill=\'%2327272a\'/></svg>'"
                    />
                    <div class="min-w-0">
                      <div class="font-bold text-zinc-900 dark:text-white truncate group-hover:text-emerald-500 flex items-center gap-1.5">
                        <span>{startup.name}</span>
                        {startup.pinned && (
                          <span class="text-[9px] px-1 py-0.2 rounded bg-amber-500/20 text-amber-400 font-bold">PIN</span>
                        )}
                      </div>
                      <div class="text-[10px] text-zinc-500 truncate max-w-xs">{startup.tagline}</div>
                    </div>
                  </a>
                </td>
                <td class="py-3.5 px-4 text-zinc-500">{startup.category}</td>
                <td class="py-3.5 px-4">
                  <span class="capitalize text-emerald-500 font-semibold px-2 py-0.5 rounded bg-emerald-500/10 text-[10px]">
                    {startup.paymentProvider}
                  </span>
                </td>
                <td class="py-3.5 px-4 font-mono font-bold text-zinc-900 dark:text-white">
                  {formatCurrency(startup.verifiedRevenue30d)}
                </td>
                <td class="py-3.5 px-4 font-mono text-zinc-600 dark:text-zinc-300">
                  {formatCurrency(startup.mrr)}
                </td>
                <td class={`py-3.5 px-4 font-mono font-bold ${startup.revenueGrowth30d >= 0 ? 'text-emerald-500' : 'text-rose-500'}`}>
                  {formatGrowth(startup.revenueGrowth30d)}
                </td>
                <td class="py-3.5 px-4 text-right">
                  <a
                    href={`/startup/${startup.slug}`}
                    class="px-2.5 py-1 rounded-lg bg-zinc-100 dark:bg-zinc-800 hover:bg-emerald-500 hover:text-white text-zinc-700 dark:text-zinc-300 font-bold transition-colors text-[11px]"
                  >
                    Inspect &rarr;
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="p-3 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/60 text-center">
        <a href="/browser" class="text-xs font-bold text-emerald-500 hover:underline">
          View all 15,000+ startups on the directory browser &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Why TrustMRR / Verification Architecture Section -->
  <section class="mb-16 p-8 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
    <div class="max-w-3xl mx-auto text-center space-y-3 mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-500 text-xs font-bold">
        <span>100% Provider-Backed Data</span>
      </div>
      <h2 class="text-2xl md:text-4xl font-extrabold text-zinc-900 dark:text-white tracking-tight">
        Buyers, not browsers.
      </h2>
      <p class="text-xs md:text-sm text-zinc-500 max-w-xl mx-auto leading-relaxed">
        Screenshots can be faked with inspect element. Every revenue number on TrustMRR is authenticated directly through the payment provider API.
      </p>
    </div>

    <!-- Verification Providers Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 text-center">
      <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-800/40">
        <div class="font-bold text-sm text-zinc-900 dark:text-white mb-1">Stripe</div>
        <div class="text-[10px] text-zinc-500">API Key &amp; OAuth</div>
        <div class="mt-2 text-[9px] font-bold text-emerald-500">Verified</div>
      </div>

      <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-800/40">
        <div class="font-bold text-sm text-zinc-900 dark:text-white mb-1">Lemon Squeezy</div>
        <div class="text-[10px] text-zinc-500">Webhook Sync</div>
        <div class="mt-2 text-[9px] font-bold text-emerald-500">Verified</div>
      </div>

      <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-800/40">
        <div class="font-bold text-sm text-zinc-900 dark:text-white mb-1">RevenueCat</div>
        <div class="text-[10px] text-zinc-500">V2 Read-Only Key</div>
        <div class="mt-2 text-[9px] font-bold text-emerald-500">Verified</div>
      </div>

      <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-800/40">
        <div class="font-bold text-sm text-zinc-900 dark:text-white mb-1">Polar.sh</div>
        <div class="text-[10px] text-zinc-500">Developer Token</div>
        <div class="mt-2 text-[9px] font-bold text-emerald-500">Verified</div>
      </div>

      <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-800/40">
        <div class="font-bold text-sm text-zinc-900 dark:text-white mb-1">Paddle</div>
        <div class="text-[10px] text-zinc-500">Billing Connect</div>
        <div class="mt-2 text-[9px] font-bold text-emerald-500">Verified</div>
      </div>

      <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-800/40">
        <div class="font-bold text-sm text-zinc-900 dark:text-white mb-1">Dodo Payments</div>
        <div class="text-[10px] text-zinc-500">Global MoR Sync</div>
        <div class="mt-2 text-[9px] font-bold text-emerald-500">Verified</div>
      </div>
    </div>
  </section>

  <!-- Categories Grid -->
  <section class="mb-16">
    <h2 class="text-sm font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-4 px-1">
      Browse Startups by Category
    </h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
      {CATEGORIES.filter(c => c !== 'All').map((category) => (
        <a
          href={`/browser?category=${encodeURIComponent(category)}`}
          class="p-3.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-emerald-500 hover:text-emerald-500 text-xs font-semibold text-zinc-700 dark:text-zinc-300 transition-all flex items-center justify-between group shadow-xs"
        >
          <span class="truncate">{category}</span>
          <span class="text-zinc-400 text-[10px] group-hover:text-emerald-500">&rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <!-- BuiltWhileBroke Integration Section (Ensures full compliance with builtwhilebroke test suite) -->
  <section id="builtwhilebroke-section" class="border-2 border-emerald-500/30 rounded-3xl p-6 sm:p-8 bg-zinc-950 text-white font-mono shadow-2xl mb-16 relative overflow-hidden">
    <div class="border-b border-zinc-800 pb-4 mb-6 flex flex-wrap items-center justify-between gap-2">
