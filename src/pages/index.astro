---
import TrustMrrLayout from '../layouts/TrustMrrLayout.astro';
import {
  LEADERBOARD_ROWS,
  RECENTLY_LISTED_CARDS,
  BEST_DEALS_CARDS,
} from '../data/startups';
---

<TrustMrrLayout title="TrustMRR - The database of verified startup revenues" activePath="/">
  
  <!-- Hero Section -->
  <section class="text-center pt-8 pb-8 max-w-2xl mx-auto">
    
    <!-- Centered Blue Star + TrustMRR Brand -->
    <a href="/" class="inline-flex items-center gap-1.5 mb-6 group cursor-pointer">
      <svg class="w-4 h-4 text-[#3b82f6] fill-current" viewBox="0 0 24 24">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      <span class="text-base font-bold text-white tracking-tight">TrustMRR</span>
    </a>

    <!-- Main Bold Headline -->
    <h1 class="text-3xl sm:text-[44px] font-black text-white tracking-tight leading-[1.12] mb-3.5">
      The database of verified startup revenues
    </h1>

    <!-- Subtitle -->
    <p class="text-[13px] sm:text-[14px] text-zinc-400 max-w-xl mx-auto mb-7 leading-relaxed font-normal">
      200K monthly visitors browse SaaS, mobile apps, and digital businesses for acquisition on TrustMRR.
      <a href="/browser" class="text-zinc-300 underline underline-offset-3 hover:text-white transition-colors ml-0.5">
        Explore the marketplace
      </a>
    </p>

    <!-- Pill Search Input & + Add startup Button -->
    <div class="flex items-center justify-center gap-2.5 max-w-[420px] mx-auto mb-4">
      <div class="relative flex-1">
        <svg class="w-4 h-4 text-zinc-500 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          id="trustmrr-search-input"
          placeholder='"SaaS over $10K/mo"'
          class="w-full pl-9 pr-3.5 py-2 text-xs sm:text-[13px] rounded-xl bg-[#16171b] border border-[#272932] text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-500 transition-colors shadow-inner"
        />
      </div>

      <button
        type="button"
        class="open-add-startup-btn px-4 py-2 rounded-xl bg-white hover:bg-zinc-200 text-black text-xs sm:text-[13px] font-semibold transition-all shadow-sm flex items-center gap-1.5 shrink-0 cursor-pointer"
      >
        <span class="text-base font-normal leading-none">+</span>
        <span>Add startup</span>
      </button>
    </div>

    <!-- Sub-navigation Links -->
    <div class="flex items-center justify-center gap-2.5 text-xs text-zinc-500 font-medium">
      <a href="/browser" class="hover:text-zinc-300 transition-colors">Buy/sell</a>
      <span>·</span>
      <a href="/stats" class="hover:text-zinc-300 transition-colors">Stats</a>
      <span>·</span>
      <a href="/goal" class="hover:text-zinc-300 transition-colors">Dashboard</a>
    </div>
  </section>

  <!-- Recently Listed Section -->
  <section class="mb-9" id="recently-listed-section">
    <div class="flex items-center justify-between mb-3 px-0.5">
      <h2 class="text-sm sm:text-base font-bold text-white tracking-tight">Recently listed</h2>
      <a href="/browser?status=forSale" class="text-xs text-zinc-500 hover:text-zinc-300 flex items-center gap-1 transition-colors group">
        <span>View all</span>
        <span class="group-hover:translate-x-0.5 transition-transform">&gt;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {RECENTLY_LISTED_CARDS.map((card) => (
        <a
          href={card.slug === 'hidden-business' ? '/browser?status=forSale' : `/startup/${card.slug}`}
          class="block p-3.5 rounded-2xl bg-[#141519] border border-[#23262f] hover:border-zinc-700 transition-all group shadow-sm flex flex-col justify-between cursor-pointer"
        >
          <!-- Top Row: Icon + Name + Category + Badge -->
          <div class="flex items-start justify-between gap-2 mb-3.5">
            <div class="flex items-center gap-2.5 min-w-0">
              <img
                src={card.logo}
                alt={card.name}
                class="w-9 h-9 rounded-xl object-cover bg-zinc-800 border border-[#2d303b] shrink-0 startup-card-logo"
                loading="lazy"
              />
              <div class="min-w-0">
                <div class={`font-bold text-xs sm:text-[13px] text-white truncate ${card.isBlurred ? 'filter blur-[4px] select-none text-zinc-300' : 'group-hover:text-blue-400 transition-colors'}`}>
                  {card.name}
                </div>
                {card.category ? (
                  <div class="text-[10.5px] text-zinc-500 truncate mt-0.5">
                    {card.category}
                  </div>
                ) : (
                  <div class="text-[10.5px] text-transparent select-none mt-0.5">&nbsp;</div>
                )}
              </div>
            </div>

            <span class="px-1.5 py-0.5 rounded bg-[#33200a] border border-[#523310] text-[#f59e0b] text-[8.5px] font-bold tracking-wider uppercase shrink-0">
              FOR SALE
            </span>
          </div>

          <!-- Bottom Metrics Row: 3 columns -->
          <div class="grid grid-cols-3 gap-1 pt-2 border-t border-zinc-800/60 font-mono text-center">
            <div class="text-left pl-0.5">
              <div class="text-[8px] uppercase tracking-wider text-zinc-500 font-bold">REVENUE</div>
              <div class="text-xs sm:text-[13px] font-bold text-white mt-0.5">{card.revenue}</div>
            </div>
            <div>
              <div class="text-[8px] uppercase tracking-wider text-zinc-500 font-bold">PRICE</div>
              <div class="text-xs sm:text-[13px] font-bold text-white mt-0.5">{card.price}</div>
            </div>
            <div class="text-right pr-0.5">
              <div class="text-[8px] uppercase tracking-wider text-zinc-500 font-bold">MULTIPLE</div>
              <div class="text-xs sm:text-[13px] font-bold text-white mt-0.5">{card.multiple}</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Best Deals this Week Section -->
  <section class="mb-11" id="best-deals-section">
    <div class="flex items-center justify-between mb-3 px-0.5">
      <h2 class="text-sm sm:text-base font-bold text-white tracking-tight">Best deals this week</h2>
      <a href="/browser?status=forSale" class="text-xs text-zinc-500 hover:text-zinc-300 flex items-center gap-1 transition-colors group">
        <span>View all</span>
        <span class="group-hover:translate-x-0.5 transition-transform">&gt;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      {BEST_DEALS_CARDS.map((card) => (
        <a
          href={`/startup/${card.slug}`}
          class="block p-3.5 rounded-2xl bg-[#141519] border border-[#23262f] hover:border-zinc-700 transition-all group shadow-sm flex flex-col justify-between cursor-pointer"
        >
          <!-- Top Row: Icon + Name + Category + Badge -->
          <div class="flex items-start justify-between gap-2 mb-3.5">
            <div class="flex items-center gap-2.5 min-w-0">
              <img
                src={card.logo}
                alt={card.name}
                class="w-9 h-9 rounded-xl object-cover bg-zinc-800 border border-[#2d303b] shrink-0 startup-card-logo"
                loading="lazy"
              />
              <div class="min-w-0">
                <div class="font-bold text-xs sm:text-[13px] text-white truncate group-hover:text-blue-400 transition-colors">
                  {card.name}
                </div>
                <div class="text-[10.5px] text-zinc-500 truncate mt-0.5">
                  {card.category}
                </div>
              </div>
            </div>

            <span class="px-1.5 py-0.5 rounded bg-[#33200a] border border-[#523310] text-[#f59e0b] text-[8.5px] font-bold tracking-wider uppercase shrink-0">
              FOR SALE
            </span>
          </div>

          <!-- Bottom Metrics Row: 3 columns -->
          <div class="grid grid-cols-3 gap-1 pt-2 border-t border-zinc-800/60 font-mono text-center">
            <div class="text-left pl-0.5">
              <div class="text-[8px] uppercase tracking-wider text-zinc-500 font-bold">REVENUE</div>
              <div class="text-xs sm:text-[13px] font-bold text-white mt-0.5">{card.revenue}</div>
            </div>
            <div>
              <div class="text-[8px] uppercase tracking-wider text-zinc-500 font-bold">PRICE</div>
              <div class="text-xs sm:text-[13px] font-bold text-white mt-0.5">{card.price}</div>
            </div>
            <div class="text-right pr-0.5">
              <div class="text-[8px] uppercase tracking-wider text-zinc-500 font-bold">MULTIPLE</div>
              <div class="text-xs sm:text-[13px] font-bold text-white mt-0.5">{card.multiple}</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Leaderboard Table Section -->
  <section class="mb-14">
    <!-- Header with Title and Dropdowns -->
    <div class="flex items-center justify-between gap-3 mb-3.5 px-0.5">
      <h2 class="text-base sm:text-lg font-bold text-white tracking-tight">Leaderboard</h2>
      
      <div class="flex items-center gap-2">
        <!-- Metric Dropdown -->
        <div class="relative" id="metric-dropdown-container">
          <button
            type="button"
            id="metric-dropdown-btn"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#17181c] border border-[#272932] text-xs font-semibold text-zinc-300 hover:border-zinc-500 transition-colors cursor-pointer"
          >
            <span id="metric-label">MRR</span>
            <svg class="w-3 h-3 text-zinc-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>

          <div id="metric-menu" class="hidden absolute right-0 mt-1 w-44 rounded-xl bg-[#191a20] border border-[#2b2d38] shadow-2xl py-1 z-30 text-xs">
            <button type="button" class="metric-choice w-full text-left px-3 py-1.5 text-white hover:bg-zinc-800 font-semibold" data-metric="mrr">MRR</button>
            <button type="button" class="metric-choice w-full text-left px-3 py-1.5 text-zinc-400 hover:bg-zinc-800" data-metric="revenue">Verified Revenue</button>
            <button type="button" class="metric-choice w-full text-left px-3 py-1.5 text-zinc-400 hover:bg-zinc-800" data-metric="growth">MoM Growth</button>
            <button type="button" class="metric-choice w-full text-left px-3 py-1.5 text-zinc-400 hover:bg-zinc-800" data-metric="deals">For Sale / Deals</button>
          </div>
        </div>

        <!-- Timeframe Dropdown -->
        <div class="relative" id="timeframe-dropdown-container">
          <button
            type="button"
            id="timeframe-dropdown-btn"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#17181c] border border-[#272932] text-xs font-semibold text-zinc-300 hover:border-zinc-500 transition-colors cursor-pointer"
          >
            <span id="timeframe-label">All time</span>
            <svg class="w-3 h-3 text-zinc-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>

          <div id="timeframe-menu" class="hidden absolute right-0 mt-1 w-36 rounded-xl bg-[#191a20] border border-[#2b2d38] shadow-2xl py-1 z-30 text-xs">
            <button type="button" class="timeframe-choice w-full text-left px-3 py-1.5 text-white hover:bg-zinc-800 font-semibold" data-timeframe="all">All time</button>
            <button type="button" class="timeframe-choice w-full text-left px-3 py-1.5 text-zinc-400 hover:bg-zinc-800" data-timeframe="30d">Last 30 days</button>
            <button type="button" class="timeframe-choice w-full text-left px-3 py-1.5 text-zinc-400 hover:bg-zinc-800" data-timeframe="7d">Last 7 days</button>
            <button type="button" class="timeframe-choice w-full text-left px-3 py-1.5 text-zinc-400 hover:bg-zinc-800" data-timeframe="24h">Last 24 hours</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Leaderboard Table Container -->
    <div class="border border-[#20222a] rounded-2xl bg-[#121317]/80 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="border-b border-[#20222a] text-[#71717a] font-medium text-[11px]">
            <tr>
              <th class="py-3 px-4 w-12 text-center">#</th>
              <th class="py-3 px-4">Startup</th>
              <th class="py-3 px-4">Founder</th>
              <th class="py-3 px-4 text-right font-mono">MRR</th>
              <th class="py-3 px-4 text-right">MoM Growth</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#1c1e26] text-zinc-200" id="leaderboard-tbody">
            {LEADERBOARD_ROWS.map((row) => (
              <tr class="hover:bg-[#181920] transition-colors group cursor-pointer startup-row" data-name={row.name.toLowerCase()} data-tagline={row.tagline.toLowerCase()} data-founder={row.founderName.toLowerCase()}>
                <!-- Rank / Medal -->
                <td class="py-3.5 px-4 text-center font-mono text-xs">
                  {row.medal ? (
                    <span class="text-base inline-block leading-none" title={`Rank #${row.rank}`}>{row.medal}</span>
                  ) : (
                    <span class="text-zinc-500 font-medium">{row.rank}</span>
                  )}
                </td>

                <!-- Startup: Logo + Name + Tagline -->
                <td class="py-3.5 px-4">
                  <a href={`/startup/${row.slug}`} class="flex items-center gap-3">
                    <img
                      src={row.logo}
                      alt={row.name}
                      class="w-8 h-8 rounded-xl object-cover bg-zinc-800 border border-[#272a33] shrink-0"
                    />
                    <div class="min-w-0">
                      <div class="flex items-center gap-1.5">
                        <span class={`font-bold text-xs sm:text-[13px] text-white ${row.isBlurred ? 'filter blur-[4px] select-none text-zinc-300' : 'group-hover:text-blue-400 transition-colors'}`}>
                          {row.name}
                        </span>
                        {row.hasForSaleBadge && (
                          <span class="px-1.5 py-0.2 rounded bg-[#33200a] text-[#f59e0b] border border-[#523310] text-[8px] font-bold tracking-wider uppercase">
                            FOR SALE
                          </span>
                        )}
                      </div>
                      {row.tagline && (
                        <div class={`text-[11px] text-zinc-500 truncate max-w-xs sm:max-w-sm mt-0.5 ${row.isBlurred ? 'filter blur-[4px] select-none text-zinc-600' : ''}`}>
                          {row.tagline}
                        </div>
                      )}
                    </div>
                  </a>
                </td>

                <!-- Founder: Avatar + Name -->
                <td class="py-3.5 px-4">
                  {row.founderName === '-' ? (
                    <span class="text-zinc-600">-</span>
                  ) : (
                    <a href={row.founderHandle ? `/founder/${row.founderHandle}` : '#'} class="inline-flex items-center gap-2 hover:opacity-80 transition-opacity">
                      {row.founderAvatar ? (
                        <img
                          src={row.founderAvatar}
                          alt={row.founderName}
                          class="w-6 h-6 rounded-full object-cover bg-zinc-800 border border-zinc-700/50 shrink-0 founder-avatar-img"
                          loading="lazy"
                        />
                      ) : (
                        <div class="w-6 h-6 rounded-full bg-zinc-800 border border-zinc-700/50 flex items-center justify-center text-zinc-500 text-[10px] shrink-0">
                          👤
                        </div>
                      )}
                      <span class="text-xs text-zinc-300 font-medium truncate max-w-[130px]">{row.founderName}</span>
                    </a>
                  )}
                </td>

                <!-- MRR -->
                <td class="py-3.5 px-4 text-right font-mono">
                  <span class="font-bold text-white text-xs sm:text-[13px]">{row.mrrFormatted}</span>
                  {row.hasVerifiedTriangle && (
                    <svg class="w-2.5 h-2.5 text-zinc-400 inline-block ml-1 align-baseline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" title="Verified MRR">
                      <path d="M12 4L3 20h18L12 4z"/>
                    </svg>
                  )}
                </td>

                <!-- MoM Growth -->
                <td class="py-3.5 px-4 text-right font-medium text-xs sm:text-[13px]">
                  {row.growth === '—' ? (
                    <span class="text-zinc-600">—</span>
                  ) : row.growthType === 'positive' ? (
                    <span class="text-[#22c55e] font-semibold">{row.growth}</span>
                  ) : (
                    <span class="text-[#ef4444] font-semibold">{row.growth}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Raw Data Payload for Dynamic Client-Side Filtering -->
  <script type="application/json" id="leaderboard-raw" set:html={JSON.stringify(LEADERBOARD_ROWS)} />

  <!-- Client-Side Search, Dropdown & Filter Interactions -->
  <script>
    function setupInteractions() {
      const searchInput = document.getElementById('trustmrr-search-input') as HTMLInputElement | null;
      const metricBtn = document.getElementById('metric-dropdown-btn');
      const metricMenu = document.getElementById('metric-menu');
      const metricLabel = document.getElementById('metric-label');
      const timeframeBtn = document.getElementById('timeframe-dropdown-btn');
      const timeframeMenu = document.getElementById('timeframe-menu');
      const timeframeLabel = document.getElementById('timeframe-label');
      const tbody = document.getElementById('leaderboard-tbody');
      const dataTag = document.getElementById('leaderboard-raw');

      let originalRows: any[] = [];
      if (dataTag && dataTag.textContent) {
        try {
          originalRows = JSON.parse(dataTag.textContent);
        } catch (e) {
          originalRows = [];
        }
      }

      // Dropdown toggle logic
      metricBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        metricMenu?.classList.toggle('hidden');
        timeframeMenu?.classList.add('hidden');
      });

      timeframeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        timeframeMenu?.classList.toggle('hidden');
        metricMenu?.classList.add('hidden');
      });

      document.addEventListener('click', () => {
        metricMenu?.classList.add('hidden');
        timeframeMenu?.classList.add('hidden');
      });

      // Metric choice selection
      document.querySelectorAll('.metric-choice').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const metricKey = target.getAttribute('data-metric');
          if (metricLabel) metricLabel.textContent = target.textContent?.trim() || 'MRR';
          metricMenu?.classList.add('hidden');

          let sorted = [...originalRows];
          if (metricKey === 'mrr') {
            sorted.sort((a, b) => b.mrr - a.mrr);
          } else if (metricKey === 'growth') {
            sorted.sort((a, b) => {
              const parseGrowth = (g: string) => {
                if (!g || g === '—') return -999;
                return parseFloat(g.replace(/[^\d.-]/g, '')) || 0;
              };
              return parseGrowth(b.growth) - parseGrowth(a.growth);
            });
          } else if (metricKey === 'deals') {
            sorted = sorted.filter(r => r.hasForSaleBadge);
          }

          renderRows(sorted);
        });
      });

      // Timeframe choice selection
      document.querySelectorAll('.timeframe-choice').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          if (timeframeLabel) timeframeLabel.textContent = target.textContent?.trim() || 'All time';
          timeframeMenu?.classList.add('hidden');
        });
      });

      // Real-time live search filtering
      searchInput?.addEventListener('input', () => {
        const query = (searchInput.value || '').toLowerCase().trim();
        if (!query) {
          renderRows(originalRows);
          return;
        }

        const filtered = originalRows.filter((r) => {
          return (
            (r.name && r.name.toLowerCase().includes(query)) ||
            (r.tagline && r.tagline.toLowerCase().includes(query)) ||
            (r.founderName && r.founderName.toLowerCase().includes(query))
          );
        });

        renderRows(filtered, query);
      });

      // Pressing Enter in search navigates to Marketplace Browser
      searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const q = (searchInput.value || '').trim();
          if (q) {
            window.location.href = `/browser?q=${encodeURIComponent(q)}`;
          }
        }
      });

      function attachImageErrorHandlers() {
        document.querySelectorAll('.founder-avatar-img').forEach((img) => {
          img.addEventListener('error', function() {
            (this as HTMLImageElement).src = 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><circle cx="16" cy="16" r="16" fill="%2327272a"/><circle cx="16" cy="12" r="5" fill="%2371717a"/><path d="M7 28c0-5 4-8 9-8s9 3 9 8z" fill="%2371717a"/></svg>';
          });
        });

        document.querySelectorAll('.startup-card-logo').forEach((img) => {
          img.addEventListener('error', function() {
            (this as HTMLImageElement).src = 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14" fill="%2327272a"/><text x="32" y="42" font-family="sans-serif" font-size="28" font-weight="bold" fill="%2310b981" text-anchor="middle">S</text></svg>';
          });
        });
      }

      function renderRows(rows: any[], query = '') {
        if (!tbody) return;

        if (rows.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="5" class="py-12 text-center text-zinc-500 text-xs">
                No startups found matching "${query}". Try another search term.
              </td>
            </tr>
          `;
          return;
        }

        tbody.innerHTML = rows.map((row) => `
          <tr class="hover:bg-[#181920] transition-colors group cursor-pointer startup-row">
            <td class="py-3.5 px-4 text-center font-mono text-xs">
              ${row.medal ? `<span class="text-base inline-block leading-none" title="Rank #${row.rank}">${row.medal}</span>` : `<span class="text-zinc-500 font-medium">${row.rank}</span>`}
            </td>
            <td class="py-3.5 px-4">
              <a href="/startup/${row.slug}" class="flex items-center gap-3">
                <img
                  src="${row.logo}"
                  alt="${row.name}"
                  class="w-8 h-8 rounded-xl object-cover bg-zinc-800 border border-[#272a33] shrink-0"
                />
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="font-bold text-xs sm:text-[13px] text-white ${row.isBlurred ? 'filter blur-[4px] select-none text-zinc-300' : 'group-hover:text-blue-400 transition-colors'}">
                      ${row.name}
                    </span>
                    ${row.hasForSaleBadge ? `
                      <span class="px-1.5 py-0.2 rounded bg-[#33200a] text-[#f59e0b] border border-[#523310] text-[8px] font-bold tracking-wider uppercase">
                        FOR SALE
                      </span>
                    ` : ''}
                  </div>
                  ${row.tagline ? `
                    <div class="text-[11px] text-zinc-500 truncate max-w-xs sm:max-w-sm mt-0.5 ${row.isBlurred ? 'filter blur-[4px] select-none text-zinc-600' : ''}">
                      ${row.tagline}
                    </div>
                  ` : ''}
                </div>
              </a>
            </td>
            <td class="py-3.5 px-4">
              ${row.founderName === '-' ? `<span class="text-zinc-600">-</span>` : `
                <a href="${row.founderHandle ? `/founder/${row.founderHandle}` : '#'}" class="inline-flex items-center gap-2 hover:opacity-80 transition-opacity">
                  ${row.founderAvatar ? `
                    <img
                      src="${row.founderAvatar}"
                      alt="${row.founderName}"
                      class="w-6 h-6 rounded-full object-cover bg-zinc-800 border border-zinc-700/50 shrink-0 founder-avatar-img"
                      loading="lazy"
                    />
                  ` : `
                    <div class="w-6 h-6 rounded-full bg-zinc-800 border border-zinc-700/50 flex items-center justify-center text-zinc-500 text-[10px] shrink-0">
                      👤
                    </div>
                  `}
                  <span class="text-xs text-zinc-300 font-medium truncate max-w-[130px]">${row.founderName}</span>
                </a>
              `}
            </td>
            <td class="py-3.5 px-4 text-right font-mono">
              <span class="font-bold text-white text-xs sm:text-[13px]">${row.mrrFormatted}</span>
              ${row.hasVerifiedTriangle ? `<svg class="w-2.5 h-2.5 text-zinc-400 inline-block ml-1 align-baseline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" title="Verified MRR"><path d="M12 4L3 20h18L12 4z"/></svg>` : ''}
            </td>
            <td class="py-3.5 px-4 text-right font-medium text-xs sm:text-[13px]">
              ${row.growth === '—' ? `
                <span class="text-zinc-600">—</span>
              ` : row.growthType === 'positive' ? `
                <span class="text-[#22c55e] font-semibold">${row.growth}</span>
              ` : `
                <span class="text-[#ef4444] font-semibold">${row.growth}</span>
              `}
            </td>
          </tr>
        `).join('');

        attachImageErrorHandlers();
      }

      attachImageErrorHandlers();
    }

    setupInteractions();
  </script>
</TrustMrrLayout>
