---
import TrustMrrLayout from '../layouts/TrustMrrLayout.astro';
import {
  LEADERBOARD_ROWS,
  RECENTLY_LISTED_CARDS,
  BEST_DEALS_CARDS,
  SPACE_TYPES,
} from '../data/startups';
---

<TrustMrrLayout title="TrustMRR · Dev Spaces - The database of verified developer ad inventory" activePath="/">
  
  <!-- Hero Section -->
  <section class="text-center pt-8 pb-7 max-w-3xl mx-auto">
    
    <!-- Centered Blue Star + Brand -->
    <a href="/" class="inline-flex items-center gap-1.5 mb-5 group cursor-pointer">
      <svg class="w-4 h-4 text-[#3b82f6] fill-current" viewBox="0 0 24 24">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
      <span class="text-base font-bold text-white tracking-tight">TrustMRR</span>
      <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-400 border border-blue-500/20 ml-1">
        DEV SPACES
      </span>
    </a>

    <!-- Main Bold Headline -->
    <h1 class="text-3xl sm:text-[44px] font-black text-white tracking-tight leading-[1.12] mb-3.5">
      The database of verified developer ad spaces
    </h1>

    <!-- Subtitle -->
    <p class="text-[13px] sm:text-[14px] text-zinc-400 max-w-xl mx-auto mb-7 leading-relaxed font-normal">
      200K+ monthly developers browse SaaS dashboards, CLI tools, and docs. Tech brands buy verified sponsorship spots inside real developer workflows.
      <a href="/browser" class="text-zinc-300 underline underline-offset-3 hover:text-white transition-colors ml-0.5">
        Explore all spaces
      </a>
    </p>

    <!-- Pill Search Input & + List your space Button -->
    <div class="flex items-center justify-center gap-2.5 max-w-[440px] mx-auto mb-4">
      <div class="relative flex-1">
        <svg class="w-4 h-4 text-zinc-500 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          id="trustmrr-search-input"
          placeholder='"Documentation banner over 50K views"'
          class="w-full pl-9 pr-3.5 py-2 text-xs sm:text-[13px] rounded-xl bg-[#16171b] border border-[#272932] text-white placeholder-zinc-500 focus:outline-none focus:border-zinc-500 transition-colors shadow-inner"
        />
      </div>

      <button
        type="button"
        class="open-add-startup-btn px-4 py-2 rounded-xl bg-white hover:bg-zinc-200 text-black text-xs sm:text-[13px] font-semibold transition-all shadow-sm flex items-center gap-1.5 shrink-0 cursor-pointer"
      >
        <span class="text-base font-normal leading-none">+</span>
        <span>List your space</span>
      </button>
    </div>

    <!-- Sub-navigation Links -->
    <div class="flex items-center justify-center gap-2.5 text-xs text-zinc-500 font-medium mb-6">
      <a href="/city" class="text-emerald-400 hover:text-emerald-300 font-semibold transition-colors flex items-center gap-1">
        <span>🏙️ 3D Doodle City</span>
        <span class="text-[9px] px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-400 font-bold">GAME</span>
      </a>
      <span>·</span>
      <a href="/browser" class="hover:text-zinc-300 transition-colors">Browse Spaces</a>
      <span>·</span>
      <a href="#space-types-section" class="hover:text-zinc-300 transition-colors">Space Types</a>
      <span>·</span>
      <a href="/stats" class="hover:text-zinc-300 transition-colors">Stats</a>
      <span>·</span>
      <a href="/goal" class="hover:text-zinc-300 transition-colors">Rate Calculator</a>
    </div>

    <!-- Space Types Quick-Filter Pill Bar -->
    <div id="space-types-section" class="w-full overflow-x-auto no-scrollbar py-1">
      <div class="inline-flex items-center gap-1.5 p-1 bg-[#131418] border border-[#22242c] rounded-2xl">
        {SPACE_TYPES.map((type, idx) => (
          <button
            type="button"
            class={`space-type-pill px-3 py-1.5 rounded-xl text-xs font-medium transition-all whitespace-nowrap cursor-pointer ${idx === 0 ? 'bg-[#272932] text-white shadow-sm font-semibold' : 'text-zinc-400 hover:text-white hover:bg-zinc-800/60'}`}
            data-space-type={type}
          >
            {type}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Recently Listed Section -->
  <section class="mb-9" id="recently-listed-section">
    <div class="flex items-center justify-between mb-3 px-0.5">
      <h2 class="text-sm sm:text-base font-bold text-white tracking-tight">Recently listed spaces</h2>
      <a href="/browser" class="text-xs text-zinc-500 hover:text-zinc-300 flex items-center gap-1 transition-colors group">
        <span>View all</span>
        <span class="group-hover:translate-x-0.5 transition-transform">&gt;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3" id="recently-listed-grid">
      {RECENTLY_LISTED_CARDS.map((card) => (
        <a
          href={card.slug === 'hidden-business' ? '/browser' : `/startup/${card.slug}`}
          class="space-card block p-3.5 rounded-2xl bg-[#141519] border border-[#23262f] hover:border-zinc-700 transition-all group shadow-sm flex flex-col justify-between cursor-pointer"
          data-space-type={card.spaceType || ''}
        >
          <!-- Top Row: Icon + Name + Category + Badge -->
          <div class="flex items-start justify-between gap-2 mb-3.5">
            <div class="flex items-center gap-2.5 min-w-0">
              <img
                src={card.logo}
                alt={card.name}
                class="w-9 h-9 rounded-xl object-cover bg-zinc-800 border border-[#2d303b] shrink-0 startup-card-logo"
                loading="lazy"
              />
              <div class="min-w-0">
                <div class={`font-bold text-xs sm:text-[13px] text-white truncate ${card.isBlurred ? 'filter blur-[4px] select-none text-zinc-300' : 'group-hover:text-blue-400 transition-colors'}`}>
                  {card.name}
                </div>
                <div class="text-[10.5px] text-blue-400 font-medium truncate mt-0.5">
                  {card.spaceType || card.category}
                </div>
              </div>
            </div>

            <span class="px-1.5 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[8.5px] font-bold tracking-wider uppercase shrink-0">
              AVAILABLE
            </span>
          </div>

          <!-- Bottom Metrics Row: 3 columns -->
          <div class="grid grid-cols-3 gap-1 pt-2 border-t border-zinc-800/60 font-mono text-center">
            <div class="text-left pl-0.5">
              <div class="text-[8px] uppercase tracking-wider text-zinc-500 font-bold">VIEWS</div>
              <div class="text-xs sm:text-[13px] font-bold text-white mt-0.5">{card.impressionsFormatted || card.revenue}</div>
            </div>
            <div>
              <div class="text-[8px] uppercase tracking-wider text-zinc-500 font-bold">SPONSOR</div>
              <div class="text-xs sm:text-[13px] font-bold text-white mt-0.5">{card.priceFormatted || card.price}</div>
            </div>
            <div class="text-right pr-0.5">
              <div class="text-[8px] uppercase tracking-wider text-zinc-500 font-bold">RATE</div>
              <div class="text-xs sm:text-[13px] font-bold text-white mt-0.5">{card.cpmFormatted || card.multiple}</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Best Deals this Week Section -->
  <section class="mb-11" id="best-deals-section">
    <div class="flex items-center justify-between mb-3 px-0.5">
      <h2 class="text-sm sm:text-base font-bold text-white tracking-tight">Best sponsor deals this week</h2>
      <a href="/browser" class="text-xs text-zinc-500 hover:text-zinc-300 flex items-center gap-1 transition-colors group">
        <span>View all</span>
        <span class="group-hover:translate-x-0.5 transition-transform">&gt;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3" id="best-deals-grid">
      {BEST_DEALS_CARDS.map((card) => (
        <a
          href={`/startup/${card.slug}`}
          class="space-card block p-3.5 rounded-2xl bg-[#141519] border border-[#23262f] hover:border-zinc-700 transition-all group shadow-sm flex flex-col justify-between cursor-pointer"
          data-space-type={card.spaceType || ''}
        >
          <!-- Top Row: Icon + Name + Category + Badge -->
          <div class="flex items-start justify-between gap-2 mb-3.5">
            <div class="flex items-center gap-2.5 min-w-0">
              <img
                src={card.logo}
                alt={card.name}
                class="w-9 h-9 rounded-xl object-cover bg-zinc-800 border border-[#2d303b] shrink-0 startup-card-logo"
                loading="lazy"
              />
              <div class="min-w-0">
                <div class="font-bold text-xs sm:text-[13px] text-white truncate group-hover:text-blue-400 transition-colors">
                  {card.name}
                </div>
                <div class="text-[10.5px] text-blue-400 font-medium truncate mt-0.5">
                  {card.spaceType || card.category}
                </div>
              </div>
            </div>

            <span class="px-1.5 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[8.5px] font-bold tracking-wider uppercase shrink-0">
              AVAILABLE
            </span>
          </div>

          <!-- Bottom Metrics Row: 3 columns -->
          <div class="grid grid-cols-3 gap-1 pt-2 border-t border-zinc-800/60 font-mono text-center">
            <div class="text-left pl-0.5">
              <div class="text-[8px] uppercase tracking-wider text-zinc-500 font-bold">VIEWS</div>
              <div class="text-xs sm:text-[13px] font-bold text-white mt-0.5">{card.impressionsFormatted || card.revenue}</div>
            </div>
            <div>
              <div class="text-[8px] uppercase tracking-wider text-zinc-500 font-bold">SPONSOR</div>
              <div class="text-xs sm:text-[13px] font-bold text-white mt-0.5">{card.priceFormatted || card.price}</div>
            </div>
            <div class="text-right pr-0.5">
              <div class="text-[8px] uppercase tracking-wider text-zinc-500 font-bold">RATE</div>
              <div class="text-xs sm:text-[13px] font-bold text-white mt-0.5">{card.cpmFormatted || card.multiple}</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Leaderboard Table Section -->
  <section class="mb-14">
    <!-- Header with Title and Dropdowns -->
    <div class="flex items-center justify-between gap-3 mb-3.5 px-0.5">
      <h2 class="text-base sm:text-lg font-bold text-white tracking-tight">Verified Dev Spaces Leaderboard</h2>
      
      <div class="flex items-center gap-2">
        <!-- Metric Dropdown -->
        <div class="relative" id="metric-dropdown-container">
          <button
            type="button"
            id="metric-dropdown-btn"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#17181c] border border-[#272932] text-xs font-semibold text-zinc-300 hover:border-zinc-500 transition-colors cursor-pointer"
          >
            <span id="metric-label">Monthly Views</span>
            <svg class="w-3 h-3 text-zinc-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>

          <div id="metric-menu" class="hidden absolute right-0 mt-1 w-44 rounded-xl bg-[#191a20] border border-[#2b2d38] shadow-2xl py-1 z-30 text-xs">
            <button type="button" class="metric-choice w-full text-left px-3 py-1.5 text-white hover:bg-zinc-800 font-semibold" data-metric="views">Monthly Views</button>
            <button type="button" class="metric-choice w-full text-left px-3 py-1.5 text-zinc-400 hover:bg-zinc-800" data-metric="rate">Sponsor Rate</button>
            <button type="button" class="metric-choice w-full text-left px-3 py-1.5 text-zinc-400 hover:bg-zinc-800" data-metric="cpm">Lowest CPM</button>
            <button type="button" class="metric-choice w-full text-left px-3 py-1.5 text-zinc-400 hover:bg-zinc-800" data-metric="available">Available Spaces</button>
          </div>
        </div>

        <!-- Timeframe Dropdown -->
        <div class="relative" id="timeframe-dropdown-container">
          <button
            type="button"
            id="timeframe-dropdown-btn"
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#17181c] border border-[#272932] text-xs font-semibold text-zinc-300 hover:border-zinc-500 transition-colors cursor-pointer"
          >
            <span id="timeframe-label">All time</span>
            <svg class="w-3 h-3 text-zinc-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>

          <div id="timeframe-menu" class="hidden absolute right-0 mt-1 w-36 rounded-xl bg-[#191a20] border border-[#2b2d38] shadow-2xl py-1 z-30 text-xs">
            <button type="button" class="timeframe-choice w-full text-left px-3 py-1.5 text-white hover:bg-zinc-800 font-semibold" data-timeframe="all">All time</button>
            <button type="button" class="timeframe-choice w-full text-left px-3 py-1.5 text-zinc-400 hover:bg-zinc-800" data-timeframe="30d">Last 30 days</button>
            <button type="button" class="timeframe-choice w-full text-left px-3 py-1.5 text-zinc-400 hover:bg-zinc-800" data-timeframe="7d">Last 7 days</button>
            <button type="button" class="timeframe-choice w-full text-left px-3 py-1.5 text-zinc-400 hover:bg-zinc-800" data-timeframe="24h">Last 24 hours</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Leaderboard Table Container -->
    <div class="border border-[#20222a] rounded-2xl bg-[#121317]/80 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead class="border-b border-[#20222a] text-[#71717a] font-medium text-[11px]">
            <tr>
              <th class="py-3 px-4 w-12 text-center">#</th>
              <th class="py-3 px-4">Developer Product</th>
              <th class="py-3 px-4">Placement Slot</th>
              <th class="py-3 px-4 text-right font-mono">Monthly Views</th>
              <th class="py-3 px-4 text-right">Sponsor Rate</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#1c1e26] text-zinc-200" id="leaderboard-tbody">
            {LEADERBOARD_ROWS.map((row) => (
              <tr class="hover:bg-[#181920] transition-colors group cursor-pointer startup-row" data-name={row.name.toLowerCase()} data-tagline={row.tagline.toLowerCase()} data-founder={row.founderName.toLowerCase()} data-spacetype={row.spaceType || ''}>
                <!-- Rank / Medal -->
                <td class="py-3.5 px-4 text-center font-mono text-xs">
                  {row.medal ? (
                    <span class="text-base inline-block leading-none" title={`Rank #${row.rank}`}>{row.medal}</span>
                  ) : (
                    <span class="text-zinc-500 font-medium">{row.rank}</span>
                  )}
                </td>

                <!-- Startup: Logo + Name + Tagline -->
                <td class="py-3.5 px-4">
                  <a href={`/startup/${row.slug}`} class="flex items-center gap-3">
                    <img
                      src={row.logo}
                      alt={row.name}
                      class="w-8 h-8 rounded-xl object-cover bg-zinc-800 border border-[#272a33] shrink-0"
                    />
                    <div class="min-w-0">
                      <div class="flex items-center gap-1.5">
                        <span class={`font-bold text-xs sm:text-[13px] text-white ${row.isBlurred ? 'filter blur-[4px] select-none text-zinc-300' : 'group-hover:text-blue-400 transition-colors'}`}>
                          {row.name}
                        </span>
                        <span class="px-1.5 py-0.2 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[8px] font-bold tracking-wider uppercase">
                          AVAILABLE
                        </span>
                      </div>
                      {row.tagline && (
                        <div class={`text-[11px] text-zinc-500 truncate max-w-xs sm:max-w-sm mt-0.5 ${row.isBlurred ? 'filter blur-[4px] select-none text-zinc-600' : ''}`}>
                          {row.tagline}
                        </div>
                      )}
                    </div>
                  </a>
                </td>

                <!-- Placement Slot -->
                <td class="py-3.5 px-4">
                  <div class="flex flex-col items-start gap-1">
                    <span class="px-2 py-0.5 rounded-md bg-blue-500/10 border border-blue-500/20 text-blue-400 font-semibold text-[11px] inline-block">
                      {row.spaceType || 'Documentation'}
                    </span>
                    <span class="text-[10px] text-zinc-500 flex items-center gap-1">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      Direct UI slot
                    </span>
                  </div>
                </td>

                <!-- Monthly Views -->
                <td class="py-3.5 px-4 text-right font-mono">
                  <span class="font-bold text-white text-xs sm:text-[13px]">{row.impressionsFormatted || row.mrrFormatted}</span>
                  <svg class="w-2.5 h-2.5 text-blue-400 inline-block ml-1 align-baseline" viewBox="0 0 24 24" fill="currentColor" title="Verified Analytics Views">
                    <path d="M12 4L3 20h18L12 4z"/>
                  </svg>
                  <span class="text-[10px] text-zinc-500 block font-sans">verified/mo</span>
                </td>

                <!-- Sponsor Rate -->
                <td class="py-3.5 px-4 text-right font-medium text-xs sm:text-[13px]">
                  <span class="text-emerald-400 font-bold block">{row.priceFormatted || '$1,200/mo'}</span>
                  <span class="text-[10px] text-zinc-500 font-mono block">{row.cpmFormatted || '$15 CPM'}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Raw Data Payload for Dynamic Client-Side Filtering -->
  <script type="application/json" id="leaderboard-raw" set:html={JSON.stringify(LEADERBOARD_ROWS)} />

  <!-- Client-Side Search, Dropdown & Filter Interactions -->
  <script>
    function setupInteractions() {
      const searchInput = document.getElementById('trustmrr-search-input') as HTMLInputElement | null;
      const metricBtn = document.getElementById('metric-dropdown-btn');
      const metricMenu = document.getElementById('metric-menu');
      const metricLabel = document.getElementById('metric-label');
      const timeframeBtn = document.getElementById('timeframe-dropdown-btn');
      const timeframeMenu = document.getElementById('timeframe-menu');
      const timeframeLabel = document.getElementById('timeframe-label');
      const tbody = document.getElementById('leaderboard-tbody');
      const dataTag = document.getElementById('leaderboard-raw');
      const pillBtns = document.querySelectorAll('.space-type-pill');

      let originalRows: any[] = [];
      if (dataTag && dataTag.textContent) {
        try {
          originalRows = JSON.parse(dataTag.textContent);
        } catch (e) {
          originalRows = [];
        }
      }

      let activeSpaceType = 'All spaces';
      let currentMetric = 'views';
      let searchQuery = '';

      function applyFilters() {
        let filtered = [...originalRows];

        // Filter by Space Type
        if (activeSpaceType && activeSpaceType !== 'All spaces') {
          filtered = filtered.filter(r => (r.spaceType || '').toLowerCase() === activeSpaceType.toLowerCase());
        }

        // Filter by search query
        if (searchQuery) {
          filtered = filtered.filter(r =>
            (r.name && r.name.toLowerCase().includes(searchQuery)) ||
            (r.tagline && r.tagline.toLowerCase().includes(searchQuery)) ||
            (r.founderName && r.founderName.toLowerCase().includes(searchQuery)) ||
            (r.spaceType && r.spaceType.toLowerCase().includes(searchQuery))
          );
        }

        // Sort by metric
        if (currentMetric === 'views') {
          filtered.sort((a, b) => (b.mrr || 0) - (a.mrr || 0));
        } else if (currentMetric === 'rate') {
          filtered.sort((a, b) => (b.mrr || 0) - (a.mrr || 0));
        } else if (currentMetric === 'cpm') {
          filtered.sort((a, b) => (a.mrr || 0) - (b.mrr || 0));
        } else if (currentMetric === 'available') {
          // All rows are available
        }

        renderRows(filtered, searchQuery);

        // Filter deal cards
        document.querySelectorAll('.space-card').forEach(card => {
          const cardEl = card as HTMLElement;
          const cardType = cardEl.getAttribute('data-space-type') || '';
          if (activeSpaceType === 'All spaces' || cardType.toLowerCase() === activeSpaceType.toLowerCase()) {
            cardEl.style.display = '';
          } else {
            cardEl.style.display = 'none';
          }
        });
      }

      // Space type pill selection
      pillBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          pillBtns.forEach((b) => {
            b.className = 'space-type-pill px-3 py-1.5 rounded-xl text-xs font-medium transition-all whitespace-nowrap cursor-pointer text-zinc-400 hover:text-white hover:bg-zinc-800/60';
          });
          btn.className = 'space-type-pill px-3 py-1.5 rounded-xl text-xs font-medium transition-all whitespace-nowrap cursor-pointer bg-[#272932] text-white shadow-sm font-semibold';
          activeSpaceType = btn.getAttribute('data-space-type') || 'All spaces';
          applyFilters();
        });
      });

      // Dropdown toggle logic
      metricBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        metricMenu?.classList.toggle('hidden');
        timeframeMenu?.classList.add('hidden');
      });

      timeframeBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        timeframeMenu?.classList.toggle('hidden');
        metricMenu?.classList.add('hidden');
      });

      document.addEventListener('click', () => {
        metricMenu?.classList.add('hidden');
        timeframeMenu?.classList.add('hidden');
      });

      // Metric choice selection
      document.querySelectorAll('.metric-choice').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const metricKey = target.getAttribute('data-metric') || 'views';
          if (metricLabel) metricLabel.textContent = target.textContent?.trim() || 'Monthly Views';
          metricMenu?.classList.add('hidden');
          currentMetric = metricKey;
          applyFilters();
        });
      });

      // Timeframe choice selection
      document.querySelectorAll('.timeframe-choice').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          if (timeframeLabel) timeframeLabel.textContent = target.textContent?.trim() || 'All time';
          timeframeMenu?.classList.add('hidden');
        });
      });

      // Real-time live search filtering
      searchInput?.addEventListener('input', () => {
        searchQuery = (searchInput.value || '').toLowerCase().trim();
        applyFilters();
      });

      // Pressing Enter in search navigates to Marketplace Browser
      searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const q = (searchInput.value || '').trim();
          if (q) {
            window.location.href = `/browser?q=${encodeURIComponent(q)}`;
          }
        }
      });

      function attachImageErrorHandlers() {
        document.querySelectorAll('.founder-avatar-img').forEach((img) => {
          img.addEventListener('error', function() {
            (this as HTMLImageElement).src = 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><circle cx="16" cy="16" r="16" fill="%2327272a"/><circle cx="16" cy="12" r="5" fill="%2371717a"/><path d="M7 28c0-5 4-8 9-8s9 3 9 8z" fill="%2371717a"/></svg>';
          });
        });

        document.querySelectorAll('.startup-card-logo').forEach((img) => {
          img.addEventListener('error', function() {
            (this as HTMLImageElement).src = 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" rx="14" fill="%2327272a"/><text x="32" y="42" font-family="sans-serif" font-size="28" font-weight="bold" fill="%2310b981" text-anchor="middle">S</text></svg>';
          });
        });
      }

      function renderRows(rows: any[], query = '') {
        if (!tbody) return;

        if (rows.length === 0) {
          tbody.innerHTML = `
            <tr>
              <td colspan="5" class="py-12 text-center text-zinc-500 text-xs">
                No developer ad spaces found matching "${query || activeSpaceType}". Try another search term or filter.
              </td>
            </tr>
          `;
          return;
        }

        tbody.innerHTML = rows.map((row) => `
          <tr class="hover:bg-[#181920] transition-colors group cursor-pointer startup-row">
            <td class="py-3.5 px-4 text-center font-mono text-xs">
              ${row.medal ? `<span class="text-base inline-block leading-none" title="Rank #${row.rank}">${row.medal}</span>` : `<span class="text-zinc-500 font-medium">${row.rank}</span>`}
            </td>
            <td class="py-3.5 px-4">
              <a href="/startup/${row.slug}" class="flex items-center gap-3">
                <img
                  src="${row.logo}"
                  alt="${row.name}"
                  class="w-8 h-8 rounded-xl object-cover bg-zinc-800 border border-[#272a33] shrink-0"
                />
                <div class="min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="font-bold text-xs sm:text-[13px] text-white ${row.isBlurred ? 'filter blur-[4px] select-none text-zinc-300' : 'group-hover:text-blue-400 transition-colors'}">
                      ${row.name}
                    </span>
                    <span class="px-1.5 py-0.2 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[8px] font-bold tracking-wider uppercase">
                      AVAILABLE
                    </span>
                  </div>
                  ${row.tagline ? `
                    <div class="text-[11px] text-zinc-500 truncate max-w-xs sm:max-w-sm mt-0.5 ${row.isBlurred ? 'filter blur-[4px] select-none text-zinc-600' : ''}">
                      ${row.tagline}
                    </div>
                  ` : ''}
                </div>
              </a>
            </td>
            <td class="py-3.5 px-4">
              <div class="flex flex-col items-start gap-1">
                <span class="px-2 py-0.5 rounded-md bg-blue-500/10 border border-blue-500/20 text-blue-400 font-semibold text-[11px] inline-block">
                  ${row.spaceType || 'Documentation'}
                </span>
                <span class="text-[10px] text-zinc-500 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  Direct UI slot
                </span>
              </div>
            </td>
            <td class="py-3.5 px-4 text-right font-mono">
              <span class="font-bold text-white text-xs sm:text-[13px]">${row.impressionsFormatted || row.mrrFormatted}</span>
              <svg class="w-2.5 h-2.5 text-blue-400 inline-block ml-1 align-baseline" viewBox="0 0 24 24" fill="currentColor" title="Verified Analytics Views"><path d="M12 4L3 20h18L12 4z"/></svg>
              <span class="text-[10px] text-zinc-500 block font-sans">verified/mo</span>
            </td>
            <td class="py-3.5 px-4 text-right font-medium text-xs sm:text-[13px]">
              <span class="text-emerald-400 font-bold block">${row.priceFormatted || '$1,200/mo'}</span>
              <span class="text-[10px] text-zinc-500 font-mono block">${row.cpmFormatted || '$15 CPM'}</span>
            </td>
          </tr>
        `).join('');

        attachImageErrorHandlers();
      }

      attachImageErrorHandlers();
    }

    setupInteractions();
  </script>
</TrustMrrLayout>
