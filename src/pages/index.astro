        <span class="text-xl">📌</span>
        <span class="font-black text-sm tracking-wide">STICKY WALL</span>
        <span class="text-xs px-2 py-0.5 rounded-full bg-[#1a30c0] text-[#faf7ee] font-mono2 font-bold" id="note-count-badge">50 notes</span>
        <span class="text-xs text-[#059669] font-bold font-mono2 hidden sm:inline">$100 wall value</span>
