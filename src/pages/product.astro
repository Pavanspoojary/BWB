---
import '@astrojs/tailwind/base.css';

const title = "Elevator Hunt // The Product Pitch | builtwhilebroke.tech";
const description = "Step into the elevator. Each floor is a ranked product. The walls are covered in sharpie graffiti. Pay $10 to get your URL on the wall.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23faf7ee' stroke='%231a30c0' stroke-width='2'/><path d='M6 8h20M6 14h20M6 20h20M6 26h20' stroke='%231a30c0' stroke-opacity='0.25' stroke-width='1.5'/><circle cx='10' cy='6' r='2' fill='%23d02030'/></svg>" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7ee" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Architects+Daughter&family=Caveat:wght@600;700&family=Kalam:wght@700&family=Patrick+Hand&family=Plus+Jakarta+Sans:wght@500;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root {
        --paper-bg: #faf7ee;
        --ink-blue: #1a30c0;
        --ink-red: #d02030;
      }

      body {
        font-family: 'Patrick Hand', cursive, sans-serif;
        background-color: #1a1a2e;
        color: #1a30c0;
        min-height: 100vh;
        overflow: hidden;
      }

      .font-mono2 { font-family: 'JetBrains Mono', monospace !important; }
      .font-hand2 { font-family: 'Caveat', cursive, sans-serif !important; }
      .font-doodle { font-family: 'Patrick Hand', cursive, sans-serif !important; }

      /* Floor button styles */
      .floor-btn {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        border: 3px solid #1a30c0;
        background: #faf7ee;
        color: #1a30c0;
        font-family: 'Patrick Hand', cursive, sans-serif;
        font-size: 22px;
        font-weight: 900;
        cursor: pointer;
        transition: all 0.15s ease;
        box-shadow: 0 4px 0 0 #0f1c75;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .floor-btn:hover {
        background: #1a30c0;
        color: #faf7ee;
        transform: translateY(2px);
        box-shadow: 0 2px 0 0 #0f1c75;
      }
      .floor-btn:active {
        transform: translateY(4px);
        box-shadow: none;
      }
      .floor-btn.active {
        background: #d02030;
        border-color: #d02030;
        color: #faf7ee;
        box-shadow: 0 4px 0 0 #8c111c;
      }
      .floor-btn.penthouse {
        background: linear-gradient(135deg, #d02030 0%, #ea580c 100%);
        border-color: #d02030;
        color: #faf7ee;
        font-size: 14px;
        width: 64px;
        height: 64px;
        box-shadow: 0 4px 0 0 #8c111c, 0 0 20px rgba(208,32,48,.3);
      }

      /* Screen panel */
      .screen-panel {
        background: #0a0a1a;
        border: 3px solid #1a30c0;
        border-radius: 16px;
        padding: 20px;
        color: #faf7ee;
        font-family: 'JetBrains Mono', monospace;
        min-height: 280px;
        position: relative;
        overflow: hidden;
      }
      .screen-panel::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(26,48,192,0.08) 0%, transparent 50%, rgba(26,48,192,0.05) 100%);
        pointer-events: none;
      }
      .screen-scanline {
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(26,48,192,0.03) 2px,
          rgba(26,48,192,0.03) 4px
        );
        pointer-events: none;
      }

      /* Graffiti overlay */
      .graffiti-wall {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
      }
      .graffiti-tag {
        position: absolute;
        font-family: 'Caveat', cursive;
        font-weight: 700;
        opacity: 0.15;
        white-space: nowrap;
        transform: rotate(var(--rot, 0deg));
      }

      /* Sharpie prompt */
      .sharpie-prompt {
        background: rgba(250,247,238,0.95);
        border: 2px dashed #1a30c0;
        border-radius: 12px;
        padding: 12px 16px;
        font-family: 'Caveat', cursive;
      }

      /* Mute toggle */
      .mute-btn {
        position: fixed;
        top: 16px;
        right: 16px;
        z-index: 60;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 2px solid #1a30c0;
        background: rgba(250,247,238,0.95);
        color: #1a30c0;
        font-size: 20px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 12px rgba(26,48,192,0.2);
        transition: all 0.15s;
      }
      .mute-btn:hover {
        background: #1a30c0;
        color: #faf7ee;
      }
    </style>
  </head>
  <body class="min-h-screen text-[#1a30c0] antialiased overflow-hidden">

    <!-- Fullscreen 3D elevator cab -->
    <canvas id="elevator-canvas" class="fixed inset-0 w-full h-full block z-0"></canvas>

    <!-- Graffiti wall overlay (scattered maker URLs) -->
    <div id="graffiti-wall" class="graffiti-wall z-10"></div>

    <!-- Mute button -->
    <button id="btn-mute" class="mute-btn" title="Toggle elevator jazz">🎷</button>

    <!-- Main overlay -->
    <div class="fixed inset-0 z-20 flex items-end sm:items-center justify-center p-3 sm:p-6 pointer-events-none">
      <div class="w-full max-w-5xl pointer-events-auto">

        <!-- Floor panel + screen layout -->
        <div class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-4 items-end">

          <!-- Floor panel (left side on desktop, bottom on mobile) -->
          <div class="bg-[#faf7ee]/95 border-[3px] border-[#1a30c0] rounded-[24px] p-4 shadow-[0_18px_50px_rgba(26,48,192,0.3)] backdrop-blur-sm">
            <div class="text-center mb-3">
              <div class="text-[10px] uppercase tracking-wider text-[#1a30c0]/60 font-bold font-mono2">Floor</div>
              <div id="current-floor" class="text-3xl font-black text-[#d02030] font-mono2">1</div>
            </div>
            <div class="grid grid-cols-5 gap-2 justify-items-center">
              <button class="floor-btn active" data-floor="1">1</button>
              <button class="floor-btn" data-floor="2">2</button>
              <button class="floor-btn" data-floor="3">3</button>
              <button class="floor-btn" data-floor="4">4</button>
              <button class="floor-btn" data-floor="5">5</button>
              <button class="floor-btn" data-floor="6">6</button>
              <button class="floor-btn" data-floor="7">7</button>
              <button class="floor-btn" data-floor="8">8</button>
              <button class="floor-btn" data-floor="9">9</button>
              <button class="floor-btn" data-floor="10">10</button>
            </div>
            <div class="flex justify-center mt-3">
              <button class="floor-btn penthouse" data-floor="100">🏰 PH</button>
            </div>
            <div class="text-center mt-3 text-[11px] text-[#1a30c0]/60 font-mono2">
              Penthouse = <span id="penthouse-bid" class="text-[#d02030] font-bold">$10</span>
            </div>
          </div>

          <!-- Screen + listing form -->
          <div class="space-y-3">
            <!-- Digital screen -->
            <div class="screen-panel" id="screen-panel">
              <div class="screen-scanline"></div>
              <div id="screen-content" class="relative z-10">
                <div class="text-[10px] uppercase tracking-wider text-[#059669] font-bold mb-2 font-mono2">▲ Floor 1 — #1 Product</div>
                <div id="screen-name" class="text-2xl sm:text-3xl font-black text-[#faf7ee] leading-tight mb-2">Welcome aboard</div>
                <div id="screen-tagline" class="text-sm sm:text-base text-[#faf7ee]/70 mb-4">Select a floor to view that ranked product's pitch.</div>
                <div id="screen-meta" class="flex gap-3 text-xs text-[#faf7ee]/50 font-mono2">
                  <span id="screen-votes">▲ 0 votes</span>
                  <span id="screen-maker">@maker</span>
                </div>
                <a id="screen-visit" href="#" target="_blank" rel="noopener noreferrer" class="hidden mt-4 inline-block px-5 py-2 rounded-xl bg-[#059669] hover:bg-[#047857] text-white font-bold text-sm transition-all">
                  Visit product ↗
                </a>
                <button id="screen-vote-btn" class="hidden mt-4 inline-block px-5 py-2 rounded-xl bg-[#d02030] hover:bg-[#b51826] text-white font-bold text-sm transition-all cursor-pointer">
                  ▲ Upvote this product
                </button>
              </div>
            </div>

            <!-- Stats bar -->
            <div class="flex gap-2 text-xs font-bold font-mono2">
              <div class="px-3 py-1.5 rounded-xl border-2 border-[#1a30c0] bg-[#faf7ee]/95 backdrop-blur-sm">
                <span class="text-[#1a30c0]/60">PRODUCTS:</span>
                <span id="stat-products" class="text-[#1a30c0]">0</span>
              </div>
              <div class="px-3 py-1.5 rounded-xl border-2 border-[#1a30c0] bg-[#faf7ee]/95 backdrop-blur-sm">
                <span class="text-[#1a30c0]/60">▲ UPVOTES:</span>
                <span id="stat-upvotes" class="text-[#d02030]">0</span>
              </div>
              <div class="px-3 py-1.5 rounded-xl border-2 border-dashed border-[#059669] text-[#059669] bg-[#faf7ee]/95 backdrop-blur-sm">
                FLOOR FEE: $0 ✍️
              </div>
              <div class="px-3 py-1.5 rounded-xl border-2 border-[#1a30c0]/40 bg-[#faf7ee]/95 backdrop-blur-sm font-mono2 flex items-center gap-2">
                <span id="db-dot" class="inline-block w-2 h-2 rounded-full bg-[#1a30c0]/30"></span>
                <span id="db-status" class="text-[#1a30c0]/70">connecting…</span>
              </div>
            </div>

            <!-- Listing form (collapsible) -->
            <details class="bg-[#faf7ee]/95 border-[3px] border-[#1a30c0] rounded-[20px] shadow-[0_14px_40px_rgba(26,48,192,0.2)] backdrop-blur-sm group">
              <summary class="px-5 py-3 cursor-pointer font-black text-lg text-[#1a30c0] select-none hover:text-[#d02030] transition-colors">
                ✏️ LIST YOUR PRODUCT — $0
              </summary>
              <div class="px-5 pb-5">
                <form id="list-form" class="space-y-3">
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-sm font-bold mb-1" for="f-name">Product name *</label>
                      <input id="f-name" required maxlength="40" placeholder="e.g. ShipLog" class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#1a30c0] text-[#1a30c0] placeholder-[#1a30c0]/40 text-base font-bold focus:outline-none focus:border-[#d02030]" />
                    </div>
                    <div>
                      <label class="block text-sm font-bold mb-1" for="f-tagline">One-line pitch *</label>
                      <input id="f-tagline" required maxlength="80" placeholder="e.g. Changelog-as-a-service" class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#1a30c0] text-[#1a30c0] placeholder-[#1a30c0]/40 text-base focus:outline-none focus:border-[#d02030]" />
                    </div>
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-sm font-bold mb-1" for="f-url">Website</label>
                      <input id="f-url" type="url" maxlength="120" placeholder="https://yourproduct.com" class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#1a30c0] text-[#1a30c0] placeholder-[#1a30c0]/40 text-base focus:outline-none focus:border-[#d02030]" />
                    </div>
                    <div>
                      <label class="block text-sm font-bold mb-1" for="f-maker">Maker handle</label>
                      <input id="f-maker" maxlength="30" placeholder="@you" class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#1a30c0] text-[#1a30c0] placeholder-[#1a30c0]/40 text-base focus:outline-none focus:border-[#d02030]" />
                    </div>
                  </div>
                  <button type="submit" class="w-full py-3 rounded-2xl bg-[#d02030] hover:bg-[#b51826] text-white font-black text-xl transition-all shadow-[0_4px_0_0_#8c111c] hover:shadow-[0_2px_0_0_#8c111c] hover:translate-y-[2px] cursor-pointer -rotate-1">
                    🚀 LIST FOR $0
                  </button>
                </form>
              </div>
            </details>

            <!-- Sharpie wall prompt -->
            <div class="sharpie-prompt">
              <div class="flex items-center justify-between gap-3 flex-wrap">
                <div>
                  <div class="text-lg font-bold text-[#1a30c0]">🖊️ Sharpie your URL on the elevator wall</div>
                  <div class="text-sm text-[#1a30c0]/70">$10 one-time · your maker URL scrawled on the cab walls forever</div>
                </div>
                <button id="btn-sharpie" class="px-5 py-2 rounded-xl bg-[#1a30c0] hover:bg-[#142699] text-white font-black text-sm transition-all shadow-[0_3px_0_0_#0f1c75] hover:shadow-[0_1px_0_0_#0f1c75] hover:translate-y-[2px] cursor-pointer whitespace-nowrap">
                  $10 SHARPIE MY URL
                </button>
              </div>
            </div>

            <!-- Back home -->
            <div class="text-center">
              <a href="/" class="text-xs text-[#faf7ee]/50 hover:text-[#faf7ee] transition-colors font-mono2">← back to builtwhilebroke.tech</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sharpie purchase modal -->
    <div id="sharpie-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="w-full max-w-md bg-[#faf7ee] border-[3px] border-[#1a30c0] rounded-[28px] p-6 shadow-2xl relative font-[Patrick_Hand,cursive] -rotate-1 text-[#1a30c0]">
        <button id="btn-close-sharpie" type="button" class="absolute top-4 right-4 text-2xl font-bold text-[#1a30c0] hover:text-[#d02030] cursor-pointer">✕</button>
        <h3 class="text-2xl font-black mb-2">🖊️ Sharpie Your URL</h3>
        <p class="text-sm text-[#1a30c0]/70 mb-4">Your maker URL gets hand-scrawled on the elevator cab walls. One-time $10 fee. Permanent placement.</p>
        <div>
          <label class="block text-sm font-bold mb-1" for="sharpie-url">Your URL (e.g. github.com/you)</label>
          <input id="sharpie-url" type="url" maxlength="80" placeholder="https://yourproduct.com" class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#1a30c0] text-[#1a30c0] placeholder-[#1a30c0]/40 text-base font-bold focus:outline-none focus:border-[#d02030]" />
        </div>
        <button id="btn-confirm-sharpie" class="w-full mt-4 py-3 rounded-2xl bg-[#d02030] hover:bg-[#b51826] text-white font-black text-lg transition-all shadow-[0_4px_0_0_#8c111c] cursor-pointer">
          PAY $10 & SHARPIE IT
        </button>
        <p class="text-[11px] text-[#1a30c0]/50 mt-2 text-center font-mono2">Stripe checkout · secure payment</p>
      </div>
    </div>

  <script>
    import * as THREE from 'three';
    import { DoodleEngine } from '../components/doodle/DoodleEngine';
    import { CityBuilder } from '../components/doodle/CityBuilder';
    import { ElevatorCab } from '../components/doodle/ElevatorCab';
    import { ElevatorAudioDrone } from '../components/doodle/ElevatorAudio';
    import { supabase } from '../lib/supabase';

    interface HuntProduct {
      id: string;
      name: string;
      tagline: string;
      url: string;
      maker: string;
      upvotes: number;
      custom?: boolean;
    }

    const SEEDS: HuntProduct[] = [
      { id: "seed-doodleboard", name: "DoodleBoard", tagline: "Trello for people who think in sketches", url: "https://builtwhilebroke.tech", maker: "@builtwhilebroke", upvotes: 2314 },
      { id: "seed-shiplog", name: "ShipLog", tagline: "Changelog-as-a-service for indie hackers", url: "", maker: "@pavan", upvotes: 1892 },
      { id: "seed-brokeauth", name: "BrokeAuth", tagline: "Auth via Telegram DMs. Do not ask how.", url: "", maker: "@anon", upvotes: 1204 },
      { id: "seed-cachemoney", name: "CacheMoney", tagline: "Redis on a Raspberry Pi under someone's desk", url: "", maker: "@homelab", upvotes: 866 },
      { id: "seed-midnightdb", name: "MidnightDB", tagline: "SQLite with delusions of grandeur", url: "", maker: "@sqlitefan", upvotes: 542 },
    ];
    const LS_PRODUCTS = "bwb_products";
    const LS_VOTES = "bwb_product_votes";
    const LS_VOTER = "bwb_voter";

    let MODE: "db" | "local" = "db";
    let voterId = "";
    let currentFloor = 1;
    let products: HuntProduct[] = [];
    let votes: string[] = [];

    function loadJSON(key: string, fallback: any): any {
      try {
        const raw = localStorage.getItem(key);
        return raw ? JSON.parse(raw) : fallback;
      } catch {
        return fallback;
      }
    }
    function saveJSON(key: string, val: any): void {
      try { localStorage.setItem(key, JSON.stringify(val)); } catch { /* private mode */ }
    }
    function getVoterId(): string {
      let v = loadJSON(LS_VOTER, "") as string;
      if (!v) {
        v = "v_" + Date.now().toString(36) + Math.random().toString(36).slice(2, 12);
        saveJSON(LS_VOTER, v);
      }
      return v;
    }
    function setStatus(live: boolean): void {
      const dot = document.getElementById("db-dot");
      const txt = document.getElementById("db-status");
      if (dot) dot.className = "inline-block w-2 h-2 rounded-full " + (live ? "bg-[#059669]" : "bg-[#d02030]");
      if (txt) txt.textContent = live ? "live · shared board" : "offline · local view";
    }
    function esc(s: string | number | undefined): string {
      return String(s ?? "").replace(/[&<>"']/g, (c: string) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string));
    }

    async function dbLoad(): Promise<{ products: HuntProduct[]; votes: string[] } | null> {
      try {
        const { data, error } = await (supabase as any)
          .from("products")
          .select("id, name, tagline, url, maker, base_upvotes, created_at, product_votes(count)")
          .order("created_at", { ascending: true });
        if (error || !data) return null;
        const mine = await (supabase as any)
          .from("product_votes")
          .select("product_id")
          .eq("voter", voterId);
        const v: string[] = !mine.error && mine.data ? mine.data.map((r: any) => r.product_id) : [];
        const prods: HuntProduct[] = (data as any[]).map((row: any) => ({
          id: String(row.id),
          name: String(row.name ?? "Untitled"),
          tagline: String(row.tagline ?? ""),
          url: String(row.url ?? ""),
          maker: String(row.maker ?? "@anon"),
          upvotes: Number(row.base_upvotes ?? 0) + Number(row.product_votes?.[0]?.count ?? 0),
          custom: true,
        }));
        prods.sort((a, b) => b.upvotes - a.upvotes);
        return { products: prods, votes: v };
      } catch {
        return null;
      }
    }

    function localLoad(): { products: HuntProduct[]; votes: string[] } {
      const customs = loadJSON(LS_PRODUCTS, []) as HuntProduct[];
      const byId = new Map<string, HuntProduct>();
      for (const p of SEEDS) byId.set(p.id, { ...p });
      for (const p of customs) byId.set(p.id, { ...p });
      const prods = [...byId.values()].sort((a, b) => b.upvotes - a.upvotes);
      return { products: prods, votes: loadJSON(LS_VOTES, []) as string[] };
    }

    async function refresh(): Promise<void> {
      if (MODE === "db") {
        const loaded = await dbLoad();
        if (!loaded) {
          MODE = "local";
          setStatus(false);
          const fb = localLoad();
          products = fb.products;
          votes = fb.votes;
        } else {
          setStatus(true);
          products = loaded.products;
          votes = loaded.votes;
        }
      } else {
        const fb = localLoad();
        products = fb.products;
        votes = fb.votes;
      }
      updateStats();
      updateScreen();
    }

    function updateStats(): void {
      const totalVotes = products.reduce((n: number, p: HuntProduct) => n + p.upvotes, 0);
      const el1 = document.getElementById("stat-products");
      const el2 = document.getElementById("stat-upvotes");
      if (el1) el1.textContent = String(products.length);
      if (el2) el2.textContent = totalVotes.toLocaleString();
    }

    function updateScreen(): void {
      const p = products[currentFloor - 1];
      const floorEl = document.getElementById("current-floor");
      const nameEl = document.getElementById("screen-name");
      const tagEl = document.getElementById("screen-tagline");
      const votesEl = document.getElementById("screen-votes");
      const makerEl = document.getElementById("screen-maker");
      const visitEl = document.getElementById("screen-visit");
      const metaEl = document.getElementById("screen-meta");

      if (floorEl) floorEl.textContent = String(currentFloor);

      if (p) {
        const rank = currentFloor;
        const headerEl = document.querySelector("#screen-content > div:first-child") as HTMLElement;
        if (headerEl) headerEl.textContent = `▲ Floor ${rank} — #${rank} Product`;
        if (nameEl) nameEl.textContent = p.name;
        if (tagEl) tagEl.textContent = p.tagline || "No pitch yet.";
        if (votesEl) votesEl.textContent = `▲ ${p.upvotes.toLocaleString()} votes`;
        if (makerEl) makerEl.textContent = p.maker || "@anon";
        if (visitEl) {
          const rawUrl = p.url?.trim() ?? "";
          const href = rawUrl ? (/^https?:\/\//i.test(rawUrl) ? rawUrl : `https://${rawUrl}`) : "";
          if (href) {
            (visitEl as HTMLAnchorElement).href = href;
            visitEl.classList.remove("hidden");
          } else {
            visitEl.classList.add("hidden");
          }
        }
        if (metaEl) metaEl.classList.remove("hidden");
        // Vote button
        const voteBtnEl = document.getElementById("screen-vote-btn");
        if (voteBtnEl) {
          voteBtnEl.classList.remove("hidden");
          const voted = votes.includes(p.id);
          voteBtnEl.textContent = voted ? "✓ Voted — tap to remove" : "▲ Upvote this product";
          voteBtnEl.onclick = () => { void toggleVote(p.id); };
        }
      } else {
        const headerEl = document.querySelector("#screen-content > div:first-child") as HTMLElement;
        if (headerEl) headerEl.textContent = `▲ Floor ${currentFloor} — Empty`;
        if (nameEl) nameEl.textContent = "No product on this floor yet";
        if (tagEl) tagEl.textContent = "Be the first to list. The elevator is waiting.";
        if (votesEl) votesEl.textContent = "";
        if (makerEl) makerEl.textContent = "";
        if (visitEl) visitEl.classList.add("hidden");
        if (metaEl) metaEl.classList.add("hidden");
        const voteBtnEl = document.getElementById("screen-vote-btn");
        if (voteBtnEl) voteBtnEl.classList.add("hidden");
      }
    }

    async function toggleVote(id: string): Promise<void> {
      if (MODE === "db") {
        try {
          const mine = await (supabase as any)
            .from("product_votes")
            .select("id")
            .eq("product_id", id)
            .eq("voter", voterId)
            .maybeSingle();
          if (mine.data) {
            await (supabase as any).from("product_votes").delete().eq("id", mine.data.id);
          } else {
            await (supabase as any).from("product_votes").insert({ product_id: id, voter: voterId });
          }
          await refresh();
          return;
        } catch {
          MODE = "local";
          setStatus(false);
        }
      }
      const customs = loadJSON(LS_PRODUCTS, []) as HuntProduct[];
      let target = customs.find((pp: HuntProduct) => pp.id === id);
      if (!target) {
        const seed = SEEDS.find((pp: HuntProduct) => pp.id === id);
        if (!seed) return;
        target = { ...seed };
        customs.unshift(target);
      }
      const vs = loadJSON(LS_VOTES, []) as string[];
      if (vs.includes(id)) {
        target.upvotes = Math.max(0, target.upvotes - 1);
        saveJSON(LS_VOTES, vs.filter((v: string) => v !== id));
      } else {
        target.upvotes += 1;
        vs.push(id);
        saveJSON(LS_VOTES, vs);
      }
      saveJSON(LS_PRODUCTS, customs);
      await refresh();
    }

    async function submitListing(name: string, tagline: string, url: string, maker: string): Promise<string | null> {
      if (MODE === "db") {
        try {
          const { data, error } = await (supabase as any)
            .from("products")
            .insert({ name, tagline, url, maker })
            .select("id")
            .single();
          if (!error && data) return String(data.id);
          MODE = "local";
          setStatus(false);
        } catch {
          MODE = "local";
          setStatus(false);
        }
      }
      const customs = loadJSON(LS_PRODUCTS, []) as HuntProduct[];
      const newId = "user-" + Date.now().toString(36);
      customs.unshift({ id: newId, name, tagline, url, maker, upvotes: 0, custom: true });
      saveJSON(LS_PRODUCTS, customs);
      return newId;
    }

    // ---- Graffiti wall: scatter maker URLs across the overlay ----
    function renderGraffiti(tags: string[]) {
      const wall = document.getElementById("graffiti-wall");
      if (!wall) return;
      wall.innerHTML = "";
      const colors = ["#1a30c0", "#d02030", "#059669", "#ea580c"];
      tags.forEach((tag, i) => {
        const el = document.createElement("div");
        el.className = "graffiti-tag";
        el.textContent = tag;
        el.style.left = `${5 + (i * 37) % 85}%`;
        el.style.top = `${8 + (i * 53) % 80}%`;
        el.style.setProperty("--rot", `${-12 + (i * 7) % 24}deg`);
        el.style.fontSize = `${14 + (i % 4) * 4}px`;
        el.style.color = colors[i % colors.length];
        wall.appendChild(el);
      });
    }

    const GRAFFITI_TAGS = [
      "doodle.city/launch", "wrap.dev/start", "rail.st/ship", "pod.dev/open",
      "hack.am/go", "split.run/now", "seed.spot/build", "sharpie.dev/tag",
      "maker.fun/online", "craft.sh/go", "builtwhilebroke.tech", "ship.now/live",
      "stab.you/early", "drawn.io/start", "auth.via/tg", "canyon.dev/scene",
      "hackbroke.dev", "shipit.glitch", "nomoney.dev", "founder.exe",
    ];

    // ---- 3D elevator cab bootstrap ----
    function bootCab() {
      const canvas = document.getElementById("elevator-canvas") as HTMLCanvasElement;
      if (!canvas) return;
      const engine = new DoodleEngine({ canvas });
      const city = new CityBuilder(engine);
      new ElevatorCab(engine, city);

      // Position camera facing the closed doors from inside the cab
      engine.camera.position.set(0, 5.5, 4);
      engine.camera.lookAt(new THREE.Vector3(0, 5.5, -3));

      let lastTime = performance.now();
      function animate(time: number) {
        requestAnimationFrame(animate);
        const delta = Math.min((time - lastTime) / 1000, 0.1);
        lastTime = time;
        engine.render(delta);
      }
      requestAnimationFrame(animate);
    }

    // ---- Floor panel interaction ----
    function bootFloorPanel() {
      const elevatorAudio = new ElevatorAudioDrone();
      let audioStarted = false;

      document.querySelectorAll(".floor-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const floor = parseInt(btn.getAttribute("data-floor") || "1", 10);
          if (floor === currentFloor) return;

          // Start audio on first interaction
          if (!audioStarted) {
            elevatorAudio.start();
            audioStarted = true;
          }

          // Bell ding
          elevatorAudio.ding();

          // Fanfare for penthouse
          if (floor === 100) {
            setTimeout(() => elevatorAudio.fanfare(), 300);
          }

          currentFloor = floor;

          // Update active button
          document.querySelectorAll(".floor-btn").forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");

          updateScreen();
        });
      });

      // Mute toggle
      const muteBtn = document.getElementById("btn-mute");
      muteBtn?.addEventListener("click", () => {
        if (!audioStarted) {
          elevatorAudio.start();
          audioStarted = true;
        }
        const muted = elevatorAudio.toggle();
        if (muteBtn) muteBtn.textContent = muted ? "🔇" : "🎷";
      });

      // Keyboard: 1-9, 0 = 10
      window.addEventListener("keydown", (e) => {
        const tag = (e.target as HTMLElement)?.tagName?.toLowerCase();
        if (tag === "input" || tag === "textarea") return;
        if (e.key >= "1" && e.key <= "9") {
          const floor = parseInt(e.key, 10);
          if (floor !== currentFloor) {
            if (!audioStarted) { elevatorAudio.start(); audioStarted = true; }
            elevatorAudio.ding();
            currentFloor = floor;
            document.querySelectorAll(".floor-btn").forEach((b) => b.classList.remove("active"));
            document.querySelector(`.floor-btn[data-floor="${floor}"]`)?.classList.add("active");
            updateScreen();
          }
        } else if (e.key === "0") {
          if (currentFloor !== 10) {
            if (!audioStarted) { elevatorAudio.start(); audioStarted = true; }
            elevatorAudio.ding();
            currentFloor = 10;
            document.querySelectorAll(".floor-btn").forEach((b) => b.classList.remove("active"));
            document.querySelector('.floor-btn[data-floor="10"]')?.classList.add("active");
            updateScreen();
          }
        } else if (e.key === "Escape") {
          window.location.href = "/";
        }
      });
    }

    // ---- Sharpie purchase modal ----
    function bootSharpieModal() {
      const modal = document.getElementById("sharpie-modal");
      const btnOpen = document.getElementById("btn-sharpie");
      const btnClose = document.getElementById("btn-close-sharpie");
      const btnConfirm = document.getElementById("btn-confirm-sharpie");
      const urlInput = document.getElementById("sharpie-url") as HTMLInputElement | null;

      btnOpen?.addEventListener("click", () => modal?.classList.remove("hidden"));
      btnClose?.addEventListener("click", () => modal?.classList.add("hidden"));
      modal?.addEventListener("click", (e) => { if (e.target === modal) modal.classList.add("hidden"); });
      btnConfirm?.addEventListener("click", () => {
        const url = urlInput?.value.trim();
        if (!url) return;
        // Store the sharpie tag locally (real payment integration later)
        const existing = loadJSON("bwb_sharpie_tags", []) as string[];
        existing.push(url);
        saveJSON("bwb_sharpie_tags", existing);
        renderGraffiti([...GRAFFITI_TAGS, ...existing]);
        modal?.classList.add("hidden");
        if (urlInput) urlInput.value = "";
        alert("🖊️ Sharpied! Your URL will appear on the cab walls.");
      });
    }

    // ---- Listing form ----
    function bootListingForm() {
      document.getElementById("list-form")?.addEventListener("submit", (e: Event) => {
        e.preventDefault();
        const form = e.target as HTMLFormElement;
        const name = (document.getElementById("f-name") as HTMLInputElement)?.value.trim().slice(0, 40) || "";
        const tagline = (document.getElementById("f-tagline") as HTMLInputElement)?.value.trim().slice(0, 80) || "Fresh out of the oven";
        const url = (document.getElementById("f-url") as HTMLInputElement)?.value.trim().slice(0, 120) || "";
        const maker = (document.getElementById("f-maker") as HTMLInputElement)?.value.trim().slice(0, 30) || "@anon";
        if (!name) return;
        void (async () => {
          const newId = await submitListing(name, tagline, url, maker);
          form.reset();
          await refresh();
          // Auto-navigate to the new product's floor
          if (newId) {
            const idx = products.findIndex((p) => p.id === newId);
            if (idx >= 0) {
              currentFloor = idx + 1;
              document.querySelectorAll(".floor-btn").forEach((b) => b.classList.remove("active"));
              document.querySelector(`.floor-btn[data-floor="${currentFloor}"]`)?.classList.add("active");
              updateScreen();
            }
          }
        })();
      });
    }

    // ---- Init ----
    voterId = getVoterId();
    bootCab();
    bootFloorPanel();
    bootSharpieModal();
    bootListingForm();
    renderGraffiti(GRAFFITI_TAGS);
    void refresh();
  </script>
  </body>
</html>
