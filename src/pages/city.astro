---
import DoodleLayout from "../layouts/DoodleLayout.astro";
---

<DoodleLayout title="Doodle City · 3D Sketch Ad Marketplace & City Builder" description="A 3D notebook-sketch city inspired by Doodle Shooter where you build buildings, place billboards, and buy/sell developer ad spaces.">
  <!-- Container filling viewport -->
  <div class="relative w-full h-[calc(100vh-100px)] min-h-[640px] rounded-3xl overflow-hidden border-2 border-[#1a30c0]/30 shadow-2xl bg-[#f6f3e6] select-none" id="doodle-city-container">
    
    <!-- 3D Canvas -->
    <canvas id="doodle-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing"></canvas>

    <!-- Handwritten Doodle HUD Overlay -->
    <div id="doodle-hud" class="absolute inset-0 pointer-events-none text-[#1a30c0]">
      
      <!-- Top Left: Title & Sound Toggle -->
      <div class="absolute left-6 top-5 pointer-events-auto flex items-start gap-4">
        <div>
          <h1 class="text-3xl sm:text-4xl font-black tracking-wide leading-none text-[#1a30c0] font-[Patrick_Hand,cursive] -rotate-1">
            DOODLE CITY <span class="text-sm font-normal px-2 py-0.5 rounded-full border border-[#1a30c0] text-[#1a30c0] align-middle">3D AD TYCOON</span>
          </h1>
          <p class="text-sm text-[#1a30c0]/80 font-[Patrick_Hand,cursive] mt-1">
            Build towers, place billboards & rent ad spaces inside a lined notebook.
          </p>
        </div>

        <button id="btn-sound-toggle" type="button" class="px-2.5 py-1 text-xs font-bold rounded-lg border-2 border-[#1a30c0] bg-[#faf7ee]/90 hover:bg-[#1a30c0] hover:text-[#faf7ee] transition-all font-[Patrick_Hand,cursive] shadow-sm" title="Toggle sound effects">
          🔊 Pen SFX: ON
        </button>
      </div>

      <!-- Top Right: City Revenue & Occupancy Metrics -->
      <div class="absolute right-6 top-5 pointer-events-auto text-right font-[Patrick_Hand,cursive] bg-[#faf7ee]/95 border-2 border-[#1a30c0] rounded-2xl p-3 shadow-md rotate-1">
        <div class="text-xs uppercase tracking-wider text-[#1a30c0]/70 font-bold">Monthly Ad Revenue</div>
        <div class="text-3xl sm:text-4xl font-black text-[#d02030] leading-none" id="metric-revenue">$4,520/mo</div>
        
        <div class="flex items-center justify-end gap-3 mt-1.5 text-xs text-[#1a30c0] pt-1.5 border-t border-[#1a30c0]/20">
          <span>Views: <b id="metric-views" class="text-[#d02030]">603K/mo</b></span>
          <span>·</span>
          <span>Leased: <b id="metric-slots" class="text-[#059669]">4 / 7</b></span>
        </div>
      </div>

      <!-- Top Center: Camera View Mode Switcher -->
      <div class="absolute left-1/2 -translate-x-1/2 top-5 pointer-events-auto flex items-center gap-1.5 p-1 bg-[#faf7ee]/90 border-2 border-[#1a30c0] rounded-xl shadow-md font-[Patrick_Hand,cursive]">
        <button id="btn-mode-orbit" type="button" class="px-3.5 py-1 rounded-lg text-sm font-bold bg-[#1a30c0] text-[#faf7ee] transition-all cursor-pointer">
          🛰️ God / Orbit View
        </button>
        <button id="btn-mode-walk" type="button" class="px-3.5 py-1 rounded-lg text-sm font-medium text-[#1a30c0] hover:bg-[#1a30c0]/10 transition-all cursor-pointer">
          🚶 1st-Person Walk (WASD)
        </button>
      </div>

      <!-- Walk Controls Helper Toast -->
      <div id="walk-helper" class="hidden absolute left-1/2 -translate-x-1/2 top-20 bg-[#faf7ee]/95 border border-[#1a30c0] text-[#1a30c0] px-4 py-1.5 rounded-full text-xs font-[Patrick_Hand,cursive] shadow-sm pointer-events-none">
        Use <b>W, A, S, D</b> to walk · Click &amp; drag mouse to look around · Click any billboard to inspect &amp; sponsor
      </div>

      <!-- Bottom Toolbar: Build & Placement Menu -->
      <div class="absolute left-1/2 -translate-x-1/2 bottom-5 pointer-events-auto flex items-center gap-2 p-2 bg-[#faf7ee]/95 border-2 border-[#1a30c0] rounded-2xl shadow-xl font-[Patrick_Hand,cursive] max-w-[95vw] overflow-x-auto">
        <span class="text-xs uppercase tracking-wider text-[#1a30c0]/70 font-bold px-1 hidden sm:inline">Tools:</span>
        
        <button type="button" class="tool-btn px-3 py-1.5 rounded-xl border-2 border-[#1a30c0] bg-[#1a30c0] text-[#faf7ee] font-bold text-xs flex items-center gap-1 cursor-pointer transition-all" data-tool="select">
          <span>🔍</span>
          <span>Inspect / Rent</span>
        </button>

        <button type="button" class="tool-btn px-3 py-1.5 rounded-xl border-2 border-[#1a30c0]/40 hover:border-[#1a30c0] text-[#1a30c0] font-semibold text-xs flex items-center gap-1 cursor-pointer transition-all hover:bg-[#1a30c0]/10" data-tool="skyscraper">
          <span>🏢</span>
          <span>Tower</span>
        </button>

        <button type="button" class="tool-btn px-3 py-1.5 rounded-xl border-2 border-[#1a30c0]/40 hover:border-[#1a30c0] text-[#1a30c0] font-semibold text-xs flex items-center gap-1 cursor-pointer transition-all hover:bg-[#1a30c0]/10" data-tool="indie-loft">
          <span>🏠</span>
          <span>Loft</span>
        </button>

        <button type="button" class="tool-btn px-3 py-1.5 rounded-xl border-2 border-[#1a30c0]/40 hover:border-[#1a30c0] text-[#1a30c0] font-semibold text-xs flex items-center gap-1 cursor-pointer transition-all hover:bg-[#1a30c0]/10" data-tool="crane-tower">
          <span>🏗️</span>
          <span>Crane</span>
        </button>

        <button type="button" class="tool-btn px-3 py-1.5 rounded-xl border-2 border-[#1a30c0]/40 hover:border-[#1a30c0] text-[#1a30c0] font-semibold text-xs flex items-center gap-1 cursor-pointer transition-all hover:bg-[#1a30c0]/10" data-tool="highway-billboard">
          <span>🪧</span>
          <span>Billboard</span>
        </button>

        <button type="button" class="tool-btn px-3 py-1.5 rounded-xl border-2 border-[#1a30c0]/40 hover:border-[#1a30c0] text-[#1a30c0] font-semibold text-xs flex items-center gap-1 cursor-pointer transition-all hover:bg-[#1a30c0]/10" data-tool="street-kiosk">
          <span>📱</span>
          <span>Kiosk</span>
        </button>

        <button type="button" class="tool-btn px-3 py-1.5 rounded-xl border-2 border-[#1a30c0]/40 hover:border-[#1a30c0] text-[#1a30c0] font-semibold text-xs flex items-center gap-1 cursor-pointer transition-all hover:bg-[#1a30c0]/10" data-tool="tree">
          <span>🌳</span>
          <span>Tree</span>
        </button>
      </div>
    </div>

    <!-- Ad Sponsor / Inspection Modal -->
    <div id="ad-modal" class="hidden absolute inset-0 z-50 bg-black/40 backdrop-blur-xs flex items-center justify-center p-4">
      <div class="w-full max-w-md bg-[#faf7ee] border-3 border-[#1a30c0] rounded-3xl p-6 shadow-2xl relative font-[Patrick_Hand,cursive] -rotate-1 text-[#1a30c0] animate-in fade-in zoom-in duration-150">
        
        <button id="btn-close-modal" type="button" class="absolute top-4 right-4 text-2xl font-bold text-[#1a30c0] hover:text-[#d02030] cursor-pointer">
          ✕
        </button>

        <div class="flex items-center gap-2 mb-1">
          <span class="text-xl">🪧</span>
          <span id="modal-category" class="text-xs uppercase font-bold tracking-wider px-2 py-0.5 rounded-md border border-[#1a30c0] bg-[#1a30c0]/10">
            Rooftop Billboard
          </span>
        </div>

        <h3 id="modal-title" class="text-2xl font-black text-[#1a30c0] leading-tight">
          Central Tech Tower - North Rooftop
        </h3>

        <!-- Metrics pill box -->
        <div class="grid grid-cols-2 gap-2 my-3 p-2.5 rounded-xl border-2 border-dashed border-[#1a30c0]/40 bg-white/70">
          <div>
            <div class="text-[11px] uppercase tracking-wider text-[#1a30c0]/70 font-bold">Monthly Views</div>
            <div id="modal-views" class="text-xl font-bold text-[#1a30c0]">140,000/mo</div>
          </div>
          <div>
            <div class="text-[11px] uppercase tracking-wider text-[#1a30c0]/70 font-bold">Asking Price</div>
            <div id="modal-price" class="text-xl font-bold text-[#d02030]">$1,200/mo</div>
          </div>
        </div>

        <form id="ad-sponsor-form" class="space-y-3 mt-4">
          <input type="hidden" id="modal-ad-id" value="" />
          
          <div>
            <label class="block text-sm font-bold mb-1">Your Brand / Company Name</label>
            <input
              type="text"
              id="input-brand-name"
              required
              placeholder="e.g. Supabase, Raycast, Bun"
              class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#1a30c0] text-[#1a30c0] placeholder-[#1a30c0]/40 text-base font-bold focus:outline-none focus:border-[#d02030]"
            />
          </div>

          <div>
            <label class="block text-sm font-bold mb-1">Headline / Tagline</label>
            <input
              type="text"
              id="input-tagline"
              required
              placeholder="e.g. Build in a weekend, scale to millions"
              class="w-full px-3 py-2 rounded-xl bg-white border-2 border-[#1a30c0] text-[#1a30c0] placeholder-[#1a30c0]/40 text-base font-medium focus:outline-none focus:border-[#d02030]"
            />
          </div>

          <div>
            <label class="block text-sm font-bold mb-1">Doodle Pen Ink Color</label>
            <div class="flex items-center gap-3">
              <label class="flex items-center gap-1 cursor-pointer">
                <input type="radio" name="accentColor" value="#1a30c0" checked class="accent-[#1a30c0]" />
                <span>Blue Ink</span>
              </label>
              <label class="flex items-center gap-1 cursor-pointer">
                <input type="radio" name="accentColor" value="#d02030" class="accent-[#d02030]" />
                <span class="text-[#d02030] font-bold">Red Ink</span>
              </label>
              <label class="flex items-center gap-1 cursor-pointer">
                <input type="radio" name="accentColor" value="#059669" class="accent-[#059669]" />
                <span class="text-[#059669]">Green</span>
              </label>
              <label class="flex items-center gap-1 cursor-pointer">
                <input type="radio" name="accentColor" value="#ea580c" class="accent-[#ea580c]" />
                <span class="text-[#ea580c]">Orange</span>
              </label>
            </div>
          </div>

          <button
            type="submit"
            class="w-full mt-2 py-2.5 rounded-2xl bg-[#1a30c0] hover:bg-[#152799] text-[#faf7ee] font-black text-lg transition-all shadow-md cursor-pointer -rotate-1 active:scale-95"
          >
            ✍️ Sign &amp; Sponsor Space in 3D
          </button>
        </form>

        <div id="sponsor-success" class="hidden text-center py-4">
          <div class="text-4xl mb-1">🎉</div>
          <h4 class="text-xl font-black text-[#059669]">Billboard Claimed!</h4>
          <p class="text-sm text-[#1a30c0] mt-1">
            Your ad is now actively displayed in 3D across Doodle City!
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-Side Doodle Engine Bootstrap Script -->
  <script>
    import { DoodleEngine } from "../components/doodle/DoodleEngine";
    import { CityBuilder, type BuildingType } from "../components/doodle/CityBuilder";
    import { CameraController } from "../components/doodle/CameraController";
    import { doodleAudio } from "../components/doodle/DoodleAudio";

    function initDoodleCity() {
      const canvas = document.getElementById("doodle-canvas") as HTMLCanvasElement;
      if (!canvas) return;

      const engine = new DoodleEngine({ canvas });
      const city = new CityBuilder(engine);
      const cameraCtrl = new CameraController(engine.camera, canvas);

      // UI Element Bindings
      const revEl = document.getElementById("metric-revenue");
      const viewsEl = document.getElementById("metric-views");
      const slotsEl = document.getElementById("metric-slots");
      const modal = document.getElementById("ad-modal");
      const modalClose = document.getElementById("btn-close-modal");
      const modalCategory = document.getElementById("modal-category");
      const modalTitle = document.getElementById("modal-title");
      const modalViews = document.getElementById("modal-views");
      const modalPrice = document.getElementById("modal-price");
      const modalAdId = document.getElementById("modal-ad-id") as HTMLInputElement;
      const inputBrand = document.getElementById("input-brand-name") as HTMLInputElement;
      const inputTagline = document.getElementById("input-tagline") as HTMLInputElement;
      const sponsorForm = document.getElementById("ad-sponsor-form") as HTMLFormElement;
      const sponsorSuccess = document.getElementById("sponsor-success");
      const walkHelper = document.getElementById("walk-helper");
      const btnSound = document.getElementById("btn-sound-toggle");

      function updateDashboardMetrics() {
        const metrics = city.getCityMetrics();
        if (revEl) revEl.textContent = `$${metrics.totalRevenue.toLocaleString()}/mo`;
        if (viewsEl) viewsEl.textContent = `${(metrics.totalViews / 1000).toFixed(0)}K/mo`;
        if (slotsEl) slotsEl.textContent = `${metrics.rentedSpaces} / ${metrics.totalSpaces}`;
      }

      updateDashboardMetrics();

      // Tool switching
      document.querySelectorAll(".tool-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          document.querySelectorAll(".tool-btn").forEach((b) => {
            b.classList.remove("bg-[#1a30c0]", "text-[#faf7ee]");
            b.classList.add("text-[#1a30c0]");
          });
          btn.classList.add("bg-[#1a30c0]", "text-[#faf7ee]");
          btn.classList.remove("text-[#1a30c0]");

          const tool = btn.getAttribute("data-tool") as BuildingType | "select";
          city.buildTool = tool;
          doodleAudio.penClick();
        });
      });

      // Camera Mode Toggle
      const btnOrbit = document.getElementById("btn-mode-orbit");
      const btnWalk = document.getElementById("btn-mode-walk");

      btnOrbit?.addEventListener("click", () => {
        cameraCtrl.setMode("orbit");
        btnOrbit.className = "px-3.5 py-1 rounded-lg text-sm font-bold bg-[#1a30c0] text-[#faf7ee] transition-all cursor-pointer";
        btnWalk!.className = "px-3.5 py-1 rounded-lg text-sm font-medium text-[#1a30c0] hover:bg-[#1a30c0]/10 transition-all cursor-pointer";
        walkHelper?.classList.add("hidden");
        doodleAudio.penClick();
      });

      btnWalk?.addEventListener("click", () => {
        cameraCtrl.setMode("walk");
        btnWalk.className = "px-3.5 py-1 rounded-lg text-sm font-bold bg-[#1a30c0] text-[#faf7ee] transition-all cursor-pointer";
        btnOrbit!.className = "px-3.5 py-1 rounded-lg text-sm font-medium text-[#1a30c0] hover:bg-[#1a30c0]/10 transition-all cursor-pointer";
        walkHelper?.classList.remove("hidden");
        doodleAudio.penClick();
      });

      // Sound Toggle
      btnSound?.addEventListener("click", () => {
        const enabled = doodleAudio.toggle();
        btnSound.textContent = `🔊 Pen SFX: ${enabled ? "ON" : "OFF"}`;
        if (enabled) doodleAudio.penClick();
      });

      // Click on canvas (inspect billboard or place structure)
      canvas.addEventListener("click", (e) => {
        const clickedAd = city.handlePointerClick(e);
        if (clickedAd) {
          modalCategory!.textContent = clickedAd.category;
          modalTitle!.textContent = clickedAd.title;
          modalViews!.textContent = `${clickedAd.viewsMonthly.toLocaleString()}/mo`;
          modalPrice!.textContent = `$${clickedAd.priceMonthly}/mo`;
          modalAdId.value = clickedAd.id;
          inputBrand.value = clickedAd.sponsorName === "YOUR BRAND HERE" || clickedAd.sponsorName === "AVAILABLE AD SLOT" ? "" : clickedAd.sponsorName;
          inputTagline.value = clickedAd.sponsorTagline;

          sponsorForm.classList.remove("hidden");
          sponsorSuccess?.classList.add("hidden");
          modal?.classList.remove("hidden");
        } else if (city.buildTool !== "select") {
          updateDashboardMetrics();
        }
      });

      modalClose?.addEventListener("click", () => {
        modal?.classList.add("hidden");
        doodleAudio.penClick();
      });

      modal?.addEventListener("click", (e) => {
        if (e.target === modal) {
          modal.classList.add("hidden");
        }
      });

      // Sponsor submit
      sponsorForm?.addEventListener("submit", (e) => {
        e.preventDefault();
        const adId = modalAdId.value;
        const brandName = inputBrand.value.trim() || "NEW TECH BRAND";
        const tagline = inputTagline.value.trim() || "Verified Doodle Sponsor";
        const colorRadio = document.querySelector('input[name="accentColor"]:checked') as HTMLInputElement | null;
        const accentColor = colorRadio ? colorRadio.value : "#1a30c0";

        city.leaseAdSpace(adId, {
          sponsorName: brandName,
          sponsorTagline: tagline,
          accentColor,
        });

        updateDashboardMetrics();

        sponsorForm.classList.add("hidden");
        sponsorSuccess?.classList.remove("hidden");

        setTimeout(() => {
          modal?.classList.add("hidden");
        }, 1600);
      });

      // Animation Loop
      let lastTime = performance.now();
      function animate(time: number) {
        requestAnimationFrame(animate);
        const delta = Math.min((time - lastTime) / 1000, 0.1);
        lastTime = time;

        cameraCtrl.update(delta);
        city.update(delta);
        engine.render(delta);
      }

      requestAnimationFrame(animate);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initDoodleCity);
    } else {
      initDoodleCity();
    }
  </script>
</DoodleLayout>\n